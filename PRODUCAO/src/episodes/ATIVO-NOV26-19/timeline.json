 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um apartamento de um quarto teve aluguel anunciado de quase setenta e três reais por metro quadrado na média pesquisada.",
   "start": 0.2,
   "end": 6.78
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O de três quartos ficou perto de quarenta e oito.",
   "start": 7.0,
   "end": 9.48
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "É o que mostrou o FipeZAP de locação de outubro.",
   "start": 9.64,
   "end": 12.22
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Só que preço por metro quadrado não é a mesma coisa que dinheiro sobrando para o proprietário.",
   "start": 12.52,
   "end": 17.25
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Pensa num studio que aluga rápido, mas tem condomínio alto e troca frequente de moradores.",
   "start": 17.56,
   "end": 23.12
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Agora compara com um imóvel maior, aluguel total diferente e outra dinâmica de vacância.",
   "start": 23.4,
   "end": 28.75
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O investidor precisa olhar valor de aquisição, custos, vacância e demanda local.",
   "start": 29.0,
   "end": 34.0
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Para o corretor, a oportunidade está em ajudar a calcular com dados, não em vender uma tipologia como vencedora universal.",
   "start": 34.28,
   "end": 41.04
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Mostre a conta completa.",
   "start": 41.32,
   "end": 42.68
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 42.92,
   "end": 47.57
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 47.72,
   "end": 50.8
  }
 ],
