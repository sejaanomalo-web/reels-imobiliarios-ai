 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Duas casas iguais, na mesma rua.",
   "start": 0.12,
   "end": 2.24
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Uma vendeu mais caro só por causa do número na porta.",
   "start": 2.6,
   "end": 6.17
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Isso apareceu num estudo no Canadá, com cerca de 117 mil vendas de casas na região de Vancouver.",
   "start": 6.52,
   "end": 12.32
  },
  {
   "id": "s4",
   "scene": "numeros",
   "text": "Endereço terminado em oito vendeu, em média, dois e meio por cento acima.",
   "start": 12.642,
   "end": 16.59
  },
  {
   "id": "s5",
   "scene": "numeros",
   "text": "Terminado em quatro, dois vírgula dois por cento abaixo.",
   "start": 16.92,
   "end": 19.97
  },
  {
   "id": "s6",
   "scene": "cultura",
   "text": "Para muitas famílias de origem chinesa, o oito lembra prosperidade, e o quatro soa parecido com a palavra morte.",
   "start": 20.36,
   "end": 26.63
  },
  {
   "id": "s7",
   "scene": "cultura",
   "text": "O efeito apareceu nos bairros com mais moradores dessa origem.",
   "start": 26.84,
   "end": 29.82
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Mas o detalhe mais curioso é outro.",
   "start": 30.12,
   "end": 32.02
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "O efeito também apareceu em casas revendidas.",
   "start": 32.28,
   "end": 35.11
  },
  {
   "id": "s10",
   "scene": "virada",
   "text": "Quem compra pensando em revender também paga pelo oito.",
   "start": 35.32,
   "end": 38.43
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Então, quando o cliente diz que isso não faz diferença pra ele, lembre:",
   "start": 38.76,
   "end": 42.28
  },
  {
   "id": "s12",
   "scene": "desfecho",
   "text": "O preço de amanhã depende do que o próximo comprador acredita.",
   "start": 42.6,
   "end": 46.03
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 46.44,
   "end": 50.59
  }
 ],
