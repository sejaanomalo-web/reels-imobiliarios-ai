 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente amou o apartamento. Aí veio a simulação do financiamento.",
   "start": 0.2,
   "end": 5.13
  },
  {
   "id": "s2",
   "scene": "frustra",
   "text": "A parcela não coube, e o sonho virou frustração.",
   "start": 5.32,
   "end": 8.4
  },
  {
   "id": "s3",
   "scene": "compara",
   "text": "Pior: agora tudo que cabe no bolso parece pior do que aquele.",
   "start": 8.84,
   "end": 12.42
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A simulação tem que vir antes da visita, não depois.",
   "start": 12.84,
   "end": 15.9
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No primeiro contato, simule com o cliente: a renda, a entrada e a parcela que cabe.",
   "start": 16.12,
   "end": 20.93
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem visita dentro do orçamento se apaixona pelo imóvel certo.",
   "start": 21.24,
   "end": 24.84
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.16,
   "end": 29.79
  }
 ],
