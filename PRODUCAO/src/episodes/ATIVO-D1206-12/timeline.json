 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma lista de dezenove itens ajudou a reduzir mortes em cirurgias.",
   "start": 0.12,
   "end": 4.23
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 2009, um estudo em oito hospitais de oito países testou um checklist da Organização Mundial da Saúde.",
   "start": 4.52,
   "end": 10.49
  },
  {
   "id": "s3",
   "scene": "numeros",
   "text": "Depois da lista, as mortes caíram de um e meio por cento para menos de um. As complicações, de onze para sete por cento.",
   "start": 10.92,
   "end": 18.92
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "As equipes já sabiam tudo aquilo. A lista só não deixava esquecer.",
   "start": 19.32,
   "end": 23.62
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No fechamento, faça a sua: documentos do vendedor, certidões, matrícula atualizada, prazo do financiamento e data das chaves.",
   "start": 23.96,
   "end": 31.95
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Experiência não protege do esquecimento. Lista protege.",
   "start": 32.44,
   "end": 36.52
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 36.84,
   "end": 41.21
  }
 ],
