 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você marcou a visita, o cliente chegou e ninguém sabe com quem está a chave.",
   "start": 0.2,
   "end": 5.11
  },
  {
   "id": "s2",
   "scene": "onde",
   "text": "Ficou na portaria? Com outro corretor? No carro de alguém da equipe?",
   "start": 5.4,
   "end": 9.47
  },
  {
   "id": "s3",
   "scene": "espera",
   "text": "Enquanto você liga para todo mundo, o cliente espera na calçada.",
   "start": 9.88,
   "end": 13.3
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A chave não sumiu. O que sumiu foi o registro.",
   "start": 13.72,
   "end": 16.52
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na hora em que a chave sai, anote quem pegou, para qual visita e quando devolve.",
   "start": 16.84,
   "end": 22.09
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Chave com nome e horário não atrasa visita.",
   "start": 22.36,
   "end": 24.8
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.24,
   "end": 29.78
  }
 ],
