 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que a gente gosta mais do móvel que montou sozinho, mesmo meio torto?",
   "start": 0.12,
   "end": 4.31
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 2012, pesquisadores pediram a pessoas que montassem caixas simples de guardar coisas.",
   "start": 4.68,
   "end": 9.42
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Quem montou aceitava pagar mais pela própria caixa do que por uma igual, já pronta.",
   "start": 9.8,
   "end": 14.53
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O que a gente ajuda a construir passa a valer mais.",
   "start": 14.76,
   "end": 17.52
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Monte a busca com o cliente: ele escolhe os critérios, você traz as opções e explica cada uma.",
   "start": 17.96,
   "end": 23.63
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Cliente que participa da escolha defende a escolha.",
   "start": 23.96,
   "end": 26.87
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.08,
   "end": 31.57
  }
 ],
