 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em São Paulo, um empresário construiu uma casa no alto do próprio prédio e foi morar lá.",
   "start": 0.12,
   "end": 5.87
  },
  {
   "id": "s2",
   "scene": "martinelli",
   "text": "Era o Martinelli, o primeiro arranha-céu da cidade, com trinta andares.",
   "start": 6.28,
   "end": 10.67
  },
  {
   "id": "s3",
   "scene": "medo",
   "text": "Segundo a prefeitura, muita gente desconfiava da segurança da obra.",
   "start": 10.92,
   "end": 14.63
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ele não ficou só discutindo. Em 1929, mudou-se com a família para a cobertura.",
   "start": 15.32,
   "end": 21.42
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No seu atendimento, prova vale mais que argumento: mostre a matrícula em dia, o laudo, o histórico de manutenção.",
   "start": 21.8,
   "end": 29.42
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Confiança não se pede. Se mostra.",
   "start": 29.88,
   "end": 32.44
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.84,
   "end": 37.57
  }
 ],
