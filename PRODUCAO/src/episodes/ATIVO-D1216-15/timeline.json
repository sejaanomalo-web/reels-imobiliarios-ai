 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O casal amou a casa, e descobriu o trânsito só depois da mudança.",
   "start": 0.12,
   "end": 4.59
  },
  {
   "id": "s2",
   "scene": "pesquisa",
   "text": "Uma pesquisa alemã mostrou que quem gasta mais tempo indo ao trabalho está, em média, menos satisfeito com a vida.",
   "start": 4.92,
   "end": 10.99
  },
  {
   "id": "s3",
   "scene": "compensa",
   "text": "E a casa bonita não compensa a hora perdida todo dia.",
   "start": 11.24,
   "end": 14.77
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O trajeto também faz parte do imóvel.",
   "start": 15.0,
   "end": 17.47
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de mostrar, calcule com o cliente o trajeto até o trabalho no horário de pico.",
   "start": 17.88,
   "end": 22.46
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "A casa certa também é a que deixa tempo para viver nela.",
   "start": 22.84,
   "end": 26.48
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.84,
   "end": 31.89
  }
 ],
