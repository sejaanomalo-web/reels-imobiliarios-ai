 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Antes de o cliente assinar, faça uma pergunta estranha.",
   "start": 0.12,
   "end": 2.98
  },
  {
   "id": "s2",
   "scene": "pergunta",
   "text": "Imagine que já passou um ano e você se arrependeu dessa compra. O que deu errado?",
   "start": 3.4,
   "end": 7.75
  },
  {
   "id": "s3",
   "scene": "virada",
   "text": "Parece pessimismo. Mas um estudo de 1989 viu que imaginar que algo já aconteceu ajuda a apontar cerca de 30% mais motivos.",
   "start": 8.2,
   "end": 17.33
  },
  {
   "id": "s4",
   "scene": "motivos",
   "text": "O cliente fala do barulho da rua, da parcela apertada, da escola longe.",
   "start": 17.56,
   "end": 22.05
  },
  {
   "id": "s5",
   "scene": "resolve",
   "text": "E você resolve agora, antes da caneta, e não depois da chave na mão.",
   "start": 22.28,
   "end": 26.59
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Dúvida que aparece antes da assinatura tem solução. Depois, vira arrependimento.",
   "start": 27.0,
   "end": 32.0
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.44,
   "end": 36.85
  }
 ],
