 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Visita com casal. Ela já está escolhendo onde vai a mesa.",
   "start": 0.2,
   "end": 3.66
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Ele está de braços cruzados na porta.",
   "start": 3.96,
   "end": 5.81
  },
  {
   "id": "s3",
   "scene": "erro",
   "text": "Você tenta convencer quem não gostou. E aí os dois se fecham.",
   "start": 6.2,
   "end": 9.49
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Casal não discorda do imóvel. Discorda dos critérios, que nunca foram combinados.",
   "start": 9.8,
   "end": 14.41
  },
  {
   "id": "s5",
   "scene": "perguntas",
   "text": "Na próxima conversa, pergunte a cada um: o que precisa ter para ser sim pra você? E o que é inegociável?",
   "start": 14.76,
   "end": 21.49
  },
  {
   "id": "s6",
   "scene": "perguntas",
   "text": "Às vezes, ela quer espaço. Ele quer não pegar trânsito.",
   "start": 21.88,
   "end": 25.49
  },
  {
   "id": "s7",
   "scene": "desfecho",
   "text": "Com os dois critérios na mesa, você para de defender o imóvel e começa a procurar o certo.",
   "start": 25.96,
   "end": 30.75
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 31.0,
   "end": 35.46
  }
 ],
