 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se aparecem mais imóveis para alugar numa cidade, o aluguel necessariamente cai?",
   "start": 0.12,
   "end": 4.61
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Curitiba mostra por que a resposta pode ser mais complicada.",
   "start": 4.76,
   "end": 7.99
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Reportagens recentes apontam maior oferta de locação e uma moderação no ritmo dos reajustes em Curitiba.",
   "start": 8.44,
   "end": 14.2
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Isso não equivale a uma queda generalizada nos valores.",
   "start": 14.52,
   "end": 17.43
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Imagina dois bairros: um recebe muitos apartamentos novos, outro quase não ganha oferta.",
   "start": 17.88,
   "end": 22.51
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "A procura, o padrão dos imóveis e os preços podem se comportar de forma diferente nos dois lugares.",
   "start": 22.76,
   "end": 27.64
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Na avaliação de aluguel, olhe imóveis comparáveis disponíveis hoje, tempo de anúncio e velocidade de fechamento na área.",
   "start": 27.96,
   "end": 34.42
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Uma notícia da cidade ajuda, mas não substitui a análise do endereço.",
   "start": 34.68,
   "end": 38.26
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Dado local decide.",
   "start": 38.52,
   "end": 39.78
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.12,
   "end": 44.49
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 44.6,
   "end": 47.22
  }
 ],
