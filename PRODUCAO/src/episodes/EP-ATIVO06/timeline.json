 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Sua imobiliária recebe contatos, agenda visitas, cadastra imóveis e tem uma equipe ocupada.",
   "start": 0.12,
   "end": 5.67
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mesmo assim, algumas oportunidades param no caminho.",
   "start": 6.04,
   "end": 8.75
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "A pergunta não é se as pessoas estão trabalhando.",
   "start": 9.24,
   "end": 11.93
  },
  {
   "id": "s4",
   "scene": "hook",
   "text": "É onde a operação está perdendo continuidade.",
   "start": 12.2,
   "end": 14.74
  },
  {
   "id": "s5",
   "scene": "contato",
   "text": "Acompanhe uma oportunidade fictícia.",
   "start": 15.126,
   "end": 17.01
  },
  {
   "id": "s6",
   "scene": "contato",
   "text": "Ela chega por um anúncio.",
   "start": 17.32,
   "end": 18.58
  },
  {
   "id": "s7",
   "scene": "contato",
   "text": "Alguém responde, mas ninguém define quem será responsável pelo próximo retorno.",
   "start": 18.76,
   "end": 22.87
  },
  {
   "id": "s8",
   "scene": "contato",
   "text": "No dia seguinte, outro corretor abre a conversa sem saber o que já foi explicado.",
   "start": 23.24,
   "end": 27.49
  },
  {
   "id": "s9",
   "scene": "imovel",
   "text": "Agora siga o imóvel.",
   "start": 27.96,
   "end": 29.31
  },
  {
   "id": "s10",
   "scene": "imovel",
   "text": "Um corretor informa que está disponível.",
   "start": 29.64,
   "end": 31.46
  },
  {
   "id": "s11",
   "scene": "imovel",
   "text": "Outro descobre que a condição mudou.",
   "start": 31.8,
   "end": 33.36
  },
  {
   "id": "s12",
   "scene": "imovel",
   "text": "A carteira foi atualizada em um lugar, mas não no outro.",
   "start": 33.72,
   "end": 36.71
  },
  {
   "id": "s13",
   "scene": "imovel",
   "text": "O problema não é apenas informação antiga. É a ausência de um ponto claro de atualização.",
   "start": 37.0,
   "end": 41.88
  },
  {
   "id": "s14",
   "scene": "investigacao",
   "text": "Para encontrar o gargalo, escolha uma negociação recente e refaça seu percurso.",
   "start": 42.12,
   "end": 46.47
  },
  {
   "id": "s15",
   "scene": "investigacao",
   "text": "Quem recebeu?",
   "start": 46.76,
   "end": 47.52
  },
  {
   "id": "s16",
   "scene": "investigacao",
   "text": "Quem assumiu?",
   "start": 47.88,
   "end": 48.62
  },
  {
   "id": "s17",
   "scene": "investigacao",
   "text": "Onde ficaram as informações?",
   "start": 49.0,
   "end": 50.67
  },
  {
   "id": "s18",
   "scene": "investigacao",
   "text": "Quando aconteceu o último movimento?",
   "start": 50.92,
   "end": 52.73
  },
  {
   "id": "s19",
   "scene": "investigacao",
   "text": "O que dependia de outra pessoa?",
   "start": 53.08,
   "end": 54.73
  },
  {
   "id": "s20",
   "scene": "investigacao",
   "text": "Uma resposta vaga já indica onde vale investigar.",
   "start": 55.08,
   "end": 57.68
  },
  {
   "id": "s21",
   "scene": "insight",
   "text": "Uma boa gestão não precisa acompanhar cada mensagem da equipe.",
   "start": 58.2,
   "end": 61.44
  },
  {
   "id": "s22",
   "scene": "insight",
   "text": "Precisa enxergar responsabilidades, etapas e pendências para agir quando algo sai do fluxo.",
   "start": 61.88,
   "end": 67.19
  },
  {
   "id": "s23",
   "scene": "cta",
   "text": "Se você quer conhecer um sistema personalizado para organizar imóveis, leads e atendimentos,",
   "start": 67.48,
   "end": 72.07
  },
  {
   "id": "s24",
   "scene": "cta",
   "text": "comente SISTEMA que enviamos os detalhes pelo Direct.",
   "start": 72.28,
   "end": 75.15
  }
 ],
