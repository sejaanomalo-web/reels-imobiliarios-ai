 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se você está começando como corretor, não precisa fingir que já vendeu dezenas de imóveis para parecer confiável.",
   "start": 0.12,
   "end": 7.97
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Existe uma forma mais interessante de construir autoridade: mostrar como você pensa.",
   "start": 8.32,
   "end": 14.065
  },
  {
   "id": "s3",
   "scene": "mercado",
   "text": "Primeiro, explique critérios do mercado em que atua.",
   "start": 14.415,
   "end": 18.06
  },
  {
   "id": "s4",
   "scene": "mercado",
   "text": "Em vez de dizer que um bairro é “o melhor”, mostre o que vale pesquisar: mobilidade, serviços próximos, perfil das ruas e diferença entre regiões.",
   "start": 18.41,
   "end": 28.875
  },
  {
   "id": "s5",
   "scene": "mercado",
   "text": "Use fontes e observações que você realmente conferiu.",
   "start": 29.225,
   "end": 32.82
  },
  {
   "id": "s6",
   "scene": "analise",
   "text": "Segundo, analise imóveis com equilíbrio.",
   "start": 33.17,
   "end": 35.9
  },
  {
   "id": "s7",
   "scene": "analise",
   "text": "Mostre para quem a planta pode funcionar e para quem talvez não funcione.",
   "start": 36.25,
   "end": 41.37
  },
  {
   "id": "s8",
   "scene": "analise",
   "text": "Um apartamento com pouca manutenção pode interessar a uma pessoa e ser ruim para uma família que precisa de três quartos.",
   "start": 41.72,
   "end": 50.16
  },
  {
   "id": "s9",
   "scene": "processo",
   "text": "Terceiro, esclareça etapas da compra.",
   "start": 50.51,
   "end": 53.075
  },
  {
   "id": "s10",
   "scene": "processo",
   "text": "O que o interessado deve conferir antes de visitar?",
   "start": 53.425,
   "end": 56.995
  },
  {
   "id": "s11",
   "scene": "processo",
   "text": "Que documentos costumam exigir atenção?",
   "start": 57.345,
   "end": 59.915
  },
  {
   "id": "s12",
   "scene": "processo",
   "text": "Em que momento entram as verificações?",
   "start": 60.265,
   "end": 62.865
  },
  {
   "id": "s13",
   "scene": "processo",
   "text": "Quando houver regras específicas, oriente a procurar fontes oficiais e profissionais responsáveis.",
   "start": 63.215,
   "end": 69.73
  },
  {
   "id": "s14",
   "scene": "insight",
   "text": "Pense nisso: seu próximo conteúdo não precisa anunciar que você entende do assunto.",
   "start": 70.08,
   "end": 75.855
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "Ele pode demonstrar esse conhecimento, de um jeito que realmente ajude alguém.",
   "start": 76.205,
   "end": 81.62
  },
  {
   "id": "s16",
   "scene": "insight",
   "text": "Autoridade é percebida no valor do que você explica.",
   "start": 81.97,
   "end": 85.595
  },
  {
   "id": "s17",
   "scene": "insight",
   "text": "Uma atuação mais estratégica também começa pela sua organização.",
   "start": 85.945,
   "end": 90.23
  },
  {
   "id": "s18",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 90.58,
   "end": 96.6
  },
  {
   "id": "s19",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 96.95,
   "end": 100.88
  }
 ],
