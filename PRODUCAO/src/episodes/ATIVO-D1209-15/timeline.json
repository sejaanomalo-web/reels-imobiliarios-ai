 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A pergunta mais útil da visita é imaginar que a compra deu errado.",
   "start": 0.12,
   "end": 4.6
  },
  {
   "id": "s2",
   "scene": "metodo",
   "text": "Um psicólogo criou um método para projetos: antes de começar, a equipe imagina que fracassou e explica por quê.",
   "start": 5.08,
   "end": 12.21
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Num estudo citado por ele, imaginar o fato já consumado melhorou em trinta por cento a identificação dos motivos.",
   "start": 12.6,
   "end": 19.31
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Na visita, pergunte: imagine que daqui a um ano você se arrependeu desta compra. Por quê?",
   "start": 19.72,
   "end": 25.59
  },
  {
   "id": "s5",
   "scene": "respostas",
   "text": "Barulho, escola longe, condomínio caro. O cliente fala agora o que só diria depois.",
   "start": 26.12,
   "end": 32.48
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O arrependimento que aparece antes vira pergunta. Depois, vira distrato.",
   "start": 32.84,
   "end": 37.78
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 38.2,
   "end": 42.69
  }
 ],
