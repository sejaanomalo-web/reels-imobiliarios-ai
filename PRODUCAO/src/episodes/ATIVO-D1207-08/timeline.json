 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o seu apartamento tivesse data de validade?",
   "start": 0.12,
   "end": 2.72
  },
  {
   "id": "s2",
   "scene": "singapura",
   "text": "Em Singapura, três em cada quatro moradores vivem em apartamentos públicos com contrato de noventa e nove anos.",
   "start": 3.0,
   "end": 9.4
  },
  {
   "id": "s3",
   "scene": "volta",
   "text": "Quando o prazo acaba, o imóvel volta para o Estado.",
   "start": 9.72,
   "end": 12.34
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Aqui não é assim. Mas tem imóvel em que a União também tem uma parte.",
   "start": 12.84,
   "end": 17.43
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Em terreno de marinha, a cada venda, se paga à União um laudêmio de cinco por cento. Confira na matrícula antes de anunciar.",
   "start": 17.64,
   "end": 24.74
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem lê a matrícula antes não descobre o custo na hora de assinar.",
   "start": 25.0,
   "end": 28.42
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.76,
   "end": 33.21
  }
 ],
