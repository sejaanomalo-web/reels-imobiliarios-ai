 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 2019, uma cidade da Sicília pôs casas à venda por um euro.",
   "start": 0.2,
   "end": 4.85
  },
  {
   "id": "s2",
   "scene": "cidade",
   "text": "Sambuca estava perdendo moradores. Casas vazias, ruas silenciosas.",
   "start": 5.262,
   "end": 10.44
  },
  {
   "id": "s3",
   "scene": "mundo",
   "text": "O anúncio rodou o mundo. Choveram interessados.",
   "start": 10.76,
   "end": 13.9
  },
  {
   "id": "s4",
   "scene": "mundo",
   "text": "Mas tinha condição: depósito de 5 mil euros e reforma em até três anos.",
   "start": 14.04,
   "end": 18.9
  },
  {
   "id": "s5",
   "scene": "mundo",
   "text": "E no leilão, a maioria saiu entre 5 e 10 mil euros.",
   "start": 19.16,
   "end": 22.76
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "A cidade nunca quis o dinheiro. Ela queria gente morando ali de novo.",
   "start": 23.24,
   "end": 27.58
  },
  {
   "id": "s7",
   "scene": "licao",
   "text": "Todo vendedor tem um objetivo além do preço. Prazo, quem vai cuidar da casa, um recomeço.",
   "start": 28.04,
   "end": 34.48
  },
  {
   "id": "s8",
   "scene": "desfecho",
   "text": "Na captação, pergunte o que ele quer além do número. É aí que a negociação ganha saída.",
   "start": 34.84,
   "end": 40.41
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 40.84,
   "end": 45.66
  }
 ],
