 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente manda o link de um imóvel anunciado por outro corretor.",
   "start": 0.12,
   "end": 3.55
  },
  {
   "id": "s2",
   "scene": "impulso",
   "text": "A vontade é ignorar ou apontar defeito no anúncio.",
   "start": 3.72,
   "end": 6.54
  },
  {
   "id": "s3",
   "scene": "pista",
   "text": "Mas esse link diz exatamente o que ele procura.",
   "start": 6.84,
   "end": 9.25
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O anúncio do concorrente é a melhor pista do seu cliente.",
   "start": 9.56,
   "end": 12.888
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Pergunte o que chamou a atenção nele e use isso para filtrar as suas opções.",
   "start": 12.888,
   "end": 16.51
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem compara junto vira o corretor de confiança.",
   "start": 16.68,
   "end": 19.73
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 19.88,
   "end": 24.27
  }
 ],
