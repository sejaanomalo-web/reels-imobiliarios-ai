 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Existe um comprador que ainda não está procurando a sala mais bonita do Instagram.",
   "start": 0.2,
   "end": 3.98
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Ele está tentando descobrir se consegue comprar o primeiro imóvel.",
   "start": 4.36,
   "end": 7.64
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "E, se seus conteúdos só mostram fachadas, talvez você nunca responda à dúvida que realmente importa para ele.",
   "start": 8.12,
   "end": 14.2
  },
  {
   "id": "s4",
   "scene": "duvidas",
   "text": "Antes da visita, essa pessoa pode querer saber como se prepara para uma análise de crédito, o que influencia a entrada, quais custos aparecem além do anúncio e por que a parcela anunciada não é uma resposta personalizada.",
   "start": 14.68,
   "end": 26.41
  },
  {
   "id": "s5",
   "scene": "pauta",
   "text": "Isso pode virar uma série de vídeos.",
   "start": 26.84,
   "end": 28.51
  },
  {
   "id": "s6",
   "scene": "pauta",
   "text": "Um explicando quais informações reunir antes de simular financiamento.",
   "start": 28.76,
   "end": 32.34
  },
  {
   "id": "s7",
   "scene": "pauta",
   "text": "Outro mostrando perguntas importantes sobre despesas do condomínio.",
   "start": 32.68,
   "end": 35.83
  },
  {
   "id": "s8",
   "scene": "pauta",
   "text": "Um terceiro explicando como comparar um imóvel pronto com um empreendimento ainda em construção.",
   "start": 36.28,
   "end": 41.07
  },
  {
   "id": "s9",
   "scene": "resp",
   "text": "Se você trabalha com programas habitacionais, como o Minha Casa, Minha Vida, confira sempre os critérios oficiais atualizados antes de publicar.",
   "start": 41.64,
   "end": 49.09
  },
  {
   "id": "s10",
   "scene": "resp",
   "text": "Renda, enquadramento, condições e disponibilidade podem variar.",
   "start": 49.56,
   "end": 53.43
  },
  {
   "id": "s11",
   "scene": "resp",
   "text": "Seu papel no conteúdo é esclarecer o caminho, não prometer aprovação ou condições para todo mundo.",
   "start": 53.88,
   "end": 58.7
  },
  {
   "id": "s12",
   "scene": "insight",
   "text": "Conteúdo de imóvel apresenta uma opção.",
   "start": 59.24,
   "end": 61.24
  },
  {
   "id": "s13",
   "scene": "insight",
   "text": "Conteúdo educativo ajuda o comprador a entender a própria decisão.",
   "start": 61.64,
   "end": 65.45
  },
  {
   "id": "s14",
   "scene": "insight",
   "text": "Os dois têm espaço na estratégia, mas não fazem a mesma coisa.",
   "start": 65.8,
   "end": 68.8
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "Para acompanhar cada comprador nessa jornada, vale ter as informações organizadas.",
   "start": 69.24,
   "end": 73.5
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 73.8,
   "end": 78.35
  },
  {
   "id": "s17",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 78.6,
   "end": 81.27
  }
 ],
