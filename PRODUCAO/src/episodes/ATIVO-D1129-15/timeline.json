 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Todo ano tem corretor que, em dezembro, pendura a plaquinha: volto em janeiro.",
   "start": 0.12,
   "end": 4.45
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Afinal, dezembro é mês morto. Será?",
   "start": 4.68,
   "end": 7.21
  },
  {
   "id": "s3",
   "scene": "dinheiro",
   "text": "O décimo terceiro deve colocar quase 400 bilhões de reais na economia este ano, segundo o Dieese.",
   "start": 7.56,
   "end": 13.51
  },
  {
   "id": "s4",
   "scene": "dinheiro",
   "text": "E o prazo das parcelas vai até 18 de dezembro.",
   "start": 13.88,
   "end": 16.58
  },
  {
   "id": "s5",
   "scene": "credito",
   "text": "No financiamento com dinheiro da poupança, dezembro de 2024 foi o melhor dezembro da história.",
   "start": 16.84,
   "end": 22.64
  },
  {
   "id": "s6",
   "scene": "aluguel",
   "text": "E no aluguel, a procura costuma subir no começo do ano, quando contratos vencem e as aulas voltam.",
   "start": 22.92,
   "end": 28.18
  },
  {
   "id": "s7",
   "scene": "virada",
   "text": "Ou seja: dezembro não é o mês em que o cliente some.",
   "start": 28.68,
   "end": 31.97
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "É o mês em que ele decide.",
   "start": 32.2,
   "end": 33.45
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "E em janeiro, ele já sabe pra quem vai ligar.",
   "start": 33.64,
   "end": 35.98
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Férias, sim. Sumiço, não.",
   "start": 36.314,
   "end": 38.04
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 38.44,
   "end": 42.87
  }
 ],
