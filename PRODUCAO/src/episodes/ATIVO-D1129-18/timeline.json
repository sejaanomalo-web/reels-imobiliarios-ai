 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Mais de setenta mil famílias compraram uma casa sem nunca ter entrado nela.",
   "start": 0.2,
   "end": 4.85
  },
  {
   "id": "s2",
   "scene": "contexto",
   "text": "Foi nos Estados Unidos, a partir de 1908.",
   "start": 5.08,
   "end": 7.74
  },
  {
   "id": "s3",
   "scene": "contexto",
   "text": "A casa era vendida pelo correio, pela Sears, a loja de catálogo onde se comprava de roupa a ferramenta.",
   "start": 7.96,
   "end": 13.99
  },
  {
   "id": "s4",
   "scene": "trem",
   "text": "Você escolhia o modelo, pagava, e a casa chegava de trem: milhares de peças numeradas, cortadas na medida, com um manual para montar.",
   "start": 14.28,
   "end": 22.31
  },
  {
   "id": "s5",
   "scene": "pergunta",
   "text": "Mas como alguém escolhe onde vai morar sem visitar?",
   "start": 22.68,
   "end": 25.51
  },
  {
   "id": "s6",
   "scene": "resposta",
   "text": "Porque o catálogo respondia antes.",
   "start": 25.88,
   "end": 27.88
  },
  {
   "id": "s7",
   "scene": "resposta",
   "text": "Cada página mostrava a fachada, a planta com a medida de cada cômodo e tudo o que vinha no kit.",
   "start": 28.28,
   "end": 34.28
  },
  {
   "id": "s8",
   "scene": "escala",
   "text": "A dúvida chegava resolvida.",
   "start": 34.6,
   "end": 36.5
  },
  {
   "id": "s9",
   "scene": "escala",
   "text": "Foram centenas de modelos por mais de trinta anos, e milhares dessas casas continuam de pé.",
   "start": 36.84,
   "end": 41.84
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Essas famílias não compraram no escuro.",
   "start": 42.28,
   "end": 44.41
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Compraram com as respostas chegando antes das perguntas.",
   "start": 44.68,
   "end": 47.44
  },
  {
   "id": "s12",
   "scene": "desfecho",
   "text": "E é isso que ainda decide qual imóvel o cliente quer visitar.",
   "start": 47.64,
   "end": 50.81
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 51.16,
   "end": 55.83
  }
 ],
