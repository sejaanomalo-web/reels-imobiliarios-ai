 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Três atitudes que parecem atrapalhar uma venda de imóvel, mas podem ser exatamente o que constrói confiança.",
   "start": 0.2,
   "end": 6.75
  },
  {
   "id": "s2",
   "scene": "um",
   "text": "Primeira: admitir quando um imóvel não encaixa.",
   "start": 7.24,
   "end": 9.65
  },
  {
   "id": "s3",
   "scene": "um",
   "text": "Se a pessoa precisa evitar escadas e a casa tem muitos degraus, não adianta tentar transformar isso em vantagem.",
   "start": 9.88,
   "end": 15.11
  },
  {
   "id": "s4",
   "scene": "um",
   "text": "Mostrar o limite evita uma visita frustrada.",
   "start": 15.48,
   "end": 18.14
  },
  {
   "id": "s5",
   "scene": "dois",
   "text": "Segunda: fazer uma pergunta antes de responder com um catálogo.",
   "start": 18.68,
   "end": 22.19
  },
  {
   "id": "s6",
   "scene": "dois",
   "text": "Quando alguém fala de três quartos, pode estar pensando em filhos, home office ou receber família.",
   "start": 22.36,
   "end": 27.22
  },
  {
   "id": "s7",
   "scene": "dois",
   "text": "A motivação muda quais imóveis vale apresentar.",
   "start": 27.56,
   "end": 30.34
  },
  {
   "id": "s8",
   "scene": "tres",
   "text": "Terceira: aceitar que a pessoa talvez ainda esteja comparando opções.",
   "start": 30.92,
   "end": 34.7
  },
  {
   "id": "s9",
   "scene": "tres",
   "text": "Em vez de pressionar, combine qual informação fará sentido enviar no próximo contato.",
   "start": 34.92,
   "end": 39.55
  },
  {
   "id": "s10",
   "scene": "tres",
   "text": "O relacionamento pode continuar sem uma decisão imediata.",
   "start": 39.8,
   "end": 42.66
  },
  {
   "id": "s11",
   "scene": "tres",
   "text": "E para respeitar o momento de cada pessoa, ajuda saber em que ponto cada conversa parou.",
   "start": 43.0,
   "end": 48.2
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 48.6,
   "end": 53.16
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 53.509,
   "end": 56.35
  }
 ],
