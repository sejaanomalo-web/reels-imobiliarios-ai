 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Eu vou te provar que até uma cobertura absurda pode ter um anúncio ruim.",
   "start": 0.2,
   "end": 4.81
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Imagina uma cobertura fictícia em Vice City: vista pro mar, janelas enormes e vaga para uma coleção de carros.",
   "start": 5.16,
   "end": 12.44
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Agora olha a legenda: “lindo imóvel, ótima localização”.",
   "start": 12.92,
   "end": 16.69
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Você acabou de transformar uma das vistas mais impressionantes de um jogo em qualquer apartamento da internet.",
   "start": 17.16,
   "end": 23.2
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Faz o contrário. Abre o vídeo com a paisagem, mostra o pôr do sol, depois conta o que a pessoa poderia viver naquele lugar.",
   "start": 23.56,
   "end": 30.24
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Só no final entra metragem e garagem.",
   "start": 30.6,
   "end": 32.96
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Até num imóvel inventado, a história que você escolhe contar muda tudo.",
   "start": 33.32,
   "end": 37.25
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Na vida real, cada imóvel merece uma ficha completa.",
   "start": 37.64,
   "end": 40.55
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.92,
   "end": 45.53
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 45.829,
   "end": 48.68
  }
 ],
