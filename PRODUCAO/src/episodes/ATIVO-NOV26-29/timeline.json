 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O comprador perguntou: “Esse apartamento tem vaga coberta?”",
   "start": 0.2,
   "end": 3.67
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E recebeu cinco mensagens prontas, um PDF e um convite para visitar.",
   "start": 3.88,
   "end": 8.26
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "A informação que ele precisava ainda não apareceu.",
   "start": 8.52,
   "end": 10.98
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Esse tipo de atrito virou tema em debates sobre a jornada digital do cliente no mercado imobiliário.",
   "start": 11.32,
   "end": 16.2
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Quem está pesquisando quer entender a própria pergunta primeiro.",
   "start": 16.44,
   "end": 19.54
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Agora veja a alternativa: “Sim, a vaga é coberta, conforme a ficha do imóvel. Quer saber também como funciona o acesso à garagem?”",
   "start": 19.96,
   "end": 27.0
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Uma resposta clara abre espaço para a próxima dúvida.",
   "start": 27.48,
   "end": 30.71
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Não é sobre escrever menos por escrever menos.",
   "start": 30.92,
   "end": 33.34
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "É sobre conectar o pedido ao atendimento, verificar os dados e respeitar o momento de compra.",
   "start": 33.48,
   "end": 38.5
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Tecnologia nenhuma conserta uma conversa que ignora o cliente.",
   "start": 38.84,
   "end": 41.98
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Clareza antes da automação.",
   "start": 42.28,
   "end": 43.98
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.2,
   "end": 48.85
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.08,
   "end": 52.1
  }
 ],
