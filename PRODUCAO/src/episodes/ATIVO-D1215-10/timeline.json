 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A visita estava indo bem, até a criança começar a correr pela casa.",
   "start": 0.12,
   "end": 3.85
  },
  {
   "id": "s2",
   "scene": "pais",
   "text": "Os pais passam a visita cuidando do filho e não olham o imóvel.",
   "start": 4.12,
   "end": 7.59
  },
  {
   "id": "s3",
   "scene": "esquecem",
   "text": "E saem sem lembrar da cozinha nem do quarto.",
   "start": 7.88,
   "end": 10.47
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A criança também precisa de uma tarefa na visita.",
   "start": 10.84,
   "end": 13.46
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Leve papel e lápis e peça para ela desenhar como seria o quarto dela.",
   "start": 13.8,
   "end": 18.06
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Criança ocupada, pais atentos, e o quarto já tem dono.",
   "start": 18.44,
   "end": 22.27
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 22.68,
   "end": 27.1
  }
 ],
