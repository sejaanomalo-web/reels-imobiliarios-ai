 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Na decolagem e no pouso, o piloto não pode conversar sobre nada que não seja o voo.",
   "start": 0.12,
   "end": 4.77
  },
  {
   "id": "s2",
   "scene": "regra",
   "text": "É uma regra americana de 1981: abaixo de dez mil pés, só o essencial na cabine.",
   "start": 5.08,
   "end": 10.99
  },
  {
   "id": "s3",
   "scene": "porque",
   "text": "Porque é nesses minutos que uma distração custa mais caro.",
   "start": 11.32,
   "end": 14.49
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A venda também tem fase crítica.",
   "start": 14.76,
   "end": 16.45
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na visita decisiva, na proposta e na assinatura: celular no silencioso e só o assunto do cliente.",
   "start": 16.76,
   "end": 23.73
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Nos minutos que decidem, só o essencial.",
   "start": 24.04,
   "end": 26.35
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.6,
   "end": 31.16
  }
 ],
