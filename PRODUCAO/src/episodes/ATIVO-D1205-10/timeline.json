 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um prédio em São Paulo tem mais apartamentos do que 254 cidades brasileiras têm de casas.",
   "start": 0.12,
   "end": 6.93
  },
  {
   "id": "s2",
   "scene": "predio",
   "text": "É o Copan, de Oscar Niemeyer, inaugurado em 1966: mil cento e sessenta apartamentos.",
   "start": 7.08,
   "end": 13.9
  },
  {
   "id": "s3",
   "scene": "predio",
   "text": "E não são iguais: tem quitinete, tem apartamento grande, tudo no mesmo endereço.",
   "start": 14.12,
   "end": 19.2
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O mesmo prédio serve para vidas completamente diferentes.",
   "start": 19.48,
   "end": 22.77
  },
  {
   "id": "s5",
   "scene": "licao",
   "text": "Na sua carteira é igual: o mesmo endereço pode ser certo para um cliente e errado para outro.",
   "start": 23.0,
   "end": 28.34
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Antes de falar do prédio, pergunte qual vida o cliente quer levar dentro dele.",
   "start": 28.76,
   "end": 32.82
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 33.08,
   "end": 37.6
  }
 ],
