 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente saiu da visita e só lembrava da cor da parede.",
   "start": 0.12,
   "end": 3.57
  },
  {
   "id": "s2",
   "scene": "atencao",
   "text": "Sem saber o que olhar, ele olha o que chama atenção, não o que importa.",
   "start": 4.04,
   "end": 8.19
  },
  {
   "id": "s3",
   "scene": "gosto",
   "text": "E a decisão vira gosto, não critério.",
   "start": 8.36,
   "end": 10.7
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Visita boa começa antes de chegar.",
   "start": 11.32,
   "end": 13.69
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na véspera, mande três coisas para ele observar: a luz da sala, o barulho da rua e o espaço da cozinha.",
   "start": 13.96,
   "end": 21.3
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem sabe o que procurar enxerga o imóvel certo.",
   "start": 21.72,
   "end": 24.66
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.0,
   "end": 29.64
  }
 ],
