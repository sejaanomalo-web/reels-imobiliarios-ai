 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o cliente pudesse desistir da compra em sete dias e receber até a sua comissão de volta?",
   "start": 0.12,
   "end": 5.53
  },
  {
   "id": "s2",
   "scene": "onde",
   "text": "Isso já existe: na compra de imóvel na planta assinada em estande ou fora da sede da incorporadora.",
   "start": 6.12,
   "end": 11.94
  },
  {
   "id": "s3",
   "scene": "regra",
   "text": "A lei dá sete dias para desistir, com devolução de tudo o que foi pago, inclusive a corretagem.",
   "start": 12.28,
   "end": 17.77
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Passados os sete dias sem aviso, o contrato fica firme.",
   "start": 18.2,
   "end": 21.34
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Explique esse prazo antes da assinatura e acompanhe o cliente durante essa semana.",
   "start": 21.72,
   "end": 25.69
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Venda que passa pelos sete dias é venda bem feita.",
   "start": 26.12,
   "end": 29.13
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.56,
   "end": 33.78
  }
 ],
