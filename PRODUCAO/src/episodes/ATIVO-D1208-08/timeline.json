 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o prédio pudesse escolher quem compra o apartamento?",
   "start": 0.12,
   "end": 3.0
  },
  {
   "id": "s2",
   "scene": "ny",
   "text": "Em Nova York, em muitos prédios, um conselho de moradores entrevista o comprador e pode dizer não.",
   "start": 3.32,
   "end": 8.67
  },
  {
   "id": "s3",
   "scene": "aqui",
   "text": "Aqui o condomínio não escolhe o comprador. Mas as regras dele podem barrar o plano de quem compra.",
   "start": 9.0,
   "end": 13.88
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Em 2021, num caso, o STJ decidiu que a convenção pode proibir aluguel por aplicativo em prédio residencial.",
   "start": 14.28,
   "end": 20.58
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Se o seu cliente compra para alugar por temporada, leia a convenção com ele antes da proposta.",
   "start": 20.92,
   "end": 25.49
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O imóvel certo com a regra errada vira o investimento errado.",
   "start": 25.72,
   "end": 29.03
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.48,
   "end": 33.74
  }
 ],
