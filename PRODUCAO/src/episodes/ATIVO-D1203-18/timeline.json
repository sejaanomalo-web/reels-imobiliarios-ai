 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que o móvel que você mesmo montou parece mais bonito?",
   "start": 0.12,
   "end": 3.81
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Pesquisadores americanos testaram: as pessoas pagavam mais por caixas que elas montaram do que por caixas iguais, já prontas.",
   "start": 4.2,
   "end": 11.32
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Até origami malfeito ganhava valor na mão de quem dobrou.",
   "start": 11.56,
   "end": 14.82
  },
  {
   "id": "s4",
   "scene": "estudo",
   "text": "A gente valoriza o que ajudou a construir.",
   "start": 15.24,
   "end": 17.48
  },
  {
   "id": "s5",
   "scene": "virada",
   "text": "Agora pense na busca do seu cliente. Você entrega uma lista pronta.",
   "start": 17.96,
   "end": 22.02
  },
  {
   "id": "s6",
   "scene": "junto",
   "text": "Experimente montar com ele: ele marca os bairros no mapa, define o que não pode faltar, descarta junto com você.",
   "start": 22.52,
   "end": 29.42
  },
  {
   "id": "s7",
   "scene": "desfecho",
   "text": "Imóvel encontrado junto vale mais do que imóvel entregue pronto.",
   "start": 29.88,
   "end": 33.63
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 34.04,
   "end": 38.55
  }
 ],
