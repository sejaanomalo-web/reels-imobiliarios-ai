 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1947, um construtor americano inverteu a linha de montagem: a casa ficava parada, e quem andava era a equipe.",
   "start": 0.12,
   "end": 7.99
  },
  {
   "id": "s2",
   "scene": "etapas",
   "text": "Cada casa foi dividida em vinte e poucas etapas, e cada equipe fazia só a sua, de casa em casa.",
   "start": 8.28,
   "end": 14.2
  },
  {
   "id": "s3",
   "scene": "escala",
   "text": "Assim surgiram mais de dezessete mil casas no mesmo lugar.",
   "start": 14.68,
   "end": 18.26
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O segredo não era trabalhar mais. Era fazer cada etapa sempre do mesmo jeito.",
   "start": 18.52,
   "end": 23.54
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "O seu atendimento também tem etapas: primeiro contato, visita, proposta, documentos. Defina como cada uma é feita.",
   "start": 23.8,
   "end": 31.34
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quando cada etapa tem um jeito certo, você atende mais sem atender pior.",
   "start": 31.72,
   "end": 36.21
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 36.52,
   "end": 41.14
  }
 ],
