 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você chegou, abriu o imóvel, e o cliente não apareceu.",
   "start": 0.2,
   "end": 3.77
  },
  {
   "id": "s2",
   "scene": "motivo",
   "text": "Quase sempre não é maldade: ele esqueceu, ou o dia dele mudou.",
   "start": 4.12,
   "end": 7.65
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Na saúde, uma revisão de estudos mostrou que lembretes reduzem as faltas em cerca de um quarto.",
   "start": 8.12,
   "end": 14.08
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Visita marcada precisa de lembrete.",
   "start": 14.44,
   "end": 16.49
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Confirme na véspera e duas horas antes, com uma pergunta que pede resposta: posso te esperar às dez?",
   "start": 16.76,
   "end": 22.24
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Visita confirmada é visita que acontece.",
   "start": 22.6,
   "end": 24.99
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.24,
   "end": 29.61
  }
 ],
