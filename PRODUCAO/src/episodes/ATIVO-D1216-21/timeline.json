 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente ligou animado para visitar, e o imóvel já tinha sido vendido.",
   "start": 0.12,
   "end": 4.56
  },
  {
   "id": "s2",
   "scene": "tres",
   "text": "O anúncio continuava no ar, em três lugares diferentes.",
   "start": 4.92,
   "end": 8.22
  },
  {
   "id": "s3",
   "scene": "isca",
   "text": "Para quem liga, parece isca, mesmo sem ser.",
   "start": 8.44,
   "end": 11.45
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Anúncio esquecido também fala por você.",
   "start": 11.88,
   "end": 14.36
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No dia da venda, tire o anúncio de todos os lugares, e anote onde ele estava publicado.",
   "start": 14.76,
   "end": 19.94
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Carteira atualizada é carteira confiável.",
   "start": 20.36,
   "end": 22.82
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 23.16,
   "end": 27.61
  }
 ],
