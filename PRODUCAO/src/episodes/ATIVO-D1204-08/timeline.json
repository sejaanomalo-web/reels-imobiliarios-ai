 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se um número na ficha mudasse quanto você acha que a casa vale?",
   "start": 0.12,
   "end": 3.56
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1987, pesquisadores levaram corretores para avaliar a mesma casa, com a mesma ficha. Só mudava um número: o preço pedido.",
   "start": 3.96,
   "end": 12.9
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Quem viu o preço mais alto avaliou a casa mais cara. Quem viu o mais baixo, mais barata.",
   "start": 13.24,
   "end": 17.82
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "E quase nenhum disse que usou aquele preço para decidir.",
   "start": 18.2,
   "end": 21.21
  },
  {
   "id": "s5",
   "scene": "conta",
   "text": "Na sua avaliação, faça a conta antes de olhar o preço que o dono quer: vendidos da região, metragem, estado.",
   "start": 21.64,
   "end": 28.43
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Primeiro o seu número. Depois o dele. Senão, quem avalia é a ficha.",
   "start": 28.76,
   "end": 33.3
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 33.72,
   "end": 38.13
  }
 ],
