 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O imóvel está alugado e o inquilino diz que não vai deixar ninguém visitar.",
   "start": 0.12,
   "end": 4.04
  },
  {
   "id": "s2",
   "scene": "lei",
   "text": "A Lei do Inquilinato diz que ele precisa permitir a visita de quem quer comprar.",
   "start": 4.2,
   "end": 8.02
  },
  {
   "id": "s3",
   "scene": "condicao",
   "text": "Mas com dia e hora combinados antes. Aparecer de surpresa não vale.",
   "start": 8.2,
   "end": 12.03
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A lei dá o direito. O jeito de pedir decide se a porta abre.",
   "start": 12.28,
   "end": 16.0
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Agende por escrito, com antecedência, e chegue no horário que ele aceitou.",
   "start": 16.36,
   "end": 20.08
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Inquilino avisado com antecedência abre a porta de boa vontade.",
   "start": 20.36,
   "end": 24.04
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 24.28,
   "end": 28.43
  }
 ],
