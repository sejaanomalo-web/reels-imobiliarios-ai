 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Cinco pessoas chamam ao mesmo tempo.",
   "start": 0.06,
   "end": 1.58
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Quem responde primeiro?",
   "start": 1.58,
   "end": 2.42
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Uma quer agendar visita.",
   "start": 2.62,
   "end": 3.82
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "Outra pede documentação.",
   "start": 3.82,
   "end": 4.86
  },
  {
   "id": "s5",
   "scene": "situacao",
   "text": "A terceira ainda nem escolheu bairro.",
   "start": 4.86,
   "end": 6.19
  },
  {
   "id": "s6",
   "scene": "situacao",
   "text": "No WhatsApp, tudo parece igualmente urgente.",
   "start": 6.38,
   "end": 8.14
  },
  {
   "id": "s7",
   "scene": "tensao",
   "text": "O erro é responder na ordem em que as mensagens aparecem, sem considerar compromisso, prazo e próximo passo.",
   "start": 8.3,
   "end": 13.3
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Classifique cada contato por etapa e prazo.",
   "start": 13.5,
   "end": 15.48
  },
  {
   "id": "s9",
   "scene": "insight",
   "text": "Primeiro, cumpra o que já foi combinado.",
   "start": 15.66,
   "end": 17.18
  },
  {
   "id": "s10",
   "scene": "insight",
   "text": "Depois, organize os novos pedidos para não prometer o que não consegue entregar.",
   "start": 17.18,
   "end": 19.92
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer visualizar seus atendimentos em um único fluxo?",
   "start": 20.06,
   "end": 22.11
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "O sistema que personalizamos para corretores está no link da bio.",
   "start": 22.3,
   "end": 24.82
  }
 ],
