 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se você mostrasse só três imóveis para cada cliente?",
   "start": 0.12,
   "end": 3.64
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "A ideia vem de um estudo famoso.",
   "start": 3.88,
   "end": 5.54
  },
  {
   "id": "s3",
   "scene": "estudo",
   "text": "Num mercado, uma mesa tinha 24 geleias para provar. Outra, só 6.",
   "start": 5.773,
   "end": 10.49
  },
  {
   "id": "s4",
   "scene": "estudo",
   "text": "Com 6, 30% de quem parou na mesa comprou. Com 24, só 3%.",
   "start": 10.76,
   "end": 15.93
  },
  {
   "id": "s5",
   "scene": "virada",
   "text": "Só que, anos depois, uma revisão de 50 experimentos achou um efeito médio quase zero.",
   "start": 16.44,
   "end": 21.83
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "Muita opção só atrapalha quando a pessoa ainda não sabe o que quer.",
   "start": 22.28,
   "end": 25.67
  },
  {
   "id": "s7",
   "scene": "criterio",
   "text": "Então o número de imóveis importa menos que a ordem.",
   "start": 26.2,
   "end": 29.03
  },
  {
   "id": "s8",
   "scene": "criterio",
   "text": "Primeiro, os critérios: bairro, quartos, o que não pode faltar.",
   "start": 29.32,
   "end": 33.59
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Com critério claro, o cliente compara. Sem critério, ele só se perde.",
   "start": 33.88,
   "end": 38.23
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 38.52,
   "end": 42.94
  }
 ],
