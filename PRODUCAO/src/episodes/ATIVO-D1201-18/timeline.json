 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o comprador pudesse desistir do apartamento uma semana depois de assinar?",
   "start": 0.12,
   "end": 4.64
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "No imóvel na planta, em alguns casos, ele pode.",
   "start": 5.0,
   "end": 8.21
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "Pela Lei do Distrato, de 2018, quem compra no estande de vendas ou fora da sede da incorporadora tem 7 dias para se arrepender.",
   "start": 8.6,
   "end": 16.15
  },
  {
   "id": "s4",
   "scene": "devolve",
   "text": "E recebe de volta tudo o que pagou.",
   "start": 16.52,
   "end": 18.35
  },
  {
   "id": "s5",
   "scene": "devolve",
   "text": "Para parte dos especialistas, inclusive o valor da corretagem.",
   "start": 18.84,
   "end": 22.42
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "Ou seja: a venda no estande só termina de verdade depois de 7 dias.",
   "start": 23.0,
   "end": 27.24
  },
  {
   "id": "s7",
   "scene": "pressao",
   "text": "Por isso, pressão para fechar no impulso costuma sair cara.",
   "start": 27.56,
   "end": 30.89
  },
  {
   "id": "s8",
   "scene": "pressao",
   "text": "Quem compra empurrado tem uma semana inteira para pensar.",
   "start": 31.16,
   "end": 33.89
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Venda boa é a que continua de pé no oitavo dia.",
   "start": 34.36,
   "end": 37.38
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 37.72,
   "end": 42.13
  }
 ],
