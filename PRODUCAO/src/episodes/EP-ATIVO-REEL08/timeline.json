 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A comissão caiu na conta.",
   "start": 0.2,
   "end": 1.65
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Agora vem uma decisão que quase nunca aparece nas fotos de conquista.",
   "start": 1.88,
   "end": 5.34
  },
  {
   "id": "s3",
   "scene": "prim",
   "text": "Num cenário hipotético, um profissional comemora a venda e volta à rotina sem revisar o que aconteceu: de onde veio o cliente, quais imóveis despertaram interesse e quem ainda ficou em negociação.",
   "start": 5.8,
   "end": 16.41
  },
  {
   "id": "s4",
   "scene": "prim",
   "text": "No mês seguinte, precisa reconstruir tudo de memória.",
   "start": 16.84,
   "end": 19.74
  },
  {
   "id": "s5",
   "scene": "outro",
   "text": "O segundo também comemora.",
   "start": 20.28,
   "end": 21.89
  },
  {
   "id": "s6",
   "scene": "outro",
   "text": "Mas registra a origem da oportunidade, atualiza os interessados, organiza a carteira e reserva um tempo para prospecção.",
   "start": 22.04,
   "end": 28.83
  },
  {
   "id": "s7",
   "scene": "outro",
   "text": "Não é uma máquina que vende sozinha.",
   "start": 29.24,
   "end": 31.08
  },
  {
   "id": "s8",
   "scene": "outro",
   "text": "É uma operação que preserva o aprendizado de cada atendimento.",
   "start": 31.4,
   "end": 34.71
  },
  {
   "id": "s9",
   "scene": "ideia",
   "text": "O resultado de uma venda não está só na comissão recebida.",
   "start": 35.16,
   "end": 38.26
  },
  {
   "id": "s10",
   "scene": "ideia",
   "text": "Também pode estar na base de contatos, no conhecimento do público e na estrutura que você constrói para trabalhar melhor na próxima negociação.",
   "start": 38.52,
   "end": 45.69
  },
  {
   "id": "s11",
   "scene": "ideia",
   "text": "No próximo fechamento, reserve um momento para revisar o que essa venda ensinou.",
   "start": 46.12,
   "end": 50.11
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 50.44,
   "end": 55.22
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 55.589,
   "end": 58.28
  }
 ],
