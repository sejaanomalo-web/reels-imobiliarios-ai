 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O proprietário te liga: o outro corretor disse que vende a casa por 50 mil a mais.",
   "start": 0.2,
   "end": 5.58
  },
  {
   "id": "s2",
   "scene": "tentacao",
   "text": "A vontade é brigar pelo número.",
   "start": 5.72,
   "end": 7.39
  },
  {
   "id": "s3",
   "scene": "tentacao",
   "text": "Mas o preço mais alto costuma ganhar a captação, não a venda.",
   "start": 7.64,
   "end": 10.73
  },
  {
   "id": "s4",
   "scene": "parado",
   "text": "Imóvel acima do mercado fica parado.",
   "start": 11.24,
   "end": 13.32
  },
  {
   "id": "s5",
   "scene": "parado",
   "text": "Sem visita, o anúncio envelhece, o comprador desconfia, e o preço cai.",
   "start": 13.56,
   "end": 17.46
  },
  {
   "id": "s6",
   "scene": "parado",
   "text": "Às vezes, abaixo do que você tinha sugerido.",
   "start": 17.72,
   "end": 20.02
  },
  {
   "id": "s7",
   "scene": "virada",
   "text": "Então não discuta a avaliação. Mostre por quanto os imóveis parecidos foram vendidos.",
   "start": 20.44,
   "end": 25.24
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Vendidos, não anunciados.",
   "start": 25.48,
   "end": 27.04
  },
  {
   "id": "s9",
   "scene": "regra",
   "text": "E combine uma regra com o dono: se em 30 dias não tiver visita, vocês revisam o preço juntos.",
   "start": 27.24,
   "end": 32.18
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "O número mais alto ganha a assinatura. A data combinada ganha a venda.",
   "start": 32.36,
   "end": 36.31
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 36.6,
   "end": 40.75
  }
 ],
