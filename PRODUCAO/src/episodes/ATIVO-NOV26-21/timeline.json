 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um executivo do setor afirmou que oitenta e cinco por cento do mercado imobiliário brasileiro é de usados.",
   "start": 0.12,
   "end": 5.98
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O número chama atenção.",
   "start": 6.12,
   "end": 7.15
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Mas a lição não é abandonar os lançamentos.",
   "start": 7.32,
   "end": 9.51
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "A fala foi apresentada no Conexão Imobiliária do Secovi, em novembro.",
   "start": 9.8,
   "end": 13.59
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "É uma estimativa atribuída ao palestrante, não um censo que a gente possa aplicar automaticamente a cada cidade.",
   "start": 13.8,
   "end": 20.04
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Para quem trabalha com revenda, a pergunta interessante é: você conhece a origem, a documentação, a situação e o posicionamento dos imóveis que capta?",
   "start": 20.36,
   "end": 29.27
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Um estoque grande sem qualidade pode ser um problema.",
   "start": 29.56,
   "end": 32.16
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de buscar mais volume, vale melhorar avaliação, qualificação e atualização das informações.",
   "start": 32.52,
   "end": 38.48
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "O corretor que entende sua carteira consegue orientar melhor o comprador e o proprietário.",
   "start": 38.76,
   "end": 43.44
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Carteira confiável começa na captação.",
   "start": 43.72,
   "end": 46.01
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 46.28,
   "end": 50.83
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 51.189,
   "end": 53.96
  }
 ],
