 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que dez minutos numa fila parecem uma hora?",
   "start": 0.12,
   "end": 2.97
  },
  {
   "id": "s2",
   "scene": "principios",
   "text": "Em 1985, um professor de negócios escreveu sobre isso: espera sem nada para fazer parece mais longa.",
   "start": 3.32,
   "end": 10.17
  },
  {
   "id": "s3",
   "scene": "principios",
   "text": "Espera sem prazo parece maior ainda. E espera sem explicação, pior.",
   "start": 10.52,
   "end": 15.47
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Agora pense no seu cliente esperando a aprovação do financiamento, sem saber em que etapa está.",
   "start": 15.96,
   "end": 21.0
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Mande uma mensagem a cada etapa: documentos enviados, análise começou, falta a avaliação.",
   "start": 21.32,
   "end": 26.8
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "A espera continua a mesma. Mas explicada, ela pesa menos.",
   "start": 27.08,
   "end": 31.21
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 31.48,
   "end": 35.72
  }
 ],
