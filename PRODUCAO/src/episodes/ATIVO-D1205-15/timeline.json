 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente gostou do imóvel e disse: vou pensar.",
   "start": 0.12,
   "end": 3.19
  },
  {
   "id": "s2",
   "scene": "erro",
   "text": "Você responde: claro, fico no aguardo. E a conversa morre ali.",
   "start": 3.56,
   "end": 7.98
  },
  {
   "id": "s3",
   "scene": "virada",
   "text": "Muitas vezes, vou pensar não é sobre tempo. É uma dúvida que ele ainda não falou.",
   "start": 8.44,
   "end": 13.97
  },
  {
   "id": "s4",
   "scene": "pergunta",
   "text": "Pergunte com calma: pensar em quê, exatamente? É o valor, o bairro ou alguém que precisa ver também?",
   "start": 14.114,
   "end": 21.15
  },
  {
   "id": "s5",
   "scene": "efeito",
   "text": "Agora você sabe o que resolver, e ele não precisa inventar desculpa.",
   "start": 21.72,
   "end": 25.89
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem pergunta o motivo ganha uma conversa. Quem só aguarda corre o risco de perder o cliente em silêncio.",
   "start": 26.2,
   "end": 32.28
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.6,
   "end": 36.96
  }
 ],
