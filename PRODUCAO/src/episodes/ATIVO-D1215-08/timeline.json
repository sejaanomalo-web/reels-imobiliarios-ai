 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o comprador pudesse desistir da compra depois de ver o laudo da vistoria?",
   "start": 0.12,
   "end": 4.67
  },
  {
   "id": "s2",
   "scene": "eua",
   "text": "Nos Estados Unidos, isso é comum: o contrato costuma dar de sete a dez dias para a inspeção da casa.",
   "start": 5.0,
   "end": 10.09
  },
  {
   "id": "s3",
   "scene": "problema",
   "text": "Se a inspeção encontra problema, o comprador negocia ou desiste do negócio.",
   "start": 10.36,
   "end": 14.81
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Aqui não é regra, mas pode ser combinado.",
   "start": 15.08,
   "end": 17.24
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na proposta, escreva o prazo para a vistoria técnica e o que acontece se ela encontrar problema.",
   "start": 17.56,
   "end": 22.35
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Problema achado antes da assinatura é negociação. Depois, vira briga.",
   "start": 22.68,
   "end": 27.39
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.72,
   "end": 31.96
  }
 ],
