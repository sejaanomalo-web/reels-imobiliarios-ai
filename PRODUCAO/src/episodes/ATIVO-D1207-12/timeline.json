 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dois carimbos de graça fizeram mais gente voltar ao lava-rápido.",
   "start": 0.12,
   "end": 3.61
  },
  {
   "id": "s2",
   "scene": "oito",
   "text": "Num estudo publicado em 2006, metade dos clientes recebeu um cartão de oito lavagens.",
   "start": 3.88,
   "end": 8.71
  },
  {
   "id": "s3",
   "scene": "dez",
   "text": "A outra metade recebeu um cartão de dez, com duas já carimbadas. Nos dois, faltavam oito.",
   "start": 8.92,
   "end": 14.14
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Quem via o caminho já começado completou mais, e mais rápido.",
   "start": 14.36,
   "end": 17.84
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No financiamento, mostre o que já foi feito: documentos enviados, simulação pronta, falta a avaliação.",
   "start": 18.12,
   "end": 24.26
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Ninguém larga fácil um caminho que já começou.",
   "start": 24.6,
   "end": 27.02
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.4,
   "end": 31.7
  }
 ],
