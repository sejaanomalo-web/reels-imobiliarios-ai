 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O apartamento na planta atrasou seis meses. E pode estar tudo dentro do contrato.",
   "start": 0.12,
   "end": 4.82
  },
  {
   "id": "s2",
   "scene": "regra",
   "text": "A lei permite uma tolerância de até 180 dias depois da data prometida.",
   "start": 5.0,
   "end": 9.37
  },
  {
   "id": "s3",
   "scene": "condicao",
   "text": "Mas só se essa cláusula estiver no contrato, clara e destacada.",
   "start": 9.72,
   "end": 13.39
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Passou disso, quem comprou pode desfazer o negócio e receber o que pagou, com a multa. Ou manter e ser indenizado.",
   "start": 13.64,
   "end": 20.21
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na venda, mostre essa cláusula ao cliente e anote a data prometida.",
   "start": 20.68,
   "end": 24.54
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Atraso combinado é prazo. Atraso escondido vira briga.",
   "start": 24.92,
   "end": 29.02
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.32,
   "end": 33.91
  }
 ],
