 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A pergunta mais importante do atendimento tem duas palavras: por que agora?",
   "start": 0.12,
   "end": 4.65
  },
  {
   "id": "s2",
   "scene": "meses",
   "text": "O cliente procurava há meses e, de repente, quer visitar esta semana.",
   "start": 5.0,
   "end": 8.93
  },
  {
   "id": "s3",
   "scene": "mudou",
   "text": "Alguma coisa mudou: um filho a caminho, um emprego novo, o fim do aluguel.",
   "start": 9.4,
   "end": 14.62
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O motivo do agora mostra o prazo, o que pesa e quem decide.",
   "start": 15.08,
   "end": 19.8
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Pergunte com naturalidade: o que fez você começar a procurar agora?",
   "start": 20.2,
   "end": 23.92
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem entende o agora atende no tempo certo.",
   "start": 24.28,
   "end": 27.24
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.64,
   "end": 32.23
  }
 ],
