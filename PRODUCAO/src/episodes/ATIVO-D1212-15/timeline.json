 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "No dia seguinte à visita, o cliente já esqueceu boa parte do que viu.",
   "start": 0.12,
   "end": 3.75
  },
  {
   "id": "s2",
   "scene": "prova",
   "text": "Em 1885, um psicólogo alemão mediu isso: a memória cai rápido nas primeiras horas.",
   "start": 4.12,
   "end": 9.66
  },
  {
   "id": "s3",
   "scene": "casa",
   "text": "E o que ele não lembra, ele não defende na conversa em casa.",
   "start": 9.96,
   "end": 13.06
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Não espere ele perguntar.",
   "start": 13.48,
   "end": 14.9
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No mesmo dia, mande um resumo: três fotos, o que ele gostou e o que ficou de dúvida.",
   "start": 15.24,
   "end": 20.12
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O imóvel que fica na memória é o que entra na conversa.",
   "start": 20.44,
   "end": 23.48
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 23.72,
   "end": 28.05
  }
 ],
