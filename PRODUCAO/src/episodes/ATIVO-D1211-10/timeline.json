 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Chegou mensagem do cliente às onze da noite. E você respondeu na hora.",
   "start": 0.12,
   "end": 4.59
  },
  {
   "id": "s2",
   "scene": "repete",
   "text": "No dia seguinte, ele manda de novo às onze. E às onze e meia.",
   "start": 5.0,
   "end": 9.46
  },
  {
   "id": "s3",
   "scene": "ensinou",
   "text": "Você ensinou que o seu horário é qualquer horário.",
   "start": 9.88,
   "end": 12.59
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Responda de manhã, cedo, com tudo resolvido.",
   "start": 12.92,
   "end": 15.76
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Se for urgente de verdade, ligue. Se não, uma mensagem curta: amanhã às nove te mando tudo.",
   "start": 16.12,
   "end": 22.59
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Disponível não é o mesmo que sempre online.",
   "start": 23.16,
   "end": 26.38
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.76,
   "end": 31.29
  }
 ],
