 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1966, pesquisadores pediram a moradores da Califórnia para colocar uma placa enorme no jardim.",
   "start": 0.12,
   "end": 7.26
  },
  {
   "id": "s2",
   "scene": "sim",
   "text": "Entre quem semanas antes tinha aceitado só uma plaquinha na janela, três em cada quatro disseram sim.",
   "start": 7.64,
   "end": 13.94
  },
  {
   "id": "s3",
   "scene": "nao",
   "text": "Entre quem ouviu só o pedido grande, a maioria recusou.",
   "start": 14.28,
   "end": 17.64
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Um sim pequeno abre caminho para o grande.",
   "start": 18.12,
   "end": 20.84
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na captação, não peça a exclusividade na primeira conversa: peça primeiro para conhecer o imóvel e fazer a avaliação.",
   "start": 21.24,
   "end": 28.13
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem começa pelo passo pequeno chega ao grande.",
   "start": 28.52,
   "end": 31.69
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.04,
   "end": 36.52
  }
 ],
