 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você pode ter um anúncio excelente e ainda assim perder a conversa depois do clique.",
   "start": 0.12,
   "end": 4.47
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "O interessado preenche o formulário, mas ninguém assume o primeiro retorno.",
   "start": 4.68,
   "end": 8.26
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Ou recebe resposta e fica sem próximo passo registrado.",
   "start": 8.52,
   "end": 11.54
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Antes de aumentar o investimento, confira se existe responsável, rotina de acompanhamento e um registro de cada oportunidade.",
   "start": 11.96,
   "end": 18.9
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Marketing gera conversas possíveis. Processo comercial dá continuidade. Uma parte não substitui a outra.",
   "start": 19.32,
   "end": 25.67
  },
  {
   "id": "s6",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 25.96,
   "end": 30.44
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 30.739,
   "end": 33.46
  }
 ],
