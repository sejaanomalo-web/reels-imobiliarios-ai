 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A foto do banheiro foi para o anúncio com a tampa do vaso levantada.",
   "start": 0.12,
   "end": 3.33
  },
  {
   "id": "s2",
   "scene": "reacao",
   "text": "Quem rola o anúncio repara na hora, e passa para o próximo.",
   "start": 3.64,
   "end": 7.11
  },
  {
   "id": "s3",
   "scene": "visita",
   "text": "A foto é a primeira visita, e ela acontece sem você.",
   "start": 7.48,
   "end": 10.49
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Antes de fotografar, o imóvel precisa de cinco minutos de preparo.",
   "start": 10.84,
   "end": 14.41
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Luzes acesas, cortinas abertas, tampa abaixada, objetos pessoais guardados e celular na horizontal.",
   "start": 14.68,
   "end": 21.91
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Cinco minutos de preparo valem mais que cem fotos.",
   "start": 22.307,
   "end": 25.0
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.32,
   "end": 29.88
  }
 ],
