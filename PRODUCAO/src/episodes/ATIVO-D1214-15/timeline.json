 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma garçonete ganhou gorjetas maiores sem trabalhar mais e sem sorrir mais.",
   "start": 0.12,
   "end": 5.24
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 2003, na Holanda, ela repetiu o pedido com as mesmas palavras do cliente em metade das mesas.",
   "start": 5.4,
   "end": 11.11
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Nessas mesas, as gorjetas foram maiores.",
   "start": 11.48,
   "end": 14.19
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ouvir a própria frase de volta prova que alguém prestou atenção.",
   "start": 14.52,
   "end": 18.2
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Anote as palavras exatas do cliente: se ele disse quintal para o cachorro, não escreva área externa.",
   "start": 18.52,
   "end": 24.39
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem repete as palavras do cliente mostra que ouviu.",
   "start": 24.68,
   "end": 27.36
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.8,
   "end": 32.19
  }
 ],
