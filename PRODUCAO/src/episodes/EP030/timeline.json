 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quer ter mais clareza sobre sua carteira?",
   "start": 0.12,
   "end": 2.34
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Experimente esta revisão semanal de quinze minutos.",
   "start": 2.68,
   "end": 5.3
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Abra seus imóveis ativos e separe três grupos: os que receberam interesse, os que precisam de atualização e os que estão sem próximo passo definido.",
   "start": 5.88,
   "end": 14.75
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "No segundo grupo, confira preço, status, fotos e informações.",
   "start": 15.16,
   "end": 18.97
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "No terceiro, decida qual ação faz sentido e quem será responsável.",
   "start": 19.48,
   "end": 23.71
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "O objetivo não é cobrar uma venda toda semana.",
   "start": 24.36,
   "end": 26.68
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "É impedir que a carteira vire um arquivo esquecido.",
   "start": 26.92,
   "end": 29.28
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Registre as decisões e revise na próxima reunião.",
   "start": 29.72,
   "end": 32.38
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Essa revisão fica mais fácil quando a carteira inteira está organizada.",
   "start": 33.16,
   "end": 36.08
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 36.44,
   "end": 41.24
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 41.539,
   "end": 44.28
  }
 ],
