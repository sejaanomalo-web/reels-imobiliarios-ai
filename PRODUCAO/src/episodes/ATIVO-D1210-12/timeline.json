 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Corretores experientes avaliaram a mesma casa. E erraram na mesma direção.",
   "start": 0.2,
   "end": 5.11
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1987, pesquisadores mostraram a casa a corretores com fichas iguais, menos um detalhe: o preço pedido.",
   "start": 5.32,
   "end": 12.63
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Quanto mais alto o preço da ficha, mais alta ficava a avaliação.",
   "start": 12.92,
   "end": 16.63
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "E a maioria disse que o preço pedido não tinha influenciado.",
   "start": 16.92,
   "end": 20.29
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de olhar o preço pedido, avalie pelas vendas parecidas. Só depois compare.",
   "start": 20.6,
   "end": 25.57
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O primeiro número que você vê decide mais do que parece.",
   "start": 25.88,
   "end": 29.01
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.32,
   "end": 33.67
  }
 ],
