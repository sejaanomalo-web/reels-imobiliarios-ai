 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Agendar toda visita que pedem pode parecer produtividade.",
   "start": 0.2,
   "end": 3.64
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Nem sempre é.",
   "start": 3.96,
   "end": 4.69
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Um interessado quer conhecer o apartamento, mas ainda não sabe se precisa de três quartos ou se aquele valor cabe no planejamento.",
   "start": 5.16,
   "end": 11.54
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "Antes de confirmar, alinhe o básico: características desejadas, faixa de investimento e objetivo da visita.",
   "start": 12.12,
   "end": 18.44
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Isso evita deslocamentos sem contexto.",
   "start": 18.44,
   "end": 20.37
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Se estiver tudo alinhado, marque a visita.",
   "start": 20.76,
   "end": 22.98
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Se não, ajude a pessoa a definir melhor o que busca.",
   "start": 23.32,
   "end": 25.9
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Qualificação não precisa ser pressão.",
   "start": 26.36,
   "end": 28.46
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Para decidir isso, ajuda ter os critérios de cada comprador ao lado da agenda.",
   "start": 28.84,
   "end": 32.86
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 33.16,
   "end": 37.79
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 38.099,
   "end": 40.77
  }
 ],
