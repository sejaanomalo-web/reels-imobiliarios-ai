 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se todo anúncio de imóvel mostrasse quanto a casa gasta de energia?",
   "start": 0.12,
   "end": 3.97
  },
  {
   "id": "s2",
   "scene": "europa",
   "text": "Na União Europeia, o anúncio de venda ou de aluguel tem que mostrar a classe de energia do imóvel.",
   "start": 4.2,
   "end": 9.19
  },
  {
   "id": "s3",
   "scene": "aqui",
   "text": "Aqui, para imóvel residencial privado, essa etiqueta ainda é voluntária.",
   "start": 9.48,
   "end": 13.06
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Mas o cliente já pergunta: bate sol à tarde? A conta de luz é alta?",
   "start": 13.32,
   "end": 17.52
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Anote a face do sol, peça ao dono as últimas contas de luz e coloque isso na ficha do imóvel.",
   "start": 17.88,
   "end": 22.79
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O preço se paga uma vez. A conta chega todo mês.",
   "start": 23.16,
   "end": 26.86
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.08,
   "end": 31.36
  }
 ],
