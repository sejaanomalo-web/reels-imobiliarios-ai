 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Seu cliente não vai lembrar da visita inteira. Só de dois momentos.",
   "start": 0.12,
   "end": 4.25
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Pesquisadores mediram, minuto a minuto, o incômodo de pacientes durante um exame médico.",
   "start": 4.52,
   "end": 9.85
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Na lembrança, pesou o pior momento e o final. A duração quase não contou.",
   "start": 10.12,
   "end": 14.76
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Na visita é parecido: o ponto alto e o fim viram a memória do imóvel.",
   "start": 15.08,
   "end": 19.66
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Planeje a rota e termine no melhor lugar: a varanda, a vista, a cozinha clara.",
   "start": 19.911,
   "end": 25.88
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem termina bem é lembrado melhor.",
   "start": 26.28,
   "end": 28.55
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.92,
   "end": 33.61
  }
 ],
