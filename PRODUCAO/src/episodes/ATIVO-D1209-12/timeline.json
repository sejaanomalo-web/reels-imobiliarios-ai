 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dê uma caneca a uma pessoa, e ela passa a valer mais que o dobro.",
   "start": 0.12,
   "end": 3.88
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Num estudo de 1990, pesquisadores deram canecas a metade dos participantes e abriram um mercado entre eles.",
   "start": 4.12,
   "end": 11.07
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Quem ganhou a caneca pedia mais que o dobro do que os outros topavam pagar.",
   "start": 11.32,
   "end": 15.59
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Isso tem nome: efeito dotação. Agora pense no dono de uma casa em que ele viveu vinte anos.",
   "start": 15.96,
   "end": 22.16
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Ouça a história da casa primeiro. Depois, mostre o que o mercado pagou por casas parecidas.",
   "start": 22.44,
   "end": 28.11
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O dono não está mentindo. Ele está sentindo o preço.",
   "start": 28.36,
   "end": 31.87
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.2,
   "end": 36.69
  }
 ],
