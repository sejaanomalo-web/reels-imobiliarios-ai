 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Ela começou na corretagem aos cinquenta anos, trabalhando com aluguéis de novecentos reais.",
   "start": 0.12,
   "end": 4.89
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Hoje é referência em imóveis de alto padrão.",
   "start": 5.08,
   "end": 7.58
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "O que mudou primeiro não foi o preço das casas.",
   "start": 7.96,
   "end": 10.27
  },
  {
   "id": "s4",
   "scene": "comeco",
   "text": "Mônica Poplawski já tinha experiência diante das câmeras, mas precisou aprender o mercado imobiliário começando por locações pequenas.",
   "start": 10.6,
   "end": 17.33
  },
  {
   "id": "s5",
   "scene": "comeco",
   "text": "Ela própria conta que a evolução foi gradual.",
   "start": 17.64,
   "end": 19.88
  },
  {
   "id": "s6",
   "scene": "comeco",
   "text": "Primeiro vem o repertório, depois a segurança para atender públicos e imóveis diferentes.",
   "start": 20.2,
   "end": 24.57
  },
  {
   "id": "s7",
   "scene": "diferencial",
   "text": "Em imóveis de alto padrão, uma apresentação bonita não basta.",
   "start": 24.92,
   "end": 28.0
  },
  {
   "id": "s8",
   "scene": "diferencial",
   "text": "É preciso estudar materiais, circulação, arquitetura, contexto e perguntas que aquele comprador provavelmente fará.",
   "start": 28.2,
   "end": 34.93
  },
  {
   "id": "s9",
   "scene": "diferencial",
   "text": "A confiança aparece quando o profissional explica sem improvisar.",
   "start": 35.32,
   "end": 38.7
  },
  {
   "id": "s10",
   "scene": "licao",
   "text": "Talvez você ainda não trabalhe com o imóvel que deseja vender daqui a alguns anos.",
   "start": 39.24,
   "end": 42.79
  },
  {
   "id": "s11",
   "scene": "licao",
   "text": "Mas já pode construir o hábito necessário para chegar lá: estudar melhor cada produto e apresentar somente o que consegue sustentar com informação.",
   "start": 43.08,
   "end": 50.8
  },
  {
   "id": "s12",
   "scene": "licao",
   "text": "Escolhe um imóvel da sua carteira para estudar com mais profundidade hoje.",
   "start": 51.24,
   "end": 54.47
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 54.92,
   "end": 59.15
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 59.589,
   "end": 62.29
  }
 ],
