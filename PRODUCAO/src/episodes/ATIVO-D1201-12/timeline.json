 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A partir de hoje, aluguel de imóvel entra na nota fiscal.",
   "start": 0.12,
   "end": 3.38
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas não para todo mundo.",
   "start": 3.8,
   "end": 4.9
  },
  {
   "id": "s3",
   "scene": "regra",
   "text": "Pelo calendário oficial da reforma tributária, desde 1º de dezembro a locação de imóvel tem nota fiscal de serviço eletrônica.",
   "start": 5.16,
   "end": 11.84
  },
  {
   "id": "s4",
   "scene": "empresa",
   "text": "Empresa que aluga imóvel emite. Sem piso de receita, sem mínimo de imóveis.",
   "start": 12.36,
   "end": 16.61
  },
  {
   "id": "s5",
   "scene": "empresa",
   "text": "Se a empresa é do Simples Nacional, a data é outra: janeiro de 2027.",
   "start": 16.84,
   "end": 21.55
  },
  {
   "id": "s6",
   "scene": "pf",
   "text": "E a pessoa física?",
   "start": 21.8,
   "end": 22.82
  },
  {
   "id": "s7",
   "scene": "pf",
   "text": "Pela lei da reforma, ela só entra no imposto com mais de 240 mil reais de aluguel no ano anterior e mais de três imóveis.",
   "start": 23.16,
   "end": 30.15
  },
  {
   "id": "s8",
   "scene": "pf",
   "text": "E ainda tem divergência de leitura sobre a nota.",
   "start": 30.44,
   "end": 32.79
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Ou seja: seu cliente proprietário vai te perguntar.",
   "start": 33.32,
   "end": 36.35
  },
  {
   "id": "s10",
   "scene": "virada",
   "text": "E a resposta honesta é: depende de quem aluga.",
   "start": 36.6,
   "end": 39.59
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Corretor não precisa virar contador.",
   "start": 40.04,
   "end": 41.95
  },
  {
   "id": "s12",
   "scene": "desfecho",
   "text": "Precisa saber a pergunta certa e indicar quem responde.",
   "start": 42.28,
   "end": 45.3
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 45.72,
   "end": 50.29
  }
 ],
