 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quando um comprador chega por indicação, alguém já contou alguma coisa sobre você.",
   "start": 0.12,
   "end": 4.16
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Quando ele chega por um anúncio, talvez tudo o que conheça seja uma foto e um preço.",
   "start": 4.52,
   "end": 8.96
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Tratar os dois contatos do mesmo jeito pode ser um erro.",
   "start": 9.32,
   "end": 11.64
  },
  {
   "id": "s4",
   "scene": "resposta",
   "text": "Imagine que alguém pede informações de um apartamento.",
   "start": 11.96,
   "end": 14.51
  },
  {
   "id": "s5",
   "scene": "resposta",
   "text": "Você responde com cinco mensagens prontas, um PDF enorme e um convite para visitar antes de perguntar o que chamou atenção.",
   "start": 15.0,
   "end": 21.34
  },
  {
   "id": "s6",
   "scene": "resposta",
   "text": "A pessoa ainda está tentando entender se aquele imóvel faz sentido.",
   "start": 21.8,
   "end": 24.87
  },
  {
   "id": "s7",
   "scene": "ponte",
   "text": "Uma alternativa é começar conectando o pedido à resposta.",
   "start": 25.16,
   "end": 27.9
  },
  {
   "id": "s8",
   "scene": "ponte",
   "text": "Algo como: “Vi que você perguntou sobre o apartamento da região central.",
   "start": 28.2,
   "end": 32.15
  },
  {
   "id": "s9",
   "scene": "ponte",
   "text": "Ele tem dois quartos e uma vaga.",
   "start": 32.52,
   "end": 34.08
  },
  {
   "id": "s10",
   "scene": "ponte",
   "text": "Você quer primeiro entender o valor e as condições ou comparar com outras opções?”",
   "start": 34.52,
   "end": 38.64
  },
  {
   "id": "s11",
   "scene": "ponte",
   "text": "Use apenas dados confirmados do imóvel anunciado.",
   "start": 39.0,
   "end": 41.63
  },
  {
   "id": "s12",
   "scene": "confianca",
   "text": "Se o interessado responder, avance uma questão por vez.",
   "start": 42.04,
   "end": 45.29
  },
  {
   "id": "s13",
   "scene": "confianca",
   "text": "Se ele pedir documentação, explique o que você pode verificar.",
   "start": 45.64,
   "end": 48.67
  },
  {
   "id": "s14",
   "scene": "confianca",
   "text": "Se quiser visitar, combine horários.",
   "start": 49.08,
   "end": 51.05
  },
  {
   "id": "s15",
   "scene": "confianca",
   "text": "Se estiver só pesquisando, respeite o momento.",
   "start": 51.4,
   "end": 54.04
  },
  {
   "id": "s16",
   "scene": "confianca",
   "text": "O objetivo é transformar um clique em uma conversa compreensível.",
   "start": 54.36,
   "end": 57.91
  },
  {
   "id": "s17",
   "scene": "insight",
   "text": "O primeiro contato não precisa provar que você é o melhor corretor da cidade.",
   "start": 58.28,
   "end": 61.83
  },
  {
   "id": "s18",
   "scene": "insight",
   "text": "Precisa mostrar que você ouviu a pergunta, sabe responder e não vai pressionar a pessoa sem necessidade.",
   "start": 62.2,
   "end": 67.28
  },
  {
   "id": "s19",
   "scene": "insight",
   "text": "Revise estes passos antes de atender seu próximo lead de anúncio.",
   "start": 67.8,
   "end": 70.85
  },
  {
   "id": "s20",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 71.24,
   "end": 75.42
  },
  {
   "id": "s21",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 75.859,
   "end": 78.42
  }
 ],
