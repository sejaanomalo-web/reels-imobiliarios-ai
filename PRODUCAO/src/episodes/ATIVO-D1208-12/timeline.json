 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você já ouviu que as palavras valem só sete por cento da comunicação?",
   "start": 0.12,
   "end": 3.76
  },
  {
   "id": "s2",
   "scene": "origem",
   "text": "Esse número vem de experimentos dos anos sessenta, sobre como as pessoas percebem sentimentos.",
   "start": 4.12,
   "end": 8.98
  },
  {
   "id": "s3",
   "scene": "condicao",
   "text": "E só quando a voz e o rosto contradizem as palavras.",
   "start": 9.4,
   "end": 12.55
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O próprio autor diz que o número é mal citado. Fora disso, as palavras pesam muito.",
   "start": 13.0,
   "end": 18.03
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na proposta, escreva claro: valor, condições, prazo, o que está incluso.",
   "start": 18.44,
   "end": 24.33
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Postura ajuda. Mas quem fecha o negócio são as palavras certas.",
   "start": 24.76,
   "end": 28.71
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.0,
   "end": 33.31
  }
 ],
