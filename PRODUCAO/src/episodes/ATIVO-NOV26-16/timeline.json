 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Existe uma modalidade do Minha Casa Minha Vida chamada Compra Assistida.",
   "start": 0.2,
   "end": 4.25
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas ela não foi criada para qualquer comprador escolher um imóvel com subsídio.",
   "start": 4.52,
   "end": 8.17
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "A regulamentação divulgada em novembro trata de situações específicas, como localidades com reconhecimento federal de emergência ou calamidade e áreas atingidas por determinadas obras públicas.",
   "start": 8.44,
   "end": 19.16
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Imagine um corretor divulgando “novo benefício para todo mundo”.",
   "start": 19.4,
   "end": 22.8
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "A pessoa chama, faz planos e só depois descobre que a situação dela não se enquadra.",
   "start": 23.08,
   "end": 27.86
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "O problema não é a curiosidade.",
   "start": 28.12,
   "end": 29.72
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "É a falta de contexto.",
   "start": 29.72,
   "end": 31.0
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Quando uma regra nova aparece, leia quem pode participar, onde se aplica e como funciona o encaminhamento.",
   "start": 31.24,
   "end": 37.14
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Explicar o limite da notícia também é prestar um bom serviço.",
   "start": 37.4,
   "end": 40.29
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Antes de comentar o programa, consulte a portaria.",
   "start": 40.52,
   "end": 42.85
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 43.08,
   "end": 47.44
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 47.728,
   "end": 50.33
  }
 ],
