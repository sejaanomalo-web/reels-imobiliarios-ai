 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A Ópera de Sydney deveria ficar pronta em 1963 e custar sete milhões de dólares australianos.",
   "start": 0.12,
   "end": 6.73
  },
  {
   "id": "s2",
   "scene": "real",
   "text": "Ficou pronta em 1973, e custou cento e dois milhões.",
   "start": 7.0,
   "end": 11.87
  },
  {
   "id": "s3",
   "scene": "simbolo",
   "text": "Virou um símbolo, e também o exemplo clássico de promessa otimista.",
   "start": 12.28,
   "end": 15.78
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Prazo prometido sem folga vira cobrança.",
   "start": 16.2,
   "end": 18.65
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Ao prometer prazo de documentação ou de financiamento, some uma folga e diga a data já com ela.",
   "start": 19.08,
   "end": 25.12
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem entrega antes do prometido ganha confiança.",
   "start": 25.32,
   "end": 28.03
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.36,
   "end": 32.75
  }
 ],
