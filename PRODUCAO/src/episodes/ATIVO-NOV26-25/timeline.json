 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O Brasil envelhece, mas muita apresentação de imóvel ainda parece feita para um único tipo de família.",
   "start": 0.12,
   "end": 5.33
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Em novembro, o mercado voltou a discutir empreendimentos pensados para pessoas idosas.",
   "start": 5.64,
   "end": 9.61
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "A questão vai além de ter elevador.",
   "start": 9.8,
   "end": 11.58
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Pode envolver acessibilidade, serviços próximos, autonomia e custos de operação.",
   "start": 11.8,
   "end": 16.46
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Imagine um comprador buscando independência para os próximos anos.",
   "start": 16.723,
   "end": 19.87
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Mostrar uma piscina bonita pode ser menos útil do que explicar distância de farmácia, acesso ao prédio e facilidade de manutenção.",
   "start": 20.04,
   "end": 26.82
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Para o corretor, a pergunta muda: como essa pessoa quer viver?",
   "start": 27.16,
   "end": 30.65
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "A partir daí, vale verificar as características reais do imóvel e das áreas comuns, sem estereótipos sobre idade.",
   "start": 30.92,
   "end": 36.65
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Personalize a visita.",
   "start": 37.0,
   "end": 38.24
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 38.52,
   "end": 42.73
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 42.92,
   "end": 45.97
  }
 ],
