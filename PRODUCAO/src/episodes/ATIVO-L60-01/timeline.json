 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Seu cliente mandou: ainda está disponível?",
   "start": 0.12,
   "end": 2.36
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Não responda só com um sim.",
   "start": 2.76,
   "end": 4.33
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Claro que você precisa confirmar a disponibilidade antes.",
   "start": 4.68,
   "end": 7.44
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Mas, se parar nessa resposta, a conversa não ganha contexto nem direção.",
   "start": 7.72,
   "end": 11.69
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Você pode responder: está disponível, sim.",
   "start": 11.96,
   "end": 13.83
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Quer que eu te envie a planta e os detalhes, ou prefere conhecer primeiro as condições da visita?",
   "start": 13.96,
   "end": 18.43
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O objetivo não é pressionar.",
   "start": 18.68,
   "end": 20.08
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "É oferecer um próximo passo útil e descobrir qual informação ajuda aquela pessoa a decidir.",
   "start": 20.28,
   "end": 25.27
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 25.64,
   "end": 30.13
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 30.448,
   "end": 33.18
  }
 ],
