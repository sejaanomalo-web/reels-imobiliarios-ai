 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se a sua casa perdesse valor como um carro?",
   "start": 0.12,
   "end": 2.89
  },
  {
   "id": "s2",
   "scene": "japao",
   "text": "No Japão, uma casa é demolida, em média, com uns trinta e dois anos. Nos Estados Unidos, com mais que o dobro.",
   "start": 3.24,
   "end": 9.65
  },
  {
   "id": "s3",
   "scene": "terreno",
   "text": "Na conta dos impostos de lá, uma casa de madeira se deprecia em vinte e dois anos. O que segura o valor é o terreno.",
   "start": 10.12,
   "end": 16.84
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Aqui é diferente. Mas a pergunta do comprador é a mesma: o que ainda vai valer daqui a dez anos?",
   "start": 17.24,
   "end": 22.55
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Mostre o que segura o preço: a localização, o terreno, a estrutura e a manutenção. Não só o acabamento novo.",
   "start": 22.84,
   "end": 29.49
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O acabamento envelhece. O endereço, não.",
   "start": 29.88,
   "end": 32.31
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.76,
   "end": 37.22
  }
 ],
