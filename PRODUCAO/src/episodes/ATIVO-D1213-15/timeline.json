 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Toda conversa com cliente deveria terminar com uma data.",
   "start": 0.12,
   "end": 3.28
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1997, pesquisadores pediram a estudantes um relatório para entregar depois do Natal.",
   "start": 3.48,
   "end": 9.11
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Quem anotou quando e onde ia escrever entregou mais que o dobro de quem não anotou.",
   "start": 9.48,
   "end": 14.66
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Depois a gente vê não é combinado.",
   "start": 15.08,
   "end": 17.07
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de encerrar, marque o próximo passo: o dia, a hora e o que vai acontecer.",
   "start": 17.48,
   "end": 23.04
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Próximo passo com data acontece. Sem data, esfria.",
   "start": 23.48,
   "end": 27.07
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.4,
   "end": 31.75
  }
 ],
