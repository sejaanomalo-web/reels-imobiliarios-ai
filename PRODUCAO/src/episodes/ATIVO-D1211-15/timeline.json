 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quantas mensagens de cliente você deixou para responder depois hoje?",
   "start": 0.12,
   "end": 4.12
  },
  {
   "id": "s2",
   "scene": "regra",
   "text": "Um consultor americano criou uma regra simples: se leva menos de dois minutos, faça agora.",
   "start": 4.52,
   "end": 10.06
  },
  {
   "id": "s3",
   "scene": "porque",
   "text": "Anotar para depois custa mais do que resolver.",
   "start": 10.36,
   "end": 12.8
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Confirmar a visita, mandar a localização, responder um ainda está disponível: tudo cabe em dois minutos.",
   "start": 13.24,
   "end": 19.69
  },
  {
   "id": "s5",
   "scene": "resto",
   "text": "O que passa de dois minutos vai para a agenda, com dia e hora.",
   "start": 20.04,
   "end": 23.74
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Lista curta, cliente respondido.",
   "start": 24.2,
   "end": 26.33
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.6,
   "end": 30.93
  }
 ],
