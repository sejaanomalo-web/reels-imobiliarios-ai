 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se todo anúncio de imóvel tivesse que mostrar quanto você vai gastar de luz?",
   "start": 0.12,
   "end": 4.53
  },
  {
   "id": "s2",
   "scene": "regra",
   "text": "Parece exagero, mas na França isso já é regra.",
   "start": 4.84,
   "end": 7.88
  },
  {
   "id": "s3",
   "scene": "regra",
   "text": "Desde 2022, o anúncio mostra o gasto anual estimado de energia, com letra do mesmo tamanho do resto.",
   "start": 8.2,
   "end": 14.13
  },
  {
   "id": "s4",
   "scene": "nota",
   "text": "E o imóvel ganha uma nota, de A a G.",
   "start": 14.36,
   "end": 17.34
  },
  {
   "id": "s5",
   "scene": "nota",
   "text": "Os piores precisam avisar no anúncio: consumo de energia excessivo.",
   "start": 17.64,
   "end": 21.65
  },
  {
   "id": "s6",
   "scene": "calendario",
   "text": "E tem mais. Desde 2025, imóvel nota G não pode entrar em contrato novo de aluguel.",
   "start": 22.12,
   "end": 27.42
  },
  {
   "id": "s7",
   "scene": "calendario",
   "text": "Em 2028, entra a nota F. E em 2034, a próxima da escala.",
   "start": 27.72,
   "end": 32.68
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Ou seja: lá, o custo de morar entrou na vitrine.",
   "start": 33.16,
   "end": 36.1
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Aqui, o comprador costuma descobrir a conta de luz, o condomínio e o IPTU depois que já se apaixonou.",
   "start": 36.44,
   "end": 42.16
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Ninguém te obriga a mostrar isso.",
   "start": 42.52,
   "end": 44.04
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Mas o corretor que mostra o custo de morar antes de o cliente perguntar ganha o que foto nenhuma dá: confiança.",
   "start": 44.28,
   "end": 50.83
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 51.24,
   "end": 55.87
  }
 ],
