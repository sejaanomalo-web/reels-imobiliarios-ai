 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Imóvel usado pode ser financiado com recursos do FGTS?",
   "start": 0.2,
   "end": 3.77
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Antes de responder, precisa saber de qual operação o cliente está falando.",
   "start": 4.04,
   "end": 7.47
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Uma atualização do orçamento habitacional reacendeu o tema dos imóveis usados.",
   "start": 7.8,
   "end": 11.89
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Só que limite de recursos, regras do programa e condições do comprador são três coisas diferentes.",
   "start": 12.12,
   "end": 17.68
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "O cliente pode ter saldo de FGTS e ainda precisar cumprir requisitos para utilizá-lo.",
   "start": 17.96,
   "end": 22.76
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Também há limites de valor, modalidade de financiamento e situação do imóvel que precisam ser conferidos.",
   "start": 22.76,
   "end": 28.24
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O melhor conteúdo não é uma promessa de que todo usado agora pode entrar.",
   "start": 28.52,
   "end": 32.37
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "É um roteiro de verificação: banco, regras atualizadas, enquadramento e documentação.",
   "start": 32.6,
   "end": 37.98
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Assim você orienta sem criar expectativa falsa.",
   "start": 38.2,
   "end": 40.77
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Na revenda, verifique antes de anunciar.",
   "start": 41.08,
   "end": 43.29
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 43.56,
   "end": 48.09
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 48.339,
   "end": 50.89
  }
 ],
