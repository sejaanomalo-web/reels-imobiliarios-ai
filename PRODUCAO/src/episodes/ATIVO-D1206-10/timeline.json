 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente quer ver dez imóveis no sábado.",
   "start": 0.12,
   "end": 2.65
  },
  {
   "id": "s2",
   "scene": "rota",
   "text": "Você monta a rota, roda o dia inteiro, e no fim ele não lembra qual tinha a varanda.",
   "start": 2.92,
   "end": 9.05
  },
  {
   "id": "s3",
   "scene": "mistura",
   "text": "Depois de alguns imóveis, as salas, os quartos e os preços começam a se misturar.",
   "start": 9.32,
   "end": 14.14
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Mais visitas não dão mais certeza. Dão mais confusão.",
   "start": 14.493,
   "end": 17.84
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Escolha três ou quatro, cada um com um motivo, e entregue uma ficha para ele anotar o que gostou e o que não gostou em cada um.",
   "start": 18.12,
   "end": 25.07
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "No fim do sábado, ele não precisa lembrar de tudo. Precisa conseguir escolher.",
   "start": 25.4,
   "end": 30.02
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 30.36,
   "end": 34.72
  }
 ],
