 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A ordem dos cômodos muda a lembrança que o cliente leva da visita.",
   "start": 0.2,
   "end": 4.11
  },
  {
   "id": "s2",
   "scene": "agua",
   "text": "Em 1993, pesquisadores pediram para as pessoas colocarem a mão em água gelada por um minuto.",
   "start": 4.52,
   "end": 10.41
  },
  {
   "id": "s3",
   "scene": "agua",
   "text": "Na outra vez, um minuto e meio, mas nos últimos trinta segundos a água esquentava um pouco.",
   "start": 10.68,
   "end": 15.89
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A mais longa foi lembrada como menos ruim. O final pesou mais do que a duração.",
   "start": 16.2,
   "end": 20.73
  },
  {
   "id": "s5",
   "scene": "visita",
   "text": "Na visita, o cliente leva para casa o último cômodo que viu.",
   "start": 21.16,
   "end": 24.62
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Termine no melhor ponto do imóvel, não na área de serviço.",
   "start": 25.0,
   "end": 28.17
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.36,
   "end": 32.86
  }
 ],
