 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quer que o cliente acredite no seu elogio? Comece pelo defeito.",
   "start": 0.12,
   "end": 3.87
  },
  {
   "id": "s2",
   "scene": "tudo",
   "text": "Se você diz que tudo é ótimo, nada é.",
   "start": 4.12,
   "end": 6.17
  },
  {
   "id": "s3",
   "scene": "tudo",
   "text": "O cliente desconfia e vai procurar o problema sozinho.",
   "start": 6.44,
   "end": 9.26
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Agora imagine: antes de ele perceber, você mesmo mostra. A cozinha é pequena. Mas olha a luz da sala.",
   "start": 9.64,
   "end": 16.07
  },
  {
   "id": "s5",
   "scene": "vira",
   "text": "O defeito dito por você vira informação. O mesmo defeito descoberto por ele vira desconfiança.",
   "start": 16.52,
   "end": 22.41
  },
  {
   "id": "s6",
   "scene": "vira",
   "text": "E às vezes o certo é dizer: esse imóvel não é pra você.",
   "start": 22.68,
   "end": 26.08
  },
  {
   "id": "s7",
   "scene": "desfecho",
   "text": "Quem fala o contra ganha o direito de ser acreditado no a favor.",
   "start": 26.36,
   "end": 30.11
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 30.44,
   "end": 34.38
  }
 ],
