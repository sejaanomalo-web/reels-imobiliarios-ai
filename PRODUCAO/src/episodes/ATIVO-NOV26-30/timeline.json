 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O corretor do futuro não é aquele que usa mais aplicativos.",
   "start": 0.12,
   "end": 4.04
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "É aquele que consegue dar continuidade ao atendimento sem perder o contexto.",
   "start": 4.04,
   "end": 7.96
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "No encontro do Secovi, o setor discutiu ferramentas digitais, gestão de leads e novas jornadas de compra.",
   "start": 8.28,
   "end": 14.59
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Mas digitalizar não é espalhar informação em cinco lugares diferentes.",
   "start": 15.0,
   "end": 19.16
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Pensa no processo: o lead chega, você entende o que procura, registra as opções apresentadas, combina o próximo passo e acompanha a decisão.",
   "start": 19.4,
   "end": 27.88
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Se uma dessas etapas some, a tecnologia não resolveu o problema.",
   "start": 28.28,
   "end": 31.96
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O diferencial não é ter um sistema cheio de funções.",
   "start": 32.28,
   "end": 34.98
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "É encontrar uma forma de trabalhar que faça sentido para você, com informações acessíveis quando precisar atender o cliente.",
   "start": 35.16,
   "end": 41.4
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Processo primeiro, ferramenta depois.",
   "start": 41.8,
   "end": 43.93
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.2,
   "end": 49.0
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.32,
   "end": 52.22
  }
 ],
