 "segments": [
  {
   "id": "s1",
   "scene": "gancho",
   "text": "Se você precisa mudar a sua forma de trabalhar para usar um sistema ou CRM… talvez o sistema esteja errado.",
   "start": 0.25,
   "end": 6.52
  },
  {
   "id": "s2",
   "scene": "gancho",
   "text": "O sistema é que deve acompanhar a sua rotina.",
   "start": 6.97,
   "end": 8.85
  },
  {
   "id": "s3",
   "scene": "rotina",
   "text": "Porque a rotina de um corretor não acontece em uma única tela.",
   "start": 9.29,
   "end": 12.35
  },
  {
   "id": "s4",
   "scene": "rotina",
   "text": "Tem cliente pedindo retorno.",
   "start": 12.73,
   "end": 13.86
  },
  {
   "id": "s5",
   "scene": "rotina",
   "text": "Visita para confirmar.",
   "start": 14.01,
   "end": 15.02
  },
  {
   "id": "s6",
   "scene": "rotina",
   "text": "Proprietário mudando informação do imóvel.",
   "start": 15.13,
   "end": 16.83
  },
  {
   "id": "s10",
   "scene": "dor",
   "text": "E muitas vezes o problema não é falta de cliente.",
   "start": 17.21,
   "end": 20.09
  },
  {
   "id": "s11",
   "scene": "dor",
   "text": "Nem falta de trabalho.",
   "start": 20.41,
   "end": 21.36
  },
  {
   "id": "s12",
   "scene": "dor",
   "text": "É não conseguir enxergar, com clareza, tudo o que já está acontecendo.",
   "start": 21.85,
   "end": 25.44
  },
  {
   "id": "s13",
   "scene": "dor",
   "text": "Porque quando informação fica espalhada, uma oportunidade pode simplesmente ficar para trás.",
   "start": 25.85,
   "end": 30.47
  },
  {
   "id": "s14",
   "scene": "virada",
   "text": "Foi pensando exatamente nessa rotina que criamos o Sistema ATIVO.",
   "start": 30.89,
   "end": 34.25
  },
  {
   "id": "s16",
   "scene": "valor",
   "text": "Você pode organizar sua carteira de imóveis.",
   "start": 34.65,
   "end": 36.57
  },
  {
   "id": "s17",
   "scene": "valor",
   "text": "Centralizar seus clientes e acompanhar cada negociação.",
   "start": 36.89,
   "end": 39.49
  },
  {
   "id": "s18",
   "scene": "valor",
   "text": "Receber e acompanhar os leads das suas campanhas.",
   "start": 39.77,
   "end": 42.1
  },
  {
   "id": "s19",
   "scene": "valor",
   "text": "E consultar informações, compromissos e próximos passos com ajuda do Assistente com IA.",
   "start": 42.33,
   "end": 46.69
  },
  {
   "id": "s20",
   "scene": "clareza",
   "text": "Na prática, você deixa de depender tanto da memória e passa a ter mais clareza sobre quem precisa de retorno, qual negociação precisa avançar e o que merece sua atenção agora.",
   "start": 47.13,
   "end": 56.0
  },
  {
   "id": "s21",
   "scene": "diferencial",
   "text": "Mas o principal diferencial está aqui:",
   "start": 56.41,
   "end": 58.33
  },
  {
   "id": "s22",
   "scene": "diferencial",
   "text": "a gente não começa te entregando um sistema pronto.",
   "start": 58.73,
   "end": 60.81
  },
  {
   "id": "s23",
   "scene": "diferencial",
   "text": "Primeiro, fazemos um diagnóstico para entender como você trabalha.",
   "start": 61.29,
   "end": 64.28
  },
  {
   "id": "s24",
   "scene": "diferencial",
   "text": "Como organiza seus imóveis.",
   "start": 64.57,
   "end": 65.94
  },
  {
   "id": "s27",
   "scene": "diferencial",
   "text": "E o que realmente faria diferença na sua rotina.",
   "start": 66.25,
   "end": 68.51
  },
  {
   "id": "s28",
   "scene": "personalizacao",
   "text": "A partir disso, entendemos o que faz sentido e apresentamos uma solução personalizada para a sua forma de trabalhar.",
   "start": 68.97,
   "end": 74.81
  },
  {
   "id": "s29",
   "scene": "cta",
   "text": "Se você quer entender como o Sistema ATIVO pode funcionar na sua rotina, o próximo passo é simples.",
   "start": 75.29,
   "end": 80.41
  },
  {
   "id": "s30",
   "scene": "cta",
   "text": "Escolha um horário para uma demonstração ou fale diretamente com nosso time pelo WhatsApp.",
   "start": 80.57,
   "end": 84.59
  }
 ],
