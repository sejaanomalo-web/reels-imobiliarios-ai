 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O lead não sumiu.",
   "start": 0.12,
   "end": 1.38
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O histórico é que sumiu.",
   "start": 1.56,
   "end": 2.78
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Um comprador pediu um apartamento de dois quartos.",
   "start": 3.24,
   "end": 5.72
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "Você enviou opções, conversou sobre a localização e deixou a conversa aberta.",
   "start": 5.72,
   "end": 9.94
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "A semana encheu de visitas.",
   "start": 10.28,
   "end": 11.99
  },
  {
   "id": "s6",
   "scene": "tensao",
   "text": "Quando apareceu o imóvel perfeito, você lembrava do apartamento, mas não do nome de quem procurava.",
   "start": 12.12,
   "end": 17.18
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Um contato útil precisa de três registros: o que procura, em que etapa está e qual é o próximo retorno.",
   "start": 17.88,
   "end": 24.58
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Sem isso, até uma boa oportunidade pode ficar esquecida.",
   "start": 25.0,
   "end": 28.31
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer acompanhar esse histórico em um sistema feito para sua rotina?",
   "start": 28.84,
   "end": 31.73
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Conheça nosso sistema imobiliário personalizado no link da bio e agende uma demonstração.",
   "start": 32.04,
   "end": 36.81
  }
 ],
