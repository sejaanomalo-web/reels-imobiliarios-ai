 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma janela mudou o tempo de internação de pacientes num hospital.",
   "start": 0.12,
   "end": 3.84
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1984, um pesquisador comparou pacientes operados em quartos iguais.",
   "start": 4.2,
   "end": 9.32
  },
  {
   "id": "s3",
   "scene": "diferenca",
   "text": "Metade via uma parede de tijolos. A outra metade via árvores.",
   "start": 9.56,
   "end": 13.41
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Quem via árvores teve alta, em média, quase um dia antes.",
   "start": 13.64,
   "end": 17.37
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na visita, não passe correndo pela janela. Pare, abra a cortina e deixe o cliente olhar.",
   "start": 17.72,
   "end": 23.91
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "A vista não aparece na planta. Mas mora com a pessoa todos os dias.",
   "start": 24.2,
   "end": 28.38
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.68,
   "end": 32.99
  }
 ],
