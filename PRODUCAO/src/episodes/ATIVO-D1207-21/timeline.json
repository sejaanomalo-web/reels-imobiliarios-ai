 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que a gente sempre promete começar na segunda-feira?",
   "start": 0.12,
   "end": 2.94
  },
  {
   "id": "s2",
   "scene": "dieta",
   "text": "Em 2014, pesquisadores americanos viram que as buscas por dieta sobem no começo da semana, do mês e do ano.",
   "start": 3.24,
   "end": 10.23
  },
  {
   "id": "s3",
   "scene": "academia",
   "text": "E as idas à academia aumentam depois de datas marcantes, como aniversários.",
   "start": 10.36,
   "end": 14.36
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Essas datas funcionam como um recomeço: o plano adiado ganha uma nova chance.",
   "start": 14.76,
   "end": 19.91
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Aquele lead que esfriou? Retome a conversa num marco: começo do mês, virada do ano, fim do aluguel.",
   "start": 20.2,
   "end": 26.7
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Às vezes o cliente não precisa de outro imóvel. Precisa de um novo começo.",
   "start": 27.08,
   "end": 31.0
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 31.32,
   "end": 35.62
  }
 ],
