 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Num experimento de 2003, a mesma pergunta teve quase o dobro de sim só por causa do que já vinha marcado.",
   "start": 0.12,
   "end": 6.5
  },
  {
   "id": "s2",
   "scene": "optin",
   "text": "Quem precisava marcar para ser doador de órgãos: quarenta e dois por cento aceitaram.",
   "start": 6.76,
   "end": 11.07
  },
  {
   "id": "s3",
   "scene": "optout",
   "text": "Quem já vinha marcado e só podia desmarcar: oitenta e dois por cento ficaram.",
   "start": 11.32,
   "end": 15.72
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "As pessoas tendem a aceitar o que já vem pronto.",
   "start": 16.12,
   "end": 18.19
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Mande ao proprietário o cadastro do imóvel já preenchido com o que você sabe, para ele só conferir e corrigir.",
   "start": 18.52,
   "end": 24.02
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Formulário em branco fica para depois. Formulário pronto volta.",
   "start": 24.28,
   "end": 27.9
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.28,
   "end": 32.51
  }
 ],
