 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma opção que ninguém escolheu mudou a escolha de quase todo mundo.",
   "start": 0.12,
   "end": 4.19
  },
  {
   "id": "s2",
   "scene": "teste",
   "text": "Num experimento com estudantes, uma revista oferecia: só digital por 59 dólares, ou impressa mais digital por 125.",
   "start": 4.36,
   "end": 12.76
  },
  {
   "id": "s3",
   "scene": "teste",
   "text": "A maioria ficou com a digital.",
   "start": 13.0,
   "end": 14.62
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Aí incluíram a impressa sozinha, também por 125. Ninguém escolheu ela. Mas 84% passaram a escolher a combinada.",
   "start": 15.08,
   "end": 23.99
  },
  {
   "id": "s5",
   "scene": "aplica",
   "text": "A comparação muda o valor que a gente enxerga. Por isso, mostre os imóveis em grupos que façam sentido lado a lado.",
   "start": 24.36,
   "end": 31.39
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Com uma referência honesta do lado, o cliente enxerga melhor o valor do imóvel certo.",
   "start": 31.72,
   "end": 36.48
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 36.76,
   "end": 41.16
  }
 ],
