 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente pediu para ver quinze imóveis no sábado.",
   "start": 0.2,
   "end": 3.2
  },
  {
   "id": "s2",
   "scene": "mistura",
   "text": "No décimo, ele já não lembra do terceiro. E começa a misturar a cozinha de um com a varanda do outro.",
   "start": 3.48,
   "end": 9.0
  },
  {
   "id": "s3",
   "scene": "erro",
   "text": "Mais visita não é mais escolha. É mais confusão.",
   "start": 9.249,
   "end": 12.64
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Antes, peça as três coisas de que ele não abre mão. E corte o que não passa.",
   "start": 13.08,
   "end": 17.48
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Leve três, quatro no máximo, e anote na saída o que ele achou de cada um.",
   "start": 17.88,
   "end": 22.22
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Menos portas abertas, mais decisão.",
   "start": 22.68,
   "end": 25.24
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.64,
   "end": 30.08
  }
 ],
