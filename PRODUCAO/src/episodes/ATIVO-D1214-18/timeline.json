 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1861, um hotel de seis andares subiu mais de um metro, com os hóspedes lá dentro.",
   "start": 0.12,
   "end": 6.39
  },
  {
   "id": "s2",
   "scene": "terreno",
   "text": "Chicago tinha sido construída num terreno plano e encharcado, e o esgoto não tinha para onde escoar.",
   "start": 6.76,
   "end": 11.78
  },
  {
   "id": "s3",
   "scene": "subir",
   "text": "A cidade decidiu subir o nível das ruas, e os prédios tiveram que subir junto, com centenas de macacos de rosca.",
   "start": 12.12,
   "end": 18.9
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O que está embaixo da rua muda o valor de tudo que está em cima.",
   "start": 19.32,
   "end": 23.3
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de mostrar um imóvel, descubra se a rua alaga: pergunte aos vizinhos e consulte a prefeitura.",
   "start": 23.8,
   "end": 29.3
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Endereço bom também é o que não alaga.",
   "start": 29.64,
   "end": 31.98
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.28,
   "end": 36.7
  }
 ],
