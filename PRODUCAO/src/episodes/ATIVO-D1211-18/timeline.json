 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1854, um homem subiu numa plataforma alta e mandou cortar a corda.",
   "start": 0.12,
   "end": 5.84
  },
  {
   "id": "s2",
   "scene": "quem",
   "text": "Era um inventor, mostrando o freio de segurança do elevador numa feira em Nova York.",
   "start": 6.2,
   "end": 11.21
  },
  {
   "id": "s3",
   "scene": "parou",
   "text": "A plataforma caiu poucos centímetros e parou. O público viu com os próprios olhos.",
   "start": 11.56,
   "end": 16.96
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ele não disse que era seguro. Ele mostrou.",
   "start": 17.24,
   "end": 19.9
  },
  {
   "id": "s5",
   "scene": "ponte",
   "text": "Quando o cliente desconfiar, não jure: mostre a matrícula, as certidões, o histórico.",
   "start": 20.44,
   "end": 25.96
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Prova convence mais do que promessa.",
   "start": 26.36,
   "end": 28.5
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.76,
   "end": 33.44
  }
 ],
