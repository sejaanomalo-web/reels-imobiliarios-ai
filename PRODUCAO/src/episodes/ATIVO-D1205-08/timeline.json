 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se você respondesse o lead em cinco minutos, enquanto ele ainda está olhando o anúncio?",
   "start": 0.12,
   "end": 4.7
  },
  {
   "id": "s2",
   "scene": "dado",
   "text": "Num levantamento com mais de 2 mil empresas americanas, quem respondeu levou em média 42 horas.",
   "start": 4.92,
   "end": 10.52
  },
  {
   "id": "s3",
   "scene": "dado",
   "text": "E quase um quarto nunca respondeu.",
   "start": 10.68,
   "end": 12.4
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Em 42 horas, a dúvida que fez ele clicar pode já ter passado.",
   "start": 12.68,
   "end": 16.51
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Deixe pronta a resposta das perguntas de sempre: ainda está disponível, aceita financiamento, tem vaga.",
   "start": 16.74,
   "end": 22.36
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Muito lead não esfria por desinteresse. Esfria esperando.",
   "start": 22.68,
   "end": 26.37
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.6,
   "end": 30.81
  }
 ],
