 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O projeto de Brasília foi entregue ao concurso com rabiscos a lápis de cor.",
   "start": 0.12,
   "end": 4.24
  },
  {
   "id": "s2",
   "scene": "entrega",
   "text": "Era 1957: poucos desenhos, um texto batido à máquina, e o autor ainda pediu desculpas pela apresentação simples.",
   "start": 4.52,
   "end": 12.38
  },
  {
   "id": "s3",
   "scene": "eixos",
   "text": "Mas a ideia cabia numa frase: dois eixos que se cruzam.",
   "start": 12.76,
   "end": 16.48
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Antes da lista de detalhes, vem uma ideia clara.",
   "start": 16.92,
   "end": 19.6
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de anunciar, escreva a frase do imóvel: para quem ele é e por quê.",
   "start": 19.88,
   "end": 24.48
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem entende a ideia lembra do imóvel.",
   "start": 24.84,
   "end": 26.94
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.4,
   "end": 31.77
  }
 ],
