 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "No Japão, os maquinistas apontam para o sinal e falam o que estão vendo, em voz alta.",
   "start": 0.12,
   "end": 5.34
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Parece exagero, mas num estudo de 1994 apontar e falar reduziu os erros em cerca de oitenta e cinco por cento.",
   "start": 5.64,
   "end": 13.25
  },
  {
   "id": "s3",
   "scene": "porque",
   "text": "O gesto obriga a atenção a parar em cada item.",
   "start": 13.56,
   "end": 16.25
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Conferência em silêncio deixa passar.",
   "start": 16.68,
   "end": 18.73
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na entrega das chaves e na conferência dos documentos, aponte cada item e fale em voz alta.",
   "start": 19.08,
   "end": 24.7
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O que é dito em voz alta não fica para trás.",
   "start": 25.0,
   "end": 27.74
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.04,
   "end": 32.1
  }
 ],
