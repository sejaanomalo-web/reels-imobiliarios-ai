 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O imóvel que você mostra às dez da manhã não é o mesmo das seis da tarde.",
   "start": 0.12,
   "end": 4.21
  },
  {
   "id": "s2",
   "scene": "manha",
   "text": "Às dez, a rua é calma e o sol entra na sala.",
   "start": 4.52,
   "end": 7.54
  },
  {
   "id": "s3",
   "scene": "tarde",
   "text": "Às seis, tem o trânsito da volta, a saída da escola e a vaga disputada.",
   "start": 7.88,
   "end": 12.48
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O cliente não vai morar no horário da visita. Vai morar no horário da rotina dele.",
   "start": 12.76,
   "end": 17.12
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Pergunte a que horas ele sai e volta, e marque uma das visitas nesse horário. Ou faça o trajeto com ele.",
   "start": 17.48,
   "end": 23.89
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem mostra a rotina antes evita a surpresa depois.",
   "start": 24.28,
   "end": 27.79
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.12,
   "end": 32.72
  }
 ],
