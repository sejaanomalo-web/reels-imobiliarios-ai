 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A casa desse anúncio existe.",
   "start": 0.2,
   "end": 2.41
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "As fotos são verdadeiras.",
   "start": 2.6,
   "end": 4.25
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "O aluguel é golpe.",
   "start": 4.36,
   "end": 5.48
  },
  {
   "id": "s4",
   "scene": "mec",
   "text": "Funciona assim: alguém copia as fotos de um imóvel anunciado de verdade, coloca um preço abaixo da região e publica nas redes.",
   "start": 6.04,
   "end": 12.62
  },
  {
   "id": "s5",
   "scene": "pressa",
   "text": "Quando você chama, vem a pressa: tem outra família de olho, paga o sinal no Pix e a data é sua.",
   "start": 12.92,
   "end": 18.25
  },
  {
   "id": "s6",
   "scene": "pressa",
   "text": "Sem contrato, sem videochamada.",
   "start": 18.6,
   "end": 20.34
  },
  {
   "id": "s7",
   "scene": "consequencia",
   "text": "E no verão, a família chega com as malas numa casa que tem dono.",
   "start": 20.68,
   "end": 24.24
  },
  {
   "id": "s8",
   "scene": "consequencia",
   "text": "E ele nunca alugou nada.",
   "start": 24.52,
   "end": 25.74
  },
  {
   "id": "s9",
   "scene": "creci",
   "text": "Nesta semana, o CRECI de Santa Catarina abriu a campanha de verão contra esse golpe, com fiscalização nas cidades turísticas.",
   "start": 26.12,
   "end": 32.63
  },
  {
   "id": "s10",
   "scene": "defesa",
   "text": "A defesa é conferir antes de pagar: o CRECI de quem anuncia, se o nome do anúncio bate com o da conta e o do dono, e o contrato antes de qualquer Pix.",
   "start": 32.92,
   "end": 42.21
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "O golpista consegue copiar a foto.",
   "start": 42.52,
   "end": 44.44
  },
  {
   "id": "s12",
   "scene": "desfecho",
   "text": "Não consegue copiar o que dá para conferir.",
   "start": 44.76,
   "end": 46.85
  },
  {
   "id": "s13",
   "scene": "desfecho",
   "text": "E neste verão, é isso que o cliente vai procurar no corretor.",
   "start": 47.16,
   "end": 49.98
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 50.28,
   "end": 54.45
  }
 ],
