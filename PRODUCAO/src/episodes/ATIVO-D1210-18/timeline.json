 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1805, Paris criou uma regra para numerar as casas. Ela vale até hoje.",
   "start": 0.12,
   "end": 5.36
  },
  {
   "id": "s2",
   "scene": "pares",
   "text": "Números pares de um lado da rua, ímpares do outro.",
   "start": 5.8,
   "end": 9.19
  },
  {
   "id": "s3",
   "scene": "rio",
   "text": "E a contagem começa pelo rio: quanto mais perto do Sena, menor o número.",
   "start": 9.4,
   "end": 13.62
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Uma regra simples fez a cidade inteira virar um mapa.",
   "start": 14.04,
   "end": 17.33
  },
  {
   "id": "s5",
   "scene": "ponte",
   "text": "Sua carteira precisa disso: cada imóvel cadastrado do mesmo jeito, com endereço, fotos e código.",
   "start": 17.8,
   "end": 24.03
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Imóvel que ninguém acha não vende.",
   "start": 24.36,
   "end": 26.31
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 26.68,
   "end": 31.3
  }
 ],
