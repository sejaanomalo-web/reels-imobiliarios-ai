 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Noventa por cento de chance de dar certo. Ou dez por cento de chance de dar errado. Qual parece melhor?",
   "start": 0.12,
   "end": 6.63
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1982, pesquisadores apresentaram o mesmo tratamento a médicos e pacientes, de dois jeitos.",
   "start": 6.92,
   "end": 12.66
  },
  {
   "id": "s3",
   "scene": "resultado",
   "text": "Quando ouviam a chance de sobreviver, mais gente escolhia a cirurgia do que quando ouviam a chance de morrer.",
   "start": 12.84,
   "end": 18.18
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O número era o mesmo. Mudou só o jeito de dizer.",
   "start": 18.44,
   "end": 20.92
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na proposta, mostre a informação pelo lado do que o cliente ganha. E deixe o resto à vista.",
   "start": 21.4,
   "end": 26.14
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O número informa. A frase decide.",
   "start": 26.52,
   "end": 28.94
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.24,
   "end": 33.58
  }
 ],
