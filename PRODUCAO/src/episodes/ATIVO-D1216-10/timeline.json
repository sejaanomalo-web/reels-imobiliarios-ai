 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente chegou na hora, e a portaria não deixou entrar.",
   "start": 0.12,
   "end": 3.47
  },
  {
   "id": "s2",
   "scene": "certo",
   "text": "Ninguém tinha avisado, e o porteiro estava certo.",
   "start": 3.8,
   "end": 6.26
  },
  {
   "id": "s3",
   "scene": "calcada",
   "text": "Dez minutos na calçada, e a visita já começou errada.",
   "start": 6.84,
   "end": 10.5
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A visita começa na portaria.",
   "start": 10.92,
   "end": 13.03
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Na véspera, avise a portaria com o nome do cliente, o horário e o apartamento.",
   "start": 13.4,
   "end": 18.82
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Cliente que entra sem esperar entra de bom humor.",
   "start": 19.24,
   "end": 22.27
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 22.6,
   "end": 27.32
  }
 ],
