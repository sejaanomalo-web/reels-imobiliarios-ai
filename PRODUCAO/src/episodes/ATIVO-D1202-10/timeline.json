 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o comprador do imóvel tivesse que pagar metade da comissão do corretor?",
   "start": 0.12,
   "end": 4.29
  },
  {
   "id": "s2",
   "scene": "lei",
   "text": "Na Alemanha, isso virou lei no fim de 2020.",
   "start": 4.6,
   "end": 7.49
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "Na venda de apartamento ou casa para morar, quando o corretor atende os dois lados, a comissão é dividida meio a meio.",
   "start": 7.8,
   "end": 14.0
  },
  {
   "id": "s4",
   "scene": "antes",
   "text": "Antes, em cidades como Berlim e Hamburgo, era o comprador que pagava tudo.",
   "start": 14.44,
   "end": 18.79
  },
  {
   "id": "s5",
   "scene": "antes",
   "text": "A lei veio para aliviar quem compra.",
   "start": 19.0,
   "end": 20.85
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "Só que um estudo de uma universidade de Berlim encontrou outra coisa: somando as duas metades, a comissão ficou maior.",
   "start": 21.08,
   "end": 28.11
  },
  {
   "id": "s7",
   "scene": "brasil",
   "text": "Ou seja, mudar quem paga não mudou o valor.",
   "start": 28.52,
   "end": 31.12
  },
  {
   "id": "s8",
   "scene": "brasil",
   "text": "No Brasil, quase sempre quem paga é o vendedor. Mas quem decide a compra é o comprador.",
   "start": 31.48,
   "end": 36.37
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Então trabalhe como se os dois pagassem: mostre ao comprador a pesquisa, os documentos e a negociação que ele recebe de você.",
   "start": 36.68,
   "end": 43.41
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 43.72,
   "end": 47.99
  }
 ],
