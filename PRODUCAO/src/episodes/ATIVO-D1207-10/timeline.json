 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente pede desconto antes de ver o imóvel.",
   "start": 0.12,
   "end": 2.6
  },
  {
   "id": "s2",
   "scene": "numero",
   "text": "Se você já responde com um número, ele aprende que o preço é a primeira coisa que cai.",
   "start": 2.92,
   "end": 7.3
  },
  {
   "id": "s3",
   "scene": "semvisita",
   "text": "E desconto sem visita é desconto num imóvel que ele talvez nem queira.",
   "start": 7.56,
   "end": 11.35
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Primeiro ele precisa querer o imóvel. Depois se fala de preço.",
   "start": 11.72,
   "end": 14.92
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Responda: vamos visitar; se for o imóvel certo, eu levo a sua proposta ao proprietário.",
   "start": 15.24,
   "end": 20.08
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Negociação boa começa com o cliente querendo o imóvel, não com o preço no chão.",
   "start": 20.52,
   "end": 25.07
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.48,
   "end": 29.92
  }
 ],
