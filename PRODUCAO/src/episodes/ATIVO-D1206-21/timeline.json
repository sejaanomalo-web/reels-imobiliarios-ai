 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um real por dia parece pouco. Trezentos e sessenta e cinco reais por ano parecem mais. É o mesmo dinheiro.",
   "start": 0.12,
   "end": 7.35
  },
  {
   "id": "s2",
   "scene": "estudo",
   "text": "Em 1998, um pesquisador de Harvard mostrou que o mesmo valor, dito por dia, costuma parecer menor.",
   "start": 7.8,
   "end": 15.06
  },
  {
   "id": "s3",
   "scene": "cafe",
   "text": "Porque a gente compara com os gastos pequenos do dia, como um café.",
   "start": 15.48,
   "end": 19.28
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Use isso para dar clareza, não para pressionar.",
   "start": 19.72,
   "end": 22.03
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "O apartamento perto do trabalho custa mais? Mostre quanto essa diferença dá por dia, ao lado das horas de trânsito que ele deixa de pegar.",
   "start": 22.44,
   "end": 29.58
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Número grande assusta. Número do dia a dia dá para comparar.",
   "start": 30.04,
   "end": 33.95
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 34.36,
   "end": 39.21
  }
 ],
