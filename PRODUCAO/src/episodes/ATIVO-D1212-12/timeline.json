 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 2016, o Japão ganhou a prata olímpica no revezamento sem ter os velocistas mais rápidos.",
   "start": 0.12,
   "end": 5.44
  },
  {
   "id": "s2",
   "scene": "passagem",
   "text": "A diferença estava na passagem do bastão, de baixo para cima, treinada durante anos.",
   "start": 5.64,
   "end": 10.36
  },
  {
   "id": "s3",
   "scene": "troca",
   "text": "Revezamento se perde na troca, não na reta.",
   "start": 10.36,
   "end": 12.59
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Com cliente é igual: ele se perde quando passa de uma mão para outra.",
   "start": 12.92,
   "end": 16.45
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Quando passar um cliente para um colega, passe junto o histórico: o que viu, o que recusou e o que pediu.",
   "start": 16.68,
   "end": 22.16
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Bastão bem passado não perde velocidade.",
   "start": 22.52,
   "end": 24.72
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 24.92,
   "end": 29.101
  }
 ],
