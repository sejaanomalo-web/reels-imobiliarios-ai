 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O letreiro mais famoso de Los Angeles começou como anúncio de imóvel.",
   "start": 0.12,
   "end": 3.84
  },
  {
   "id": "s2",
   "scene": "loteamento",
   "text": "Em 1923, um loteamento nas colinas de Hollywood pôs letras gigantes na encosta com o próprio nome. Era provisório.",
   "start": 4.04,
   "end": 10.98
  },
  {
   "id": "s3",
   "scene": "lugar",
   "text": "Ele não anunciava uma casa. Anunciava o lugar: as colinas, a vista, o jeito de morar.",
   "start": 11.24,
   "end": 17.24
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Em 1949, tiraram as quatro últimas letras, LAND. O anúncio virou o nome do bairro e, depois, o símbolo da cidade.",
   "start": 17.56,
   "end": 25.21
  },
  {
   "id": "s5",
   "scene": "licao",
   "text": "Quem compra um imóvel também compra a rua, a padaria, o caminho de volta para casa.",
   "start": 25.48,
   "end": 30.3
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "No seu anúncio, mostre o lugar, não só a planta.",
   "start": 30.68,
   "end": 33.67
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 33.96,
   "end": 38.48
  }
 ],
