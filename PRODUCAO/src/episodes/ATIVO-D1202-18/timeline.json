 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma mulher passou 36 anos reformando a mesma casa.",
   "start": 0.12,
   "end": 3.75
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Quando ela morreu, a casa foi avaliada como quase sem valor.",
   "start": 3.96,
   "end": 7.52
  },
  {
   "id": "s3",
   "scene": "inicio",
   "text": "Sarah Winchester comprou uma casa de fazenda de oito cômodos na Califórnia, em 1886.",
   "start": 7.8,
   "end": 14.15
  },
  {
   "id": "s4",
   "scene": "inicio",
   "text": "E nunca parou de reformar.",
   "start": 14.36,
   "end": 15.89
  },
  {
   "id": "s5",
   "scene": "obra",
   "text": "Sem arquiteto. Ela desenhava os cômodos em pedaços de papel, e os carpinteiros construíam.",
   "start": 16.28,
   "end": 21.49
  },
  {
   "id": "s6",
   "scene": "obra",
   "text": "O que não dava certo era fechado ou derrubado.",
   "start": 21.8,
   "end": 24.37
  },
  {
   "id": "s7",
   "scene": "estranho",
   "text": "No fim, eram 160 cômodos. Uma escada que termina no teto. Uma porta no segundo andar que abre para o vazio.",
   "start": 24.76,
   "end": 32.34
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Em 1922, os avaliadores olharam a obra inacabada e os estragos do terremoto.",
   "start": 32.76,
   "end": 38.21
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Para morar, ela quase não valia nada. Foi a leilão e virou atração turística.",
   "start": 38.495,
   "end": 43.25
  },
  {
   "id": "s10",
   "scene": "licao",
   "text": "Dinheiro na obra não vira valor sozinho. Comprador paga por casa que faz sentido.",
   "start": 43.72,
   "end": 49.05
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Quando o dono disser quanto gastou na reforma, pergunte o que ela resolveu.",
   "start": 49.32,
   "end": 53.35
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 53.72,
   "end": 58.21
  }
 ],
