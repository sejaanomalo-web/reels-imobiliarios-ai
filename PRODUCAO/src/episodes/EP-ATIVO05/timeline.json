 ],
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dois corretores combinam de trabalhar juntos um imóvel.",
   "start": 0.2,
   "end": 3.32
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Um traz o comprador, o outro conhece o proprietário.",
   "start": 3.32,
   "end": 5.88
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Parece simples, até chegar a primeira proposta e ninguém lembrar exatamente do que foi combinado.",
   "start": 6.2,
   "end": 11.49
  },
  {
   "id": "s4",
   "scene": "problema",
   "text": "Quem apresenta o imóvel?",
   "start": 11.96,
   "end": 13.22
  },
  {
   "id": "s5",
   "scene": "problema",
   "text": "Quem conduz a negociação?",
   "start": 13.56,
   "end": 15.06
  },
  {
   "id": "s6",
   "scene": "problema",
   "text": "Quem atualiza o proprietário?",
   "start": 15.48,
   "end": 17.1
  },
  {
   "id": "s7",
   "scene": "problema",
   "text": "Como será tratada a participação de cada profissional?",
   "start": 17.48,
   "end": 20.06
  },
  {
   "id": "s8",
   "scene": "problema",
   "text": "Quando essas perguntas ficam para depois, até uma parceria bem-intencionada pode terminar em conflito.",
   "start": 20.52,
   "end": 26.02
  },
  {
   "id": "s9",
   "scene": "mudanca",
   "text": "Em vez de começar pela divisão da comissão, comece definindo o processo.",
   "start": 26.36,
   "end": 30.63
  },
  {
   "id": "s10",
   "scene": "mudanca",
   "text": "Confirme a autorização para divulgar ou negociar aquele imóvel.",
   "start": 31.08,
   "end": 34.3
  },
  {
   "id": "s11",
   "scene": "mudanca",
   "text": "Alinhe as responsabilidades e registre por escrito o que foi acordado, respeitando as regras profissionais aplicáveis.",
   "start": 34.6,
   "end": 41.03
  },
  {
   "id": "s12",
   "scene": "execucao",
   "text": "Durante o atendimento, mantenha uma fonte de informação atualizada: status do imóvel, visitas agendadas, retorno do interessado e próximo movimento.",
   "start": 41.48,
   "end": 50.59
  },
  {
   "id": "s13",
   "scene": "execucao",
   "text": "Se surgir uma mudança, os dois precisam saber antes de falar com o cliente.",
   "start": 51.0,
   "end": 54.9
  },
  {
   "id": "s14",
   "scene": "insight",
   "text": "Parceria forte não é aquela em que todo mundo promete muito.",
   "start": 55.56,
   "end": 58.59
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "É aquela em que cada pessoa sabe o que precisa fazer, o que pode comunicar e como prestar contas.",
   "start": 58.92,
   "end": 64.45
  },
  {
   "id": "s16",
   "scene": "insight",
   "text": "Colaboração e profissionalismo combinam.",
   "start": 64.84,
   "end": 67.07
  },
  {
   "id": "s17",
   "scene": "insight",
   "text": "Essa clareza fica mais fácil quando o status de cada imóvel e de cada atendimento está registrado.",
   "start": 67.4,
   "end": 72.16
  },
  {
   "id": "s18",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 72.6,
   "end": 77.03
  },
  {
   "id": "s19",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 77.48,
   "end": 80.13
  }
 ],
