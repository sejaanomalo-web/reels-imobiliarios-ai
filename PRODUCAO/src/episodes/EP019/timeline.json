 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você mandou um áudio de três minutos.",
   "start": 0.2,
   "end": 2.28
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O cliente ouviu metade e ficou sem saber o próximo passo.",
   "start": 2.28,
   "end": 5.35
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Áudio é ótimo para transmitir proximidade, mas detalhes como endereço, horário e documentação ficam difíceis de consultar depois.",
   "start": 5.8,
   "end": 12.87
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "Depois de um áudio importante, envie um resumo curto: imóvel, combinado e próximo passo.",
   "start": 13.08,
   "end": 17.79
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Duas ou três linhas podem resolver.",
   "start": 18.12,
   "end": 19.78
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "E registre a mesma informação no acompanhamento do cliente.",
   "start": 20.12,
   "end": 22.8
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Assim, você não depende de alguém lembrar exatamente o que ouviu.",
   "start": 23.0,
   "end": 26.0
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Se a sua rotina tem muitos atendimentos assim, vale ter esse histórico organizado.",
   "start": 26.2,
   "end": 30.02
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 30.28,
   "end": 34.61
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 34.798,
   "end": 37.29
  }
 ],
