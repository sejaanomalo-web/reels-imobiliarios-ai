 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Cascavel entregou cento e vinte e três casas populares em novembro.",
   "start": 0.2,
   "end": 3.9
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas o número mais interessante está no que vem depois.",
   "start": 4.28,
   "end": 7.41
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Segundo a prefeitura, há mais de quatro mil moradias em obras ou em fases de projeto e protocolo.",
   "start": 7.64,
   "end": 12.92
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Isso mostra uma movimentação habitacional importante na cidade, com diferentes etapas e finalidades.",
   "start": 13.24,
   "end": 18.5
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Agora pensa no corretor que anuncia crescimento urbano só porque viu uma lista de casas.",
   "start": 18.84,
   "end": 23.98
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "O efeito real depende de infraestrutura, bairros, mobilidade e como os projetos serão implementados.",
   "start": 24.2,
   "end": 30.74
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Para quem atua em Cascavel, acompanhar planejamento e fontes oficiais ajuda a entender a cidade.",
   "start": 31.0,
   "end": 36.31
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Sem transformar habitação social em estoque disponível para venda, e sem prometer valorização.",
   "start": 36.6,
   "end": 41.79
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Leia a cidade, não só o anúncio.",
   "start": 42.04,
   "end": 43.9
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.2,
   "end": 48.85
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.139,
   "end": 51.88
  }
 ],
