 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quer fazer sua carteira imobiliária virar um quebra-cabeça?",
   "start": 0.12,
   "end": 2.99
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "É simples.",
   "start": 3.32,
   "end": 4.04
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Siga este manual.",
   "start": 4.04,
   "end": 4.99
  },
  {
   "id": "s4",
   "scene": "um",
   "text": "Guarde as fotos dos imóveis misturadas às fotos pessoais.",
   "start": 5.56,
   "end": 8.73
  },
  {
   "id": "s5",
   "scene": "um",
   "text": "Deixe a metragem em um PDF antigo.",
   "start": 9.0,
   "end": 11.05
  },
  {
   "id": "s6",
   "scene": "um",
   "text": "E anote o valor numa conversa que você nunca mais encontra.",
   "start": 11.24,
   "end": 14.45
  },
  {
   "id": "s7",
   "scene": "um",
   "text": "Pronto: a cada novo interessado, começa uma investigação.",
   "start": 14.92,
   "end": 18.47
  },
  {
   "id": "s8",
   "scene": "dois",
   "text": "Agora faça o mesmo com os leads.",
   "start": 19.0,
   "end": 20.74
  },
  {
   "id": "s9",
   "scene": "dois",
   "text": "Uma parte no WhatsApp, outra no bloco de notas, outra só na cabeça.",
   "start": 21.0,
   "end": 24.77
  },
  {
   "id": "s10",
   "scene": "dois",
   "text": "E quando a visita mudar de horário, não atualize ninguém.",
   "start": 24.92,
   "end": 27.63
  },
  {
   "id": "s11",
   "scene": "dois",
   "text": "O caos fica completo.",
   "start": 27.8,
   "end": 29.01
  },
  {
   "id": "s12",
   "scene": "virada",
   "text": "Brincadeira à parte: isso acontece porque cada informação nasce num lugar diferente.",
   "start": 29.8,
   "end": 34.03
  },
  {
   "id": "s13",
   "scene": "virada",
   "text": "O primeiro passo não é comprar uma ferramenta enorme.",
   "start": 34.2,
   "end": 36.66
  },
  {
   "id": "s14",
   "scene": "virada",
   "text": "É decidir onde cada dado entra, quem atualiza e como você encontra depois.",
   "start": 36.92,
   "end": 41.48
  },
  {
   "id": "s15",
   "scene": "virada",
   "text": "Se você reconheceu pelo menos um desses hábitos, comece revisando onde cada informação entra.",
   "start": 41.8,
   "end": 46.42
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 46.84,
   "end": 51.43
  },
  {
   "id": "s17",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 51.779,
   "end": 54.41
  }
 ],
