 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Escritura marcada, todo mundo no cartório, e a certidão do imóvel venceu ontem.",
   "start": 0.12,
   "end": 5.95
  },
  {
   "id": "s2",
   "scene": "fila",
   "text": "A assinatura volta para a fila, e o cliente volta para casa sem o imóvel.",
   "start": 6.84,
   "end": 10.81
  },
  {
   "id": "s3",
   "scene": "prazo",
   "text": "Para a escritura, a certidão do registro de imóveis vale trinta dias, e as outras têm prazos diferentes.",
   "start": 11.24,
   "end": 16.94
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "As certidões não vencem juntas.",
   "start": 17.32,
   "end": 19.65
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Anote a data de emissão de cada uma e peça as de prazo curto por último.",
   "start": 19.96,
   "end": 24.02
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Documento em dia é escritura no dia.",
   "start": 24.36,
   "end": 26.82
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 27.16,
   "end": 31.46
  }
 ],
