 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente pediu informações uma vez.",
   "start": 0.12,
   "end": 1.93
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Recebeu resposta de dois corretores diferentes.",
   "start": 2.12,
   "end": 4.4
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Um oferece visita na quinta.",
   "start": 4.92,
   "end": 6.55
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "Outro fala de condições diferentes na sexta.",
   "start": 6.84,
   "end": 9.08
  },
  {
   "id": "s5",
   "scene": "situacao",
   "text": "O comprador não sabe com quem seguir e a equipe também não.",
   "start": 9.56,
   "end": 12.99
  },
  {
   "id": "s6",
   "scene": "tensao",
   "text": "O problema não é ter dois profissionais interessados.",
   "start": 13.88,
   "end": 16.65
  },
  {
   "id": "s7",
   "scene": "tensao",
   "text": "É não existir uma regra clara de atribuição e acompanhamento daquela oportunidade.",
   "start": 16.92,
   "end": 21.24
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Defina quem assume o primeiro contato, quando uma oportunidade pode ser transferida e como registrar isso sem perder contexto.",
   "start": 21.88,
   "end": 29.19
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Esse fluxo funciona melhor quando cada oportunidade tem dono e histórico registrados.",
   "start": 29.72,
   "end": 34.64
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 35.16,
   "end": 39.88
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 40.2,
   "end": 43.07
  }
 ],
