 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E aquele cliente que manda:",
   "start": 0.3,
   "end": 1.66
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Me manda as fotos e a metragem daquele apartamento?",
   "start": 1.66,
   "end": 4.02
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "E você:",
   "start": 4.22,
   "end": 4.69
  },
  {
   "id": "s4",
   "scene": "hook",
   "text": "Claro! Só um minutinho...",
   "start": 4.86,
   "end": 6.02
  },
  {
   "id": "s5",
   "scene": "problema",
   "text": "Só que esse minutinho vira uma busca.",
   "start": 6.22,
   "end": 7.93
  },
  {
   "id": "s6",
   "scene": "problema",
   "text": "A foto está na galeria, a metragem naquele PDF da construtora e o valor... em alguma conversa do WhatsApp.",
   "start": 8.22,
   "end": 14.37
  },
  {
   "id": "s7",
   "scene": "percepcao",
   "text": "Enquanto o cliente espera, você está tentando juntar informações de um imóvel que já faz parte da sua carteira.",
   "start": 14.7,
   "end": 19.43
  },
  {
   "id": "s8",
   "scene": "percepcao",
   "text": "E se tudo isso estivesse organizado em um único lugar?",
   "start": 19.82,
   "end": 22.8
  },
  {
   "id": "s9",
   "scene": "ativo",
   "text": "Com a ATIVO, você pode ter seus imóveis cadastrados, com fotos, valores e informações organizadas.",
   "start": 23.18,
   "end": 28.38
  },
  {
   "id": "s10",
   "scene": "ativo",
   "text": "E ainda apresentar tudo em um site próprio, sem precisar procurar cada detalhe pelo celular.",
   "start": 28.38,
   "end": 32.86
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Clique no botão e conheça como a ATIVO pode funcionar para você.",
   "start": 33.1,
   "end": 36.16
  }
 ],
