 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o preço de venda de cada casa da sua cidade fosse público?",
   "start": 0.12,
   "end": 4.15
  },
  {
   "id": "s2",
   "scene": "inglaterra",
   "text": "Na Inglaterra, o governo publica de graça o valor das vendas de casas registradas desde 1995.",
   "start": 4.44,
   "end": 11.08
  },
  {
   "id": "s3",
   "scene": "sp",
   "text": "Aqui, a cidade de São Paulo já publica todo mês o valor das transações em que o ITBI foi pago.",
   "start": 11.56,
   "end": 17.2
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O anúncio mostra o que o dono quer. A transação mostra o que alguém pagou.",
   "start": 17.64,
   "end": 22.57
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Compare com vendas reais da rua. E guarde, de cada negócio seu, o valor pedido e o valor fechado.",
   "start": 22.833,
   "end": 29.55
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem argumenta com venda real não discute opinião.",
   "start": 29.8,
   "end": 32.93
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 33.32,
   "end": 37.73
  }
 ],
