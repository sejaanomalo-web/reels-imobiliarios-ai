 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Às vezes a melhor parte da visita é quando você sai da sala.",
   "start": 0.2,
   "end": 4.15
  },
  {
   "id": "s2",
   "scene": "falando",
   "text": "Com você falando, o cliente escuta. Ele visita o imóvel como visitante.",
   "start": 4.44,
   "end": 8.28
  },
  {
   "id": "s3",
   "scene": "sozinho",
   "text": "Sozinho, ele começa a mudar os móveis de lugar na cabeça.",
   "start": 8.68,
   "end": 11.98
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "É aí que ele deixa de olhar um imóvel e começa a imaginar a casa dele.",
   "start": 12.28,
   "end": 16.33
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "No fim da visita, ofereça: fiquem uns minutos à vontade; eu espero lá fora.",
   "start": 16.6,
   "end": 20.97
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O silêncio também apresenta o imóvel.",
   "start": 21.4,
   "end": 23.74
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 24.04,
   "end": 28.72
  }
 ],
