 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "As plataformas de streaming não mostram só um filme. Mostram o motivo: porque você assistiu tal série.",
   "start": 0.12,
   "end": 6.59
  },
  {
   "id": "s2",
   "scene": "dado",
   "text": "Num artigo de 2015, engenheiros de uma das maiores contaram que cerca de 80% do que se assiste lá vem das recomendações.",
   "start": 7.0,
   "end": 15.22
  },
  {
   "id": "s3",
   "scene": "virada",
   "text": "Agora olhe a sua lista de imóveis para o cliente. Dez links, nenhum motivo.",
   "start": 15.72,
   "end": 20.65
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ele abre, não entende por que aquele está ali, e descarta.",
   "start": 21.08,
   "end": 24.68
  },
  {
   "id": "s5",
   "scene": "linha",
   "text": "Escreva uma linha em cada um: separei este porque você disse que precisa de dois quartos perto da escola.",
   "start": 25.24,
   "end": 31.58
  },
  {
   "id": "s6",
   "scene": "linha",
   "text": "A linha mostra que você ouviu. E transforma a lista em recomendação.",
   "start": 32.04,
   "end": 36.66
  },
  {
   "id": "s7",
   "scene": "desfecho",
   "text": "Imóvel com motivo é visto. Imóvel sem motivo é só mais um link.",
   "start": 37.32,
   "end": 41.92
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 42.36,
   "end": 47.38
  }
 ],
