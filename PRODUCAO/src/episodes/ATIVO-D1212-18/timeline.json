 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma família pediu uma casa com vista para a cachoeira. O arquiteto construiu a casa em cima dela.",
   "start": 0.2,
   "end": 6.32
  },
  {
   "id": "s2",
   "scene": "quando",
   "text": "Foi em 1935, nos Estados Unidos. Conta-se que o dono não gostou de início.",
   "start": 6.68,
   "end": 11.98
  },
  {
   "id": "s3",
   "scene": "porque",
   "text": "O arquiteto queria que eles vivessem com a cachoeira, e não só olhassem para ela.",
   "start": 12.2,
   "end": 16.27
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O pedido era a vista. O desejo era a cachoeira.",
   "start": 16.68,
   "end": 19.94
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Quando o cliente pedir três quartos, pergunte para quê: filhos, escritório ou visitas?",
   "start": 20.44,
   "end": 25.41
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem entende o desejo encontra o imóvel que o pedido não descreve.",
   "start": 25.64,
   "end": 29.52
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 29.88,
   "end": 34.39
  }
 ],
