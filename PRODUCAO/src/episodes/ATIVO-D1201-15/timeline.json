 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O proprietário quis acompanhar a visita.",
   "start": 0.2,
   "end": 3.26
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Em cinco minutos, ele já tinha contado do vizinho barulhento.",
   "start": 3.56,
   "end": 6.66
  },
  {
   "id": "s3",
   "scene": "conta",
   "text": "E ainda falou quanto pagou, por que está vendendo e que aceita negociar.",
   "start": 6.92,
   "end": 11.45
  },
  {
   "id": "s4",
   "scene": "memoria",
   "text": "Não por mal. É a casa dele.",
   "start": 11.96,
   "end": 13.77
  },
  {
   "id": "s5",
   "scene": "memoria",
   "text": "Ele conhece cada defeito e cada lembrança.",
   "start": 13.96,
   "end": 16.59
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "O problema é que, na visita, cada frase dele vira argumento de negociação para o comprador.",
   "start": 17.0,
   "end": 22.33
  },
  {
   "id": "s7",
   "scene": "papel",
   "text": "Então combine antes: ele recebe, se apresenta, mostra o que só ele sabe, como a reforma do banheiro, e depois dá espaço.",
   "start": 22.84,
   "end": 31.53
  },
  {
   "id": "s8",
   "scene": "papel",
   "text": "Preço, motivo da venda e prazo, quem responde é você.",
   "start": 32.04,
   "end": 36.2
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Dono presente na visita não é problema.",
   "start": 36.68,
   "end": 38.93
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Dono sem papel combinado é.",
   "start": 39.16,
   "end": 40.97
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 41.32,
   "end": 46.12
  }
 ],
