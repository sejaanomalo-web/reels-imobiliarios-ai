 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Ela construiu uma audiência enorme mostrando imóveis.",
   "start": 0.12,
   "end": 3.5
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas o detalhe mais inteligente não está nas casas.",
   "start": 3.72,
   "end": 6.47
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Está no jeito de chamar atenção.",
   "start": 6.6,
   "end": 8.02
  },
  {
   "id": "s4",
   "scene": "contraste",
   "text": "Kelsie Blevins atua no mercado imobiliário da Carolina do Norte, nos Estados Unidos.",
   "start": 8.323,
   "end": 12.52
  },
  {
   "id": "s5",
   "scene": "contraste",
   "text": "Em vez de usar o perfil só como catálogo de anúncios, ela publica conteúdos que ajudam as pessoas a entender o processo de compra e venda.",
   "start": 12.76,
   "end": 19.76
  },
  {
   "id": "s6",
   "scene": "contraste",
   "text": "Isso faz o público ter motivos para acompanhar o trabalho dela mesmo antes de procurar um imóvel.",
   "start": 20.2,
   "end": 24.89
  },
  {
   "id": "s7",
   "scene": "logica",
   "text": "Repara na lógica: primeiro, responde uma dúvida real.",
   "start": 25.16,
   "end": 28.24
  },
  {
   "id": "s8",
   "scene": "logica",
   "text": "Depois, mostra como trabalha e o que observa em cada imóvel.",
   "start": 28.6,
   "end": 32.08
  },
  {
   "id": "s9",
   "scene": "logica",
   "text": "Só então convida a pessoa para conversar.",
   "start": 32.36,
   "end": 34.55
  },
  {
   "id": "s10",
   "scene": "logica",
   "text": "O vídeo deixa de ser uma vitrine qualquer e começa a construir confiança.",
   "start": 34.76,
   "end": 38.16
  },
  {
   "id": "s11",
   "scene": "licao",
   "text": "O ponto não é copiar o jeito dela de gravar, nem perseguir milhões de views.",
   "start": 38.52,
   "end": 42.29
  },
  {
   "id": "s12",
   "scene": "licao",
   "text": "É fazer cada vídeo responder: por que alguém que procura um imóvel deveria continuar assistindo?",
   "start": 42.52,
   "end": 47.69
  },
  {
   "id": "s13",
   "scene": "licao",
   "text": "Se essa resposta não está clara, uma fachada bonita não segura a atenção.",
   "start": 47.96,
   "end": 51.6
  },
  {
   "id": "s14",
   "scene": "aplicacao",
   "text": "Na sua próxima gravação, escolha uma dúvida real do comprador antes de escolher a primeira imagem.",
   "start": 51.88,
   "end": 56.91
  },
  {
   "id": "s15",
   "scene": "aplicacao",
   "text": "E quando a dúvida virar conversa, cada contato precisa estar organizado.",
   "start": 57.16,
   "end": 61.2
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 61.48,
   "end": 65.75
  },
  {
   "id": "s17",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 66.099,
   "end": 68.75
  }
 ],
