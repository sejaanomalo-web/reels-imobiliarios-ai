 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Visita boa, cliente animado. Dois dias depois, sumiu.",
   "start": 0.2,
   "end": 4.59
  },
  {
   "id": "s2",
   "scene": "mensagem",
   "text": "Você manda: e aí, o que achou? Ele visualiza e não responde.",
   "start": 4.92,
   "end": 9.14
  },
  {
   "id": "s3",
   "scene": "virada",
   "text": "Pergunta aberta dá trabalho para quem já está cansado de decidir.",
   "start": 9.56,
   "end": 13.07
  },
  {
   "id": "s4",
   "scene": "resumo",
   "text": "No mesmo dia da visita, mande um resumo curto: o que ele gostou, o que não gostou e o que falta saber.",
   "start": 13.4,
   "end": 19.47
  },
  {
   "id": "s5",
   "scene": "pergunta",
   "text": "E termine com uma pergunta fácil: quer ver mais um parecido, ou esse continua no páreo?",
   "start": 19.8,
   "end": 24.88
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O resumo mostra que você ouviu. E a pergunta de sim ou não cabe numa resposta rápida.",
   "start": 25.32,
   "end": 30.38
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 30.68,
   "end": 35.13
  }
 ],
