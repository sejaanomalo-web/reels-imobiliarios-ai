 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o vendedor desistir da venda depois de receber o sinal?",
   "start": 0.45,
   "end": 4.52
  },
  {
   "id": "s2",
   "scene": "recebeu",
   "text": "O Código Civil já responde: quem recebeu e não cumpre devolve o sinal e mais o equivalente.",
   "start": 4.93,
   "end": 10.81
  },
  {
   "id": "s3",
   "scene": "pagou",
   "text": "E se quem pagou desiste, perde o sinal.",
   "start": 11.01,
   "end": 13.59
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Se o contrato prevê o direito de se arrepender, o sinal vira só o preço da desistência.",
   "start": 13.97,
   "end": 19.01
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de receber qualquer sinal, deixe escrito: o valor, para que ele serve e se existe arrependimento.",
   "start": 19.49,
   "end": 26.39
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Sinal sem papel vira briga. Sinal escrito vira compromisso.",
   "start": 26.85,
   "end": 30.78
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 31.09,
   "end": 35.71
  }
 ],
