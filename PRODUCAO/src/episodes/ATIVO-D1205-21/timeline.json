 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O imóvel que o cliente recusou ensina mais do que o que ele gostou.",
   "start": 0.12,
   "end": 4.23
  },
  {
   "id": "s2",
   "scene": "motivos",
   "text": "Cada não tem um motivo: escada demais, sol da tarde, rua barulhenta.",
   "start": 4.6,
   "end": 8.76
  },
  {
   "id": "s3",
   "scene": "motivos",
   "text": "Só que esse motivo some no meio das mensagens.",
   "start": 9.08,
   "end": 11.64
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Anote o não, com o motivo, logo depois da visita.",
   "start": 11.96,
   "end": 15.35
  },
  {
   "id": "s5",
   "scene": "filtro",
   "text": "Depois de três visitas, os motivos se repetem e viram o filtro que o cliente nunca soube explicar.",
   "start": 15.88,
   "end": 21.42
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem anota o não chega mais perto do sim.",
   "start": 21.72,
   "end": 24.44
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 24.76,
   "end": 29.15
  }
 ],
