 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A Torre Eiffel foi feita para durar vinte anos.",
   "start": 0.12,
   "end": 2.83
  },
  {
   "id": "s2",
   "scene": "licenca",
   "text": "Construída para a exposição de 1889, ela tinha autorização só até 1909. Depois, podia ser desmontada.",
   "start": 3.08,
   "end": 11.1
  },
  {
   "id": "s3",
   "scene": "feia",
   "text": "Muita gente achava a torre feia e inútil.",
   "start": 11.64,
   "end": 14.9
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ela foi salva quando ganhou um novo uso: virou antena de rádio.",
   "start": 15.32,
   "end": 19.38
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Com imóvel é parecido: mostre os usos que o cliente ainda não viu. O quarto extra vira escritório, a edícula vira renda.",
   "start": 19.72,
   "end": 27.34
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Às vezes o imóvel não precisa de reforma. Precisa de um novo uso.",
   "start": 27.72,
   "end": 31.94
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.36,
   "end": 37.28
  }
 ],
