 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se você tivesse que contar ao comprador que alguém morreu no imóvel?",
   "start": 0.12,
   "end": 4.63
  },
  {
   "id": "s2",
   "scene": "lei",
   "text": "Na Califórnia, uma morte nos últimos três anos pode ter que ser informada.",
   "start": 5.0,
   "end": 9.2
  },
  {
   "id": "s3",
   "scene": "pergunta",
   "text": "E, se o comprador perguntar diretamente, ninguém pode mentir, nem sobre o que aconteceu antes disso.",
   "start": 9.64,
   "end": 15.07
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "O que o comprador pergunta merece resposta verdadeira.",
   "start": 15.32,
   "end": 18.37
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de anunciar, pergunte ao proprietário: tem algo que um comprador gostaria de saber?",
   "start": 18.76,
   "end": 23.17
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem descobre depois não volta a confiar.",
   "start": 23.4,
   "end": 25.52
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 25.8,
   "end": 30.02
  }
 ],
