 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O lead manda só isso: qual o valor?",
   "start": 0.12,
   "end": 2.52
  },
  {
   "id": "s2",
   "scene": "some",
   "text": "Você responde o preço. Ele visualiza. E some.",
   "start": 2.92,
   "end": 5.99
  },
  {
   "id": "s3",
   "scene": "compara",
   "text": "Preço sozinho vira comparação com o anúncio mais barato do bairro.",
   "start": 6.44,
   "end": 9.72
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A resposta que segura a conversa tem o preço e uma pergunta.",
   "start": 10.2,
   "end": 14.03
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Diga o valor e pergunte: é para morar ou para investir? Quantos quartos você precisa?",
   "start": 14.36,
   "end": 19.72
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Quem só responde encerra. Quem pergunta atende.",
   "start": 20.12,
   "end": 23.35
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 24.12,
   "end": 28.34
  }
 ],
