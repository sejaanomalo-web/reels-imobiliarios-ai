 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente diz que está só olhando.",
   "start": 0.12,
   "end": 2.33
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E você já coloca ele na pasta dos curiosos.",
   "start": 2.6,
   "end": 5.17
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Mas pense: ele pode estar pesquisando bairros, simulando financiamento ou esperando vender outro imóvel.",
   "start": 5.56,
   "end": 12.01
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "A frase não explica o momento de compra.",
   "start": 12.44,
   "end": 14.79
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Se você manda dez anúncios sem perguntar nada, a conversa continua vaga e o cliente continua desconhecido.",
   "start": 15.24,
   "end": 21.87
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Troque o julgamento por uma pergunta:",
   "start": 22.36,
   "end": 24.63
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "o que precisa acontecer para você decidir?",
   "start": 24.92,
   "end": 27.34
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Registre a resposta e combine quando voltar a conversar.",
   "start": 27.88,
   "end": 31.5
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Se você quer organizar essas etapas sem depender da memória,",
   "start": 31.96,
   "end": 35.26
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "conheça nosso sistema imobiliário personalizado pelo link da bio.",
   "start": 35.48,
   "end": 39.15
  }
 ],
