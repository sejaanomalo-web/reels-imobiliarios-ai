 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Num hotel, mudaram uma frase no cartão da toalha. E mais hóspedes reutilizaram.",
   "start": 0.2,
   "end": 5.34
  },
  {
   "id": "s2",
   "scene": "teste",
   "text": "O cartão comum pedia ajuda ao meio ambiente. Cerca de 35% reutilizavam.",
   "start": 5.8,
   "end": 10.73
  },
  {
   "id": "s3",
   "scene": "teste",
   "text": "O novo dizia: a maioria dos hóspedes reutiliza a toalha. Subiu para 44%.",
   "start": 11.0,
   "end": 16.75
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "E quando dizia que a maioria dos hóspedes daquele mesmo quarto reutilizava, funcionou ainda melhor.",
   "start": 16.92,
   "end": 22.4
  },
  {
   "id": "s5",
   "scene": "licao",
   "text": "A gente segue gente parecida, num lugar parecido.",
   "start": 22.84,
   "end": 25.84
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Com o cliente, conte o que famílias parecidas com a dele escolheram naquele bairro. Desde que seja verdade.",
   "start": 26.36,
   "end": 31.82
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.2,
   "end": 36.49
  }
 ],
