 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você mostrou o apartamento. O cliente comprou. E a comissão ficou com outro corretor.",
   "start": 0.2,
   "end": 5.93
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Ela ainda pode ser sua?",
   "start": 6.28,
   "end": 7.43
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Numa história hipotética, você leva o cliente para visitar o imóvel em março.",
   "start": 7.8,
   "end": 11.78
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Ele pede uns dias e some.",
   "start": 12.04,
   "end": 13.67
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Em junho, fecha o mesmo apartamento com outro corretor.",
   "start": 14.12,
   "end": 17.44
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "A Justiça costuma olhar para uma coisa: quem fez a aproximação útil entre comprador e vendedor.",
   "start": 17.88,
   "end": 24.44
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se o seu trabalho levou ao negócio, a comissão pode ser sua, mesmo sem você no fechamento.",
   "start": 24.92,
   "end": 30.37
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Se dois corretores participaram, a lei manda dividir em partes iguais, salvo combinado diferente.",
   "start": 30.84,
   "end": 36.9
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Mas tem um detalhe que decide tudo: prova.",
   "start": 37.24,
   "end": 40.01
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Ficha de visita assinada, data, conversa salva, histórico do cliente.",
   "start": 40.28,
   "end": 45.24
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Sem isso, é a sua palavra contra a dele.",
   "start": 45.64,
   "end": 48.18
  },
  {
   "id": "s12",
   "scene": "x",
   "text": "Quem não registra, não prova. E quem não prova, não recebe.",
   "start": 48.52,
   "end": 52.26
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 52.6,
   "end": 57.48
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 57.72,
   "end": 60.63
  }
 ],
