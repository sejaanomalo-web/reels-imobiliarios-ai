 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente mandou um áudio de cinco minutos. E a única coisa que importava estava no minuto quatro.",
   "start": 0.12,
   "end": 6.31
  },
  {
   "id": "s2",
   "scene": "conteudo",
   "text": "Três quartos, perto da escola, e o teto de preço. Perdidos entre a reforma da cunhada e o trânsito.",
   "start": 6.68,
   "end": 13.52
  },
  {
   "id": "s3",
   "scene": "erro",
   "text": "Se você responde com outro áudio, a informação se perde de novo.",
   "start": 13.96,
   "end": 17.48
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Ouça inteiro e devolva por escrito, em tópicos: entendi isso, isso e isso. Está certo?",
   "start": 18.12,
   "end": 24.67
  },
  {
   "id": "s5",
   "scene": "ganho",
   "text": "O cliente corrige na hora. E você fica com a ficha dele pronta.",
   "start": 25.0,
   "end": 28.72
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Áudio é conversa. Por escrito é combinado.",
   "start": 29.24,
   "end": 32.31
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 32.68,
   "end": 37.11
  }
 ],
