 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A primeira parcela do décimo terceiro caiu até segunda-feira.",
   "start": 0.12,
   "end": 3.9
  },
  {
   "id": "s2",
   "scene": "conta",
   "text": "E o seu cliente vai perguntar se dá para usar na entrada do imóvel.",
   "start": 4.2,
   "end": 7.08
  },
  {
   "id": "s3",
   "scene": "conta",
   "text": "Às vezes dá. Mas antes, faça outra conta.",
   "start": 7.56,
   "end": 10.2
  },
  {
   "id": "s4",
   "scene": "itbi",
   "text": "Comprar imóvel tem custo que não aparece no preço.",
   "start": 10.6,
   "end": 13.27
  },
  {
   "id": "s5",
   "scene": "itbi",
   "text": "O ITBI, o imposto da prefeitura, é de 3% em São Paulo, no Rio e em Belo Horizonte.",
   "start": 13.48,
   "end": 18.94
  },
  {
   "id": "s6",
   "scene": "itbi",
   "text": "Num imóvel de 400 mil, são 12 mil reais. E ainda tem o cartório.",
   "start": 19.24,
   "end": 23.97
  },
  {
   "id": "s7",
   "scene": "virada",
   "text": "Sem o imposto pago, a escritura não sai.",
   "start": 24.36,
   "end": 26.81
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "E é aí que muita compra trava, mesmo com o financiamento aprovado.",
   "start": 27.08,
   "end": 30.72
  },
  {
   "id": "s9",
   "scene": "pergunta",
   "text": "Então a pergunta não é só quanto ele tem de entrada.",
   "start": 31.08,
   "end": 33.73
  },
  {
   "id": "s10",
   "scene": "pergunta",
   "text": "É: você já separou o imposto e o cartório?",
   "start": 34.04,
   "end": 36.5
  },
  {
   "id": "s11",
   "scene": "pergunta",
   "text": "O décimo terceiro pode começar essa reserva.",
   "start": 36.76,
   "end": 38.93
  },
  {
   "id": "s12",
   "scene": "desfecho",
   "text": "Quem faz essa conta antes evita a surpresa no cartório.",
   "start": 39.32,
   "end": 42.4
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 42.84,
   "end": 46.99
  }
 ],
