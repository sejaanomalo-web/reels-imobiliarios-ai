 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em 1915, um prédio em Nova York fez tanta sombra que a cidade mudou as regras.",
   "start": 0.12,
   "end": 5.49
  },
  {
   "id": "s2",
   "scene": "paredao",
   "text": "Era um paredão de quase quarenta andares, sem recuo, e as ruas em volta perderam o sol.",
   "start": 5.64,
   "end": 10.35
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "No ano seguinte, veio a primeira lei de zoneamento da cidade, com recuos para a luz chegar à rua.",
   "start": 10.68,
   "end": 15.67
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Os vizinhos tinham comprado luz. E perderam por causa do terreno ao lado.",
   "start": 15.96,
   "end": 19.72
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de vender a vista ou o sol, confira o que a lei permite construir no terreno vizinho.",
   "start": 20.12,
   "end": 24.75
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "O que pode subir ao lado também faz parte do imóvel.",
   "start": 25.08,
   "end": 27.7
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 28.04,
   "end": 32.29
  }
 ],
