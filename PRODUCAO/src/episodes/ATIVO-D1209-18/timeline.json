 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Esta igreja começou em 1882. E a torre mais alta só ficou pronta este ano.",
   "start": 0.12,
   "end": 6.43
  },
  {
   "id": "s2",
   "scene": "autor",
   "text": "Gaudí morreu em 1926, com a obra longe do fim.",
   "start": 6.76,
   "end": 10.47
  },
  {
   "id": "s3",
   "scene": "guerra",
   "text": "Dez anos depois, na guerra, queimaram os desenhos e quebraram as maquetes de gesso.",
   "start": 10.84,
   "end": 15.78
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "A obra continuou porque juntaram os pedaços, as fotos e as plantas publicadas.",
   "start": 16.2,
   "end": 21.29
  },
  {
   "id": "s5",
   "scene": "ponte",
   "text": "Se o seu atendimento só existe na sua cabeça, ele para no dia em que você parar.",
   "start": 21.72,
   "end": 26.29
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Registre como quem constrói para outra pessoa terminar.",
   "start": 26.84,
   "end": 29.95
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "start": 30.28,
   "end": 35.16
  }
 ],
