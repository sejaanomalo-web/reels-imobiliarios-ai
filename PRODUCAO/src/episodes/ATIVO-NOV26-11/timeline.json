 ],
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que um apartamento de um quarto pode ter metro quadrado mais caro do que um de três?",
   "start": 0.12,
   "end": 4.07
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Porque o tamanho não conta a história inteira.",
   "start": 4.28,
   "end": 6.33
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Em alguns recortes do mercado, unidades menores têm preço por metro quadrado maior.",
   "start": 6.52,
   "end": 10.48
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Localização, padrão, oferta e o perfil de quem compra podem mudar essa relação.",
   "start": 10.76,
   "end": 15.21
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Agora imagine um investidor comparando só preço por metro.",
   "start": 15.48,
   "end": 18.25
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Ele pode ignorar condomínio, vacância, mobília e custo de manutenção.",
   "start": 18.52,
   "end": 22.65
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "E o comprador que vai morar pode ter prioridades completamente diferentes.",
   "start": 22.84,
   "end": 26.54
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de recomendar, pergunte para que o imóvel será usado.",
   "start": 26.84,
   "end": 29.81
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Depois, compare custo total, funcionalidade e alternativas reais da região.",
   "start": 30.12,
   "end": 34.53
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Metro quadrado ajuda, mas não decide sozinho.",
   "start": 34.76,
   "end": 37.24
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Comece pela finalidade; o metro vem depois.",
   "start": 37.48,
   "end": 40.18
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.44,
   "end": 44.76
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 44.92,
   "end": 47.75
  }
 ],
