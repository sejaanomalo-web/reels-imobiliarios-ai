 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se o crédito imobiliário está caro, como a Caixa contratou dezenas de bilhões de reais em financiamentos num único trimestre?",
   "caption": "Se o *crédito* imobiliário | está *caro,* | como a Caixa | contratou | *dezenas de bilhões* | de reais | em financiamentos | num único *trimestre?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "No terceiro trimestre de dois mil e vinte e seis, foram setenta e dois vírgula cinco bilhões de reais em contratações, considerando recursos da Caixa e do FGTS.",
   "caption": "No *terceiro trimestre* | de dois mil | e vinte e seis, | foram *setenta e dois* | *vírgula cinco bilhões* | de reais | em contratações, | considerando recursos | da *Caixa* e do *FGTS.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "É um volume grande, mesmo com taxas elevadas.",
   "caption": "É um volume *grande,* | mesmo com | *taxas elevadas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "O erro é imaginar o mercado como um interruptor: juro alto, ninguém compra; juro baixo, todo mundo compra.",
   "caption": "O erro | é imaginar o mercado | como um *interruptor:* | juro alto, | *ninguém compra;* | juro baixo, | *todo mundo compra.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Na prática, existem faixas de renda, modalidades, necessidades e condições muito diferentes.",
   "caption": "Na prática, | existem *faixas de renda,* | *modalidades,* | *necessidades* | e *condições* | muito diferentes.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Para o corretor, olhar o número agregado é só o começo.",
   "caption": "Para o corretor, | olhar o número | *agregado* | é só o *começo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O que importa é saber qual modalidade atende o cliente, quais condições estão disponíveis e qual produto faz sentido para ele.",
   "caption": "O que importa | é saber qual *modalidade* | atende o cliente, | quais *condições* | estão disponíveis | e qual *produto* | faz sentido | para ele.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de repetir que o mercado travou, olhe o recorte da notícia.",
   "caption": "Antes de repetir | que o mercado *travou,* | olhe o *recorte* | da notícia.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
