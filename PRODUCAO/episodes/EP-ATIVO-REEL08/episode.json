 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A comissão caiu na conta.",
   "caption": "A *comissão* | caiu na conta.",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Agora vem uma decisão que quase nunca aparece nas fotos de conquista.",
   "caption": "Agora vem | uma *decisão* | que quase nunca aparece | nas *fotos de conquista.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "prim",
   "text": "Num cenário hipotético, um profissional comemora a venda e volta à rotina sem revisar o que aconteceu: de onde veio o cliente, quais imóveis despertaram interesse e quem ainda ficou em negociação.",
   "caption": "Num cenário *hipotético,* | um profissional | *comemora* a venda | e volta à rotina | *sem revisar* | o que aconteceu: | de onde veio | o *cliente,* | quais imóveis | despertaram *interesse* | e quem ainda ficou | em *negociação.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "prim",
   "text": "No mês seguinte, precisa reconstruir tudo de memória.",
   "caption": "No *mês seguinte,* | precisa reconstruir | tudo *de memória.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "outro",
   "text": "O segundo também comemora.",
   "caption": "O *segundo* | também comemora.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "outro",
   "text": "Mas registra a origem da oportunidade, atualiza os interessados, organiza a carteira e reserva um tempo para prospecção.",
   "caption": "Mas *registra* | a origem | da oportunidade, | *atualiza* | os interessados, | *organiza* a carteira | e *reserva* um tempo | para prospecção.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "outro",
   "text": "Não é uma máquina que vende sozinha.",
   "caption": "Não é uma máquina | que *vende sozinha.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "outro",
   "text": "É uma operação que preserva o aprendizado de cada atendimento.",
   "caption": "É uma *operação* | que preserva | o *aprendizado* | de cada atendimento.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "ideia",
   "text": "O resultado de uma venda não está só na comissão recebida.",
   "caption": "O resultado | de uma venda | *não está só* | na comissão recebida.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "ideia",
   "text": "Também pode estar na base de contatos, no conhecimento do público e na estrutura que você constrói para trabalhar melhor na próxima negociação.",
   "caption": "Também pode estar | na *base de contatos,* | no *conhecimento* | do público | e na *estrutura* | que você constrói | para trabalhar melhor | na próxima negociação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "ideia",
   "text": "No próximo fechamento, reserve um momento para revisar o que essa venda ensinou.",
   "caption": "No próximo | *fechamento,* | reserve um momento | para *revisar* | o que essa venda | *ensinou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
