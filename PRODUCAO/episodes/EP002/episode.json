  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "O cliente diz que está só olhando.",
      "caption": "O cliente diz | que está | *só olhando.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s2",
      "scene": "hook",
      "text": "E você já coloca ele na pasta dos curiosos.",
      "caption": "E você já coloca ele | na pasta | dos *curiosos.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s3",
      "scene": "situacao",
      "text": "Mas pense: ele pode estar pesquisando bairros, simulando financiamento ou esperando vender outro imóvel.",
      "caption": "Mas pense: | ele pode estar | pesquisando *bairros,* | simulando | *financiamento* | ou esperando vender | outro *imóvel.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s4",
      "scene": "situacao",
      "text": "A frase não explica o momento de compra.",
      "caption": "A frase | não explica | o *momento de compra.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "scene": "tensao",
      "text": "Se você manda dez anúncios sem perguntar nada, a conversa continua vaga e o cliente continua desconhecido.",
      "caption": "Se você manda | *dez anúncios* | sem perguntar *nada,* | a conversa | continua *vaga* | e o cliente | continua *desconhecido.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "insight",
      "text": "Troque o julgamento por uma pergunta:",
      "caption": "Troque o *julgamento* | por uma *pergunta:*",
      "pauseAfter": 0.3
    },
    {
      "id": "s7",
      "scene": "insight",
      "text": "o que precisa acontecer para você decidir?",
      "caption": "o que precisa | *acontecer* | para você *decidir?*",
      "pauseAfter": 0.3
    },
    {
      "id": "s8",
      "scene": "insight",
      "text": "Registre a resposta e combine quando voltar a conversar.",
      "caption": "*Registre* a resposta | e *combine* | quando voltar | a conversar.",
      "pauseAfter": 0.3
    },
    {
      "id": "s9",
      "scene": "cta",
      "text": "Se você quer organizar essas etapas sem depender da memória,",
      "caption": "Se você quer | *organizar* essas etapas | sem depender | da *memória,*",
      "pauseAfter": 0.3
    },
    {
      "id": "s10",
      "scene": "cta",
      "text": "conheça nosso sistema imobiliário personalizado pelo link da bio.",
      "caption": "conheça nosso | sistema imobiliário | *personalizado* | pelo *link da bio.*",
      "pauseAfter": 0.3
    }
  ],
