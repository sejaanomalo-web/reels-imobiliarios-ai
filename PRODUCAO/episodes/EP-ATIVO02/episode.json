 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se seus vídeos de imóveis sempre começam com “olha essa oportunidade”, você está desperdiçando os segundos mais importantes da apresentação.",
   "caption": "Se seus vídeos | de imóveis | sempre começam com | *“olha essa oportunidade”,* | você está *desperdiçando* | os segundos | *mais importantes* | da apresentação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O comprador ainda não sabe por que deveria continuar assistindo.",
   "caption": "O comprador | ainda *não sabe* | por que deveria | *continuar assistindo.*",
   "pauseAfter": 0.35
  },
  {
   "id": "s3",
   "scene": "rotina",
   "text": "Primeiro, comece pela rotina: “Trabalha em casa e não quer usar o quarto como escritório? Veja como este ambiente foi dividido.”",
   "caption": "*Primeiro,* | comece pela *rotina:* | “Trabalha em casa | e não quer usar | o quarto | como *escritório?* | Veja como | este ambiente | foi *dividido.”*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "contraste",
   "text": "Segundo, use um contraste real: “A fachada é discreta. O que surpreende é a distribuição dos ambientes por dentro.”",
   "caption": "*Segundo,* | use um *contraste real:* | “A fachada | é *discreta.* | O que surpreende | é a *distribuição* | dos ambientes | *por dentro.”*",
   "pauseAfter": 0.25
  },
  {
   "id": "s5",
   "scene": "contraste",
   "text": "Só diga isso se a imagem realmente comprovar.",
   "caption": "Só diga isso | se a imagem | *realmente comprovar.*",
   "pauseAfter": 0.35
  },
  {
   "id": "s6",
   "scene": "local",
   "text": "Terceiro, abra com um critério de localização: “Se o seu trabalho fica nesta região, olha as opções de acesso deste endereço.”",
   "caption": "*Terceiro,* | abra com um critério | de *localização:* | “Se o seu trabalho | fica *nesta região,* | olha as opções | de *acesso* | deste endereço.”",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "objecao",
   "text": "Quarto, responda a uma objeção específica: “Precisa evitar escadas no dia a dia? Vamos conhecer a circulação desta casa.”",
   "caption": "*Quarto,* | responda a uma | *objeção específica:* | “Precisa evitar | *escadas* | no dia a dia? | Vamos conhecer | a *circulação* | desta casa.”",
   "pauseAfter": 0.25
  },
  {
   "id": "s8",
   "scene": "objecao",
   "text": "Não invente distâncias nem soluções que o imóvel não oferece.",
   "caption": "Não invente | *distâncias* | nem *soluções* | que o imóvel | *não oferece.*",
   "pauseAfter": 0.35
  },
  {
   "id": "s9",
   "scene": "momento",
   "text": "Quinto, fale com um momento de vida: “Vai sair do aluguel e ainda está descobrindo que tipo de imóvel cabe na sua rotina? Este exemplo ajuda a comparar prioridades.”",
   "caption": "*Quinto,* | fale com um | *momento de vida:* | “Vai sair | do *aluguel* | e ainda está descobrindo | que tipo de imóvel | *cabe na sua rotina?* | Este exemplo ajuda | a *comparar prioridades.”*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "momento",
   "text": "Percebe? Cada abertura dá ao público um motivo diferente para prestar atenção.",
   "caption": "*Percebe?* | Cada abertura | dá ao público | um *motivo diferente* | para prestar atenção.",
   "pauseAfter": 0.35
  },
  {
   "id": "s11",
   "scene": "insight",
   "text": "Antes de gravar, escreva uma frase: “Este imóvel é especialmente relevante para quem...”",
   "caption": "Antes de gravar, | escreva *uma frase:* | “Este imóvel | é especialmente | *relevante* | *para quem...”*",
   "pauseAfter": 0.35
  },
  {
