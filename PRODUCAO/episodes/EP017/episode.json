  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "Às vezes, a visita que não virou proposta trouxe a informação mais valiosa da semana.",
      "caption": "Às vezes, | a *visita* | que *não virou proposta* | trouxe a informação | *mais valiosa* | da semana.",
      "pauseAfter": 0.3
    },
    {
      "id": "s2",
      "scene": "situacao",
      "text": "O cliente gostou da planta, mas achou a rua movimentada.",
      "caption": "O cliente | gostou da *planta,* | mas achou a rua | *movimentada.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s3",
      "scene": "situacao",
      "text": "Ou adorou a localização e percebeu que precisa de mais espaço.",
      "caption": "Ou adorou | a *localização* | e percebeu | que precisa | de *mais espaço.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s4",
      "scene": "tensao",
      "text": "O erro é registrar apenas que ele não gostou.",
      "caption": "O *erro* | é registrar apenas | que ele *não gostou.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "scene": "tensao",
      "text": "Você perde o critério que pode orientar a próxima indicação.",
      "caption": "Você *perde* | o *critério* | que pode orientar | a *próxima indicação.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "insight",
      "text": "Depois da visita, pergunte o que funcionou e o que não funcionou.",
      "caption": "Depois da visita, | pergunte | o que *funcionou* | e o que | *não funcionou.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s7",
      "scene": "insight",
      "text": "Registre esses critérios para selecionar a próxima opção com mais precisão.",
      "caption": "*Registre* | esses critérios | para selecionar | a próxima opção | com mais *precisão.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s8",
      "scene": "cta",
      "text": "Essas pistas só ajudam se ficarem registradas na jornada de cada cliente.",
      "caption": "Essas *pistas* | só ajudam | se ficarem *registradas* | na jornada | de cada cliente.",
      "pauseAfter": 0.3
    },
    {
      "id": "s9",
      "scene": "cta",
      "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
      "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
      "pauseAfter": 0.3
    },
    {
      "id": "s10",
      "scene": "cta",
      "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
      "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
      "pauseAfter": 0.3
