 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você fecha uma venda, comemora... e algumas semanas depois sente que voltou ao ponto de partida.",
   "caption": "Você fecha uma *venda,* | *comemora...* | e algumas semanas depois | sente que voltou | ao *ponto de partida.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Como isso acontece?",
   "caption": "Como isso *acontece?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "desc",
   "text": "Na corretagem, a entrada de receita pode ser irregular.",
   "caption": "Na corretagem, | a entrada de receita | pode ser *irregular.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "desc",
   "text": "Enquanto uma comissão não entra, continuam existindo deslocamentos, divulgação, contas e tempo dedicado a visitas.",
   "caption": "Enquanto uma comissão | *não entra,* | continuam existindo | *deslocamentos,* | *divulgação,* | *contas* | e tempo dedicado | a *visitas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "desc",
   "text": "Se cada negócio começa do zero, a pressão do mês seguinte aumenta.",
   "caption": "Se cada negócio | começa *do zero,* | a *pressão* | do mês seguinte | aumenta.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "res",
   "text": "Pensa num reservatório.",
   "caption": "Pensa num *reservatório.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "res",
   "text": "Se você só retira água e nunca planeja a reposição, uma entrada grande não garante tranquilidade depois.",
   "caption": "Se você só *retira* água | e nunca planeja | a *reposição,* | uma *entrada grande* | não garante | tranquilidade depois.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "res",
   "text": "Com a operação é parecido: precisa cuidar do caixa e também das atividades que mantêm novas oportunidades chegando.",
   "caption": "Com a operação | é parecido: | precisa cuidar | do *caixa* | e também | das *atividades* | que mantêm | *novas oportunidades* | chegando.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "hab",
   "text": "Um começo possível é separar compromissos financeiros, acompanhar negociações por etapa e manter uma rotina mínima de prospecção.",
   "caption": "Um começo possível | é *separar* | compromissos financeiros, | *acompanhar* negociações | por etapa | e *manter* | uma rotina mínima | de prospecção.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "hab",
   "text": "Não resolve todos os riscos da profissão, mas evita tomar cada decisão só pela urgência do dia.",
   "caption": "Não resolve | *todos os riscos* | da profissão, | mas evita | tomar cada decisão | só pela *urgência do dia.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "fim",
   "text": "E para acompanhar negociações e prospecção sem depender da memória, ajuda ter tudo organizado num só lugar.",
   "caption": "E para acompanhar | *negociações* | e *prospecção* | sem depender | da memória, | ajuda ter tudo | *organizado* | num só lugar.",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
