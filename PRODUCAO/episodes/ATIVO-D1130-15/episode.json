 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente pediu pra ver o apartamento de novo.",
   "caption": "O cliente pediu | pra ver | o apartamento | *de novo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E muito corretor faz exatamente a mesma visita outra vez.",
   "caption": "E muito corretor | faz exatamente | a *mesma visita* | outra vez.",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "pergunta",
   "text": "Só que a pergunta dele mudou.",
   "caption": "Só que | a *pergunta* dele | *mudou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "pergunta",
   "text": "Na primeira, ele queria saber se gostava.",
   "caption": "Na primeira, | ele queria saber | se *gostava.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "pergunta",
   "text": "Agora, ele quer saber como seria morar ali.",
   "caption": "Agora, | ele quer saber | como seria | *morar* ali.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "sinais",
   "text": "Repare nos sinais.",
   "caption": "Repare | nos *sinais.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "sinais",
   "text": "Ele mede a parede pro sofá. Abre o armário.",
   "caption": "Ele *mede* | a parede | pro *sofá.* | Abre | o *armário.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "sinais",
   "text": "Pergunta do vizinho, do barulho, do sol da tarde.",
   "caption": "Pergunta | do *vizinho,* | do *barulho,* | do *sol* | da tarde.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "junto",
   "text": "E muitas vezes ele traz alguém junto: a mãe, o sócio, quem divide a decisão.",
   "caption": "E muitas vezes | ele traz | alguém *junto:* | a *mãe,* | o *sócio,* | quem divide | a *decisão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "virada",
   "text": "Se você continua apresentando a sala e a cozinha, você atrapalha.",
   "caption": "Se você continua | apresentando | a sala | e a cozinha, | você *atrapalha.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "virada",
   "text": "Ele não precisa de tour. Precisa de espaço pra se imaginar ali.",
   "caption": "Ele não precisa | de *tour.* | Precisa de *espaço* | pra se imaginar | ali.",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "pratica",
   "text": "Chegue com a trena, as medidas e o valor do condomínio na mão.",
   "caption": "Chegue | com a *trena,* | as *medidas* | e o valor | do *condomínio* | na mão.",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "pratica",
   "text": "E marque no horário em que ele vai viver ali: se ele trabalha de dia, mostre à noite.",
   "caption": "E marque | no *horário* | em que ele | vai viver ali: | se ele trabalha | de *dia,* | mostre | à *noite.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "desfecho",
   "text": "Na segunda visita, quem precisa falar menos é você.",
   "caption": "Na *segunda visita,* | quem precisa | falar *menos* | é você.",
   "pauseAfter": 0.3
  },
  {
