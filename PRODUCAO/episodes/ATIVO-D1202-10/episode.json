 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se o comprador do imóvel tivesse que pagar metade da comissão do corretor?",
   "caption": "E se o *comprador* | do imóvel | tivesse que pagar | *metade* | da *comissão* | do corretor?",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "lei",
   "text": "Na Alemanha, isso virou lei no fim de 2020.",
   "caption": "Na *Alemanha,* | isso virou *lei* | no fim de *2020.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "Na venda de apartamento ou casa para morar, quando o corretor atende os dois lados, a comissão é dividida meio a meio.",
   "caption": "Na venda | de apartamento | ou casa para morar, | quando o corretor | atende os *dois lados,* | a comissão é dividida | *meio a meio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "antes",
   "text": "Antes, em cidades como Berlim e Hamburgo, era o comprador que pagava tudo.",
   "caption": "*Antes,* | em cidades como | Berlim e Hamburgo, | era o comprador | que pagava *tudo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "antes",
   "text": "A lei veio para aliviar quem compra.",
   "caption": "A lei veio | para *aliviar* | quem compra.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "Só que um estudo de uma universidade de Berlim encontrou outra coisa: somando as duas metades, a comissão ficou maior.",
   "caption": "Só que | um *estudo* | de uma universidade | de Berlim | encontrou outra coisa: | somando as duas metades, | a comissão | ficou *maior.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "brasil",
   "text": "Ou seja, mudar quem paga não mudou o valor.",
   "caption": "Ou seja, | mudar quem paga | *não mudou* | o valor.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "brasil",
   "text": "No Brasil, quase sempre quem paga é o vendedor. Mas quem decide a compra é o comprador.",
   "caption": "No *Brasil,* | quase sempre | quem paga | é o *vendedor.* | Mas quem *decide* | a compra | é o *comprador.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Então trabalhe como se os dois pagassem: mostre ao comprador a pesquisa, os documentos e a negociação que ele recebe de você.",
   "caption": "Então trabalhe | como se *os dois* | pagassem: | mostre ao comprador | a *pesquisa,* | os *documentos* | e a *negociação* | que ele recebe | de você.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "caption": "Se você é *corretor,* | comente *SISTEMA* | e conheça nosso | sistema *personalizado.*",
   "pauseAfter": 0.3
  }
 ],
