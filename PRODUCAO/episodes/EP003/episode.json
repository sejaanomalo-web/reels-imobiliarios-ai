  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "Cinco pessoas chamam ao mesmo tempo.",
      "caption": "*Cinco pessoas* | chamam | ao *mesmo tempo.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s2",
      "scene": "hook",
      "text": "Quem responde primeiro?",
      "caption": "Quem responde | *primeiro?*",
      "pauseAfter": 0.15
    },
    {
      "id": "s3",
      "scene": "situacao",
      "text": "Uma quer agendar visita.",
      "caption": "Uma quer | agendar *visita.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s4",
      "scene": "situacao",
      "text": "Outra pede documentação.",
      "caption": "Outra pede | *documentação.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s5",
      "scene": "situacao",
      "text": "A terceira ainda nem escolheu bairro.",
      "caption": "A terceira | ainda nem escolheu | *bairro.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s6",
      "scene": "situacao",
      "text": "No WhatsApp, tudo parece igualmente urgente.",
      "caption": "No WhatsApp, | tudo parece | igualmente *urgente.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s7",
      "scene": "tensao",
      "text": "O erro é responder na ordem em que as mensagens aparecem, sem considerar compromisso, prazo e próximo passo.",
      "caption": "O *erro* | é responder | na ordem | em que as mensagens | aparecem, | sem considerar | *compromisso,* | *prazo* | e *próximo passo.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s8",
      "scene": "insight",
      "text": "Classifique cada contato por etapa e prazo.",
      "caption": "*Classifique* | cada contato | por *etapa* | e *prazo.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s9",
      "scene": "insight",
      "text": "Primeiro, cumpra o que já foi combinado.",
      "caption": "*Primeiro,* | cumpra o que | já foi *combinado.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s10",
      "scene": "insight",
      "text": "Depois, organize os novos pedidos para não prometer o que não consegue entregar.",
      "caption": "Depois, | *organize* | os novos pedidos | para não *prometer* | o que não consegue | *entregar.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s11",
      "scene": "cta",
      "text": "Quer visualizar seus atendimentos em um único fluxo?",
      "caption": "Quer visualizar | seus atendimentos | em um *único fluxo?*",
      "pauseAfter": 0.15
    },
    {
      "id": "s12",
      "scene": "cta",
      "text": "O sistema que personalizamos para corretores está no link da bio.",
      "caption": "O sistema | que *personalizamos* | para corretores | está no | *link da bio.*",
      "pauseAfter": 0.15
    }
  ],
