 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se você está começando como corretor, não precisa fingir que já vendeu dezenas de imóveis para parecer confiável.",
   "caption": "Se você está *começando* | como corretor, | não precisa *fingir* | que já vendeu | *dezenas de imóveis* | para parecer | confiável.",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Existe uma forma mais interessante de construir autoridade: mostrar como você pensa.",
   "caption": "Existe uma forma | mais interessante | de construir *autoridade:* | mostrar | como você *pensa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "mercado",
   "text": "Primeiro, explique critérios do mercado em que atua.",
   "caption": "*Primeiro,* | explique *critérios* | do mercado | em que atua.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "mercado",
   "text": "Em vez de dizer que um bairro é “o melhor”, mostre o que vale pesquisar: mobilidade, serviços próximos, perfil das ruas e diferença entre regiões.",
   "caption": "Em vez de dizer | que um bairro | é “o *melhor”,* | mostre o que vale | *pesquisar:* | *mobilidade,* | *serviços* próximos, | *perfil* das ruas | e diferença | entre *regiões.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "mercado",
   "text": "Use fontes e observações que você realmente conferiu.",
   "caption": "Use *fontes* | e observações | que você realmente | *conferiu.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "analise",
   "text": "Segundo, analise imóveis com equilíbrio.",
   "caption": "*Segundo,* | analise imóveis | com *equilíbrio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "analise",
   "text": "Mostre para quem a planta pode funcionar e para quem talvez não funcione.",
   "caption": "Mostre para quem | a planta | pode *funcionar* | e para quem | talvez *não funcione.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "analise",
   "text": "Um apartamento com pouca manutenção pode interessar a uma pessoa e ser ruim para uma família que precisa de três quartos.",
   "caption": "Um apartamento | com *pouca manutenção* | pode interessar | a uma pessoa | e ser *ruim* | para uma família | que precisa | de *três quartos.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "processo",
   "text": "Terceiro, esclareça etapas da compra.",
   "caption": "*Terceiro,* | esclareça | *etapas* da compra.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "processo",
   "text": "O que o interessado deve conferir antes de visitar?",
   "caption": "O que o interessado | deve *conferir* | antes de *visitar?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "processo",
   "text": "Que documentos costumam exigir atenção?",
   "caption": "Que *documentos* | costumam | exigir atenção?",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "processo",
   "text": "Em que momento entram as verificações?",
   "caption": "Em que momento | entram as | *verificações?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "processo",
   "text": "Quando houver regras específicas, oriente a procurar fontes oficiais e profissionais responsáveis.",
   "caption": "Quando houver | regras *específicas,* | oriente a procurar | *fontes oficiais* | e profissionais | *responsáveis.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "insight",
   "text": "Pense nisso: seu próximo conteúdo não precisa anunciar que você entende do assunto.",
   "caption": "Pense nisso: | seu próximo *conteúdo* | não precisa | *anunciar* | que você entende | do assunto.",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "Ele pode demonstrar esse conhecimento, de um jeito que realmente ajude alguém.",
   "caption": "Ele pode | *demonstrar* | esse conhecimento, | de um jeito | que realmente | *ajude alguém.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s16",
   "scene": "insight",
   "text": "Autoridade é percebida no valor do que você explica.",
   "caption": "*Autoridade* | é percebida | no *valor* | do que você explica.",
   "pauseAfter": 0.3
  },
  {
   "id": "s17",
   "scene": "insight",
   "text": "Uma atuação mais estratégica também começa pela sua organização.",
   "caption": "Uma atuação | mais *estratégica* | também começa | pela sua *organização.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s18",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s19",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
