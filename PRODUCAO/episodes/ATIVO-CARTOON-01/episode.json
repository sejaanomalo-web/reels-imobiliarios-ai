 "apuracao": {
  "fato": "Art. 728 do Código Civil (Lei 10.406/2002): 'Se o negócio se concluir com a intermediação de mais de um corretor, a remuneração será paga a todos em partes iguais, salvo ajuste em contrário.' STJ (3ª Turma; AgInt 2025): caracterizada a aproximação útil, com a efetiva celebração do negócio, é devida a comissão ainda que outro profissional tenha conduzido as tratativas finais; mera aproximação sem vínculo efetivo não gera comissão; cabe ao corretor provar o nexo causal. Fala usa 'pode ser sua' / 'costuma' (não é garantia nem consultoria jurídica). História HIPOTÉTICA.",
  "verificado_em": "2026-11-21",
  "fontes": [
   "https://www.planalto.gov.br/ccivil_03/leis/2002/l10406compilada.htm (arts. 722–729)",
   "https://crecies.gov.br/codigo-civil-corretagem",
   "https://www.legjur.com/jurisprudencia/eme/767.8897.1345.1400",
   "https://www.migalhas.com.br/depeso/434604/corretor-tem-direito-a-comissao-mesmo-sem-participar-da-venda-final",
   "https://www.conjur.com.br/2017-nov-24/nao-cabe-corretagem-negocio-desfeito-desapropriacao/"
  ],
  "cuidados": "sem número de processo na tela; sem valores de comissão; personagens ilustrativos; nada de prometer ganho de causa"
 },
 "diagnostico": {
  "publico_situacao": "corretor autônomo que mostra imóvel e perde a venda para outro corretor",
  "motivacao": "medo real de perder comissão; disputa comum no mercado",
  "crenca_questionada": "'se eu não fechei, perdi tudo'",
  "hipotese": "cartoon: visita em março → cliente some → venda em junho com outro corretor → o que a Justiça olha (aproximação útil, art. 728) → a prova decide → registro",
  "funcao": "dor + direito + virada (prova)",
  "promessa": "entender quando a comissão pode ser sua e o que decide a disputa",
  "evidencias": "CC art. 725 e 728; STJ: comissão devida quando a aproximação útil do corretor resulta no negócio, mesmo com outro profissional no fechamento, exigida prova do nexo causal",
  "cta": "comentário SISTEMA → Direct"
 },
 "cta": {
  "original_cta": "(roteiro original da ATIVO, sem CTA própria)",
  "transition_adapted": "a última frase ('quem não prova, não recebe') leva ao registro → CTA SISTEMA",
  "type": "comentario",
  "keyword": "SISTEMA",
  "channel": "Direct",
  "base_text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos? Comente SISTEMA que eu te envio os detalhes pelo Direct.",
  "source": "regra do cliente em 14/11/2026"
 },
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você mostrou o apartamento. O cliente comprou. E a comissão ficou com outro corretor.",
   "caption": "Você *mostrou* | o apartamento. | O cliente | *comprou.* | E a *comissão* | ficou com | *outro corretor.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Ela ainda pode ser sua?",
   "caption": "Ela ainda | pode ser *sua?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Numa história hipotética, você leva o cliente para visitar o imóvel em março.",
   "caption": "Numa história | *hipotética,* | você leva | o cliente | para *visitar* | o imóvel | em *março.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Ele pede uns dias e some.",
   "caption": "Ele pede | uns dias | e *some.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Em junho, fecha o mesmo apartamento com outro corretor.",
   "caption": "Em *junho,* | fecha o *mesmo* | apartamento | com *outro corretor.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "A Justiça costuma olhar para uma coisa: quem fez a aproximação útil entre comprador e vendedor.",
   "caption": "A *Justiça* | costuma olhar | para uma coisa: | quem fez | a *aproximação útil* | entre comprador | e vendedor.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se o seu trabalho levou ao negócio, a comissão pode ser sua, mesmo sem você no fechamento.",
   "caption": "Se o seu | *trabalho* | levou ao negócio, | a *comissão* | pode ser *sua,* | mesmo sem você | no *fechamento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Se dois corretores participaram, a lei manda dividir em partes iguais, salvo combinado diferente.",
   "caption": "Se *dois corretores* | participaram, | a *lei* | manda *dividir* | em partes iguais, | salvo *combinado* | diferente.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Mas tem um detalhe que decide tudo: prova.",
   "caption": "Mas tem | um detalhe | que *decide tudo:* | *prova.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Ficha de visita assinada, data, conversa salva, histórico do cliente.",
   "caption": "Ficha de visita | *assinada,* | *data,* | conversa *salva,* | *histórico* | do cliente.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Sem isso, é a sua palavra contra a dele.",
   "caption": "Sem isso, | é a sua | *palavra* | *contra a dele.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "x",
   "text": "Quem não registra, não prova. E quem não prova, não recebe.",
   "caption": "Quem *não registra,* | *não prova.* | E quem | não prova, | *não recebe.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
