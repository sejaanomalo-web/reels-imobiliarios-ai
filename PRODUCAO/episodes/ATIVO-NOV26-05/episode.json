 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um cliente mandou: “Meu financiamento foi aprovado!”",
   "caption": "Um cliente mandou: | “Meu financiamento | foi *aprovado!*”",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O corretor já comemorou a venda.",
   "caption": "O corretor | já *comemorou* | a venda.",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Só que faltava quase tudo.",
   "caption": "Só que faltava | *quase tudo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Numa situação hipotética, a análise inicial parece positiva.",
   "caption": "Numa situação | *hipotética,* | a análise *inicial* | parece positiva.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "O comprador escolhe o imóvel e acha que a próxima etapa é receber as chaves.",
   "caption": "O comprador | escolhe o imóvel | e acha que | a próxima etapa | é receber as *chaves.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t1",
   "text": "Mas ainda podem existir avaliação do bem, conferência de documentos e condições a cumprir.",
   "caption": "Mas ainda | podem existir | *avaliação* do bem, | conferência | de *documentos* | e *condições* | a cumprir.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se o corretor fala “está tudo certo” antes da hora, cria uma expectativa que não controla.",
   "caption": "Se o corretor fala | “está *tudo certo*” | antes da hora, | cria uma *expectativa* | que não controla.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Quando aparece uma pendência, a confiança no atendimento sofre.",
   "caption": "Quando aparece | uma *pendência,* | a *confiança* | no atendimento | sofre.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Uma orientação melhor é dizer exatamente em que fase a operação está, quais verificações ainda faltam e quando será possível confirmar o próximo passo.",
   "caption": "Uma orientação melhor | é dizer exatamente | em que *fase* | a operação está, | quais *verificações* | ainda faltam | e quando será possível | confirmar | o *próximo passo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Aprovação inicial não é fechamento: explique o próximo passo.",
   "caption": "Aprovação inicial | *não é fechamento:* | explique | o próximo passo.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
