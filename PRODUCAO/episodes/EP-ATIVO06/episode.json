 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Sua imobiliária recebe contatos, agenda visitas, cadastra imóveis e tem uma equipe ocupada.",
   "caption": "Sua imobiliária | recebe *contatos,* | agenda *visitas,* | cadastra *imóveis* | e tem uma equipe | *ocupada.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mesmo assim, algumas oportunidades param no caminho.",
   "caption": "Mesmo assim, | algumas oportunidades | *param no caminho.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "A pergunta não é se as pessoas estão trabalhando.",
   "caption": "A pergunta | não é se as pessoas | estão *trabalhando.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "hook",
   "text": "É onde a operação está perdendo continuidade.",
   "caption": "É *onde* a operação | está perdendo | *continuidade.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "contato",
   "text": "Acompanhe uma oportunidade fictícia.",
   "caption": "Acompanhe | uma oportunidade | *fictícia.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "contato",
   "text": "Ela chega por um anúncio.",
   "caption": "Ela chega | por um *anúncio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "contato",
   "text": "Alguém responde, mas ninguém define quem será responsável pelo próximo retorno.",
   "caption": "Alguém *responde,* | mas ninguém define | quem será *responsável* | pelo próximo *retorno.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "contato",
   "text": "No dia seguinte, outro corretor abre a conversa sem saber o que já foi explicado.",
   "caption": "No dia seguinte, | *outro corretor* | abre a conversa | sem saber | o que já foi *explicado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "imovel",
   "text": "Agora siga o imóvel.",
   "caption": "Agora | siga o *imóvel.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "imovel",
   "text": "Um corretor informa que está disponível.",
   "caption": "Um corretor informa | que está *disponível.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "imovel",
   "text": "Outro descobre que a condição mudou.",
   "caption": "Outro descobre | que a *condição mudou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "imovel",
   "text": "A carteira foi atualizada em um lugar, mas não no outro.",
   "caption": "A carteira | foi *atualizada* | em um lugar, | mas *não no outro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "imovel",
   "text": "O problema não é apenas informação antiga. É a ausência de um ponto claro de atualização.",
   "caption": "O problema | não é apenas | informação antiga. | É a *ausência* | de um *ponto claro* | de atualização.",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "investigacao",
   "text": "Para encontrar o gargalo, escolha uma negociação recente e refaça seu percurso.",
   "caption": "Para encontrar | o *gargalo,* | escolha uma negociação | *recente* | e *refaça* | seu percurso.",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "investigacao",
   "text": "Quem recebeu?",
   "caption": "Quem *recebeu?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s16",
   "scene": "investigacao",
   "text": "Quem assumiu?",
   "caption": "Quem *assumiu?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s17",
   "scene": "investigacao",
   "text": "Onde ficaram as informações?",
   "caption": "Onde ficaram | as *informações?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s18",
   "scene": "investigacao",
   "text": "Quando aconteceu o último movimento?",
   "caption": "Quando aconteceu | o *último movimento?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s19",
   "scene": "investigacao",
   "text": "O que dependia de outra pessoa?",
   "caption": "O que *dependia* | de outra pessoa?",
   "pauseAfter": 0.3
  },
  {
   "id": "s20",
   "scene": "investigacao",
   "text": "Uma resposta vaga já indica onde vale investigar.",
   "caption": "Uma resposta *vaga* | já indica | onde vale *investigar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s21",
   "scene": "insight",
   "text": "Uma boa gestão não precisa acompanhar cada mensagem da equipe.",
   "caption": "Uma boa gestão | não precisa acompanhar | *cada mensagem* | da equipe.",
   "pauseAfter": 0.3
  },
  {
   "id": "s22",
   "scene": "insight",
   "text": "Precisa enxergar responsabilidades, etapas e pendências para agir quando algo sai do fluxo.",
   "caption": "Precisa *enxergar* | *responsabilidades,* | *etapas* | e *pendências* | para agir | quando algo | *sai do fluxo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s23",
   "scene": "cta",
   "text": "Se você quer conhecer um sistema personalizado para organizar imóveis, leads e atendimentos,",
   "caption": "Se você quer conhecer | um sistema *personalizado* | para organizar | *imóveis, leads* | e *atendimentos,*",
   "pauseAfter": 0.3
  },
  {
   "id": "s24",
