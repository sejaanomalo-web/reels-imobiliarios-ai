 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Muito proprietário tem medo de assinar exclusividade.",
   "caption": "Muito proprietário | tem *medo* | de assinar | *exclusividade.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E muito corretor pede exclusividade do jeito errado.",
   "caption": "E muito corretor | pede exclusividade | do jeito *errado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "A lei protege o corretor exclusivo.",
   "caption": "A lei *protege* | o corretor exclusivo.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "lei",
   "text": "Pelo Código Civil, se a exclusividade está por escrito, a comissão é devida mesmo se o dono vender sozinho.",
   "caption": "Pelo *Código Civil,* | se a exclusividade | está *por escrito,* | a comissão é *devida* | mesmo se o dono | vender *sozinho.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "condicao",
   "text": "Mas tem uma condição no fim do artigo: salvo se ficar provada a inércia do corretor.",
   "caption": "Mas tem uma *condição* | no fim do artigo: | salvo se ficar provada | a *inércia* | do corretor.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "Ou seja: a exclusividade não garante a comissão.",
   "caption": "Ou seja: | a exclusividade | *não garante* | a comissão.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "virada",
   "text": "Ela garante a chance de trabalhar.",
   "caption": "Ela garante | a *chance* | de *trabalhar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "plano",
   "text": "Por isso, peça exclusividade mostrando o plano: o que você vai fazer, em quanto tempo, e como vai prestar contas toda semana.",
   "caption": "Por isso, | peça exclusividade | mostrando o *plano:* | o que você vai *fazer,* | em quanto *tempo,* | e como vai | prestar *contas* | toda *semana.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "desfecho",
   "text": "Exclusividade não é posse do imóvel.",
   "caption": "Exclusividade | não é *posse* | do imóvel.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "É compromisso de trabalho por escrito.",
   "caption": "É *compromisso* | de trabalho | por escrito.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "caption": "Se você é *corretor,* | comente *SISTEMA* | e conheça nosso | sistema *personalizado.*",
   "pauseAfter": 0.3
  }
