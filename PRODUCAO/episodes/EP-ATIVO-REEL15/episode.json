 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quer transformar a comissão de um imóvel numa novela tributária?",
   "caption": "Quer transformar | a *comissão* | de um imóvel | numa *novela tributária?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Então deixa todos os documentos para resolver depois.",
   "caption": "Então deixa | todos os documentos | para resolver *depois.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "iro",
   "text": "Fechou parceria? Ótimo.",
   "caption": "Fechou *parceria?* | Ótimo.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "iro",
   "text": "Não registre quem fez o quê.",
   "caption": "*Não registre* | quem fez o quê.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "iro",
   "text": "Recebeu comissão? Melhor ainda: misture os comprovantes com os seus arquivos pessoais.",
   "caption": "Recebeu comissão? | Melhor ainda: | *misture* os comprovantes | com os seus | *arquivos pessoais.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "iro",
   "text": "E, quando alguém pedir documentação, tenta lembrar tudo pela conversa do WhatsApp.",
   "caption": "E, quando alguém | pedir documentação, | tenta *lembrar tudo* | pela conversa | do WhatsApp.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "iro",
   "text": "Perfeito para criar confusão.",
   "caption": "Perfeito | para criar *confusão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "real",
   "text": "Agora falando sério: forma de recebimento, divisão de comissões, emissão de documentos e possíveis tributos dependem da situação de cada profissional e das regras aplicáveis.",
   "caption": "Agora *falando sério:* | forma de *recebimento,* | *divisão* de comissões, | *emissão* de documentos | e possíveis *tributos* | dependem da situação | de cada profissional | e das regras aplicáveis.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "real",
   "text": "Não é assunto para resolver com uma dica viral de trinta segundos.",
   "caption": "Não é assunto | para resolver | com uma *dica viral* | de trinta segundos.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cuid",
   "text": "Uma atitude simples é manter contratos, comprovantes e informações organizadas, e levar as dúvidas a um contador que conheça sua atividade.",
   "caption": "Uma atitude simples | é manter *contratos,* | *comprovantes* | e *informações* organizadas, | e levar as dúvidas | a um *contador* | que conheça | sua atividade.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cuid",
   "text": "Boa gestão também significa saber quando não improvisar.",
   "caption": "Boa gestão | também significa | saber quando | *não improvisar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "fim",
   "text": "E confirme questões tributárias com seu contador.",
   "caption": "E *confirme* | questões tributárias | com seu *contador.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "fim",
   "text": "No dia a dia, ajuda ter cada negociação registrada.",
   "caption": "No dia a dia, | ajuda ter | cada negociação | *registrada.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
