      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "scene": "tensao",
      "text": "Não precisa de dez adjetivos. Precisa de critério.",
      "caption": "Não precisa | de *dez adjetivos.* | Precisa | de *critério.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "insight",
      "text": "Apresente poucas opções e diga por que escolheu cada uma.",
      "caption": "Apresente | *poucas opções* | e diga | *por que* escolheu | cada uma.",
      "pauseAfter": 0.3
    },
    {
      "id": "s7",
