 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Agendar toda visita que pedem pode parecer produtividade.",
   "caption": "*Agendar* | toda visita | que pedem | pode parecer | *produtividade.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Nem sempre é.",
   "caption": "*Nem sempre é.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Um interessado quer conhecer o apartamento, mas ainda não sabe se precisa de três quartos ou se aquele valor cabe no planejamento.",
   "caption": "Um *interessado* | quer conhecer | o apartamento, | mas ainda *não sabe* | se precisa | de *três quartos* | ou se aquele *valor* | cabe no *planejamento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "Antes de confirmar, alinhe o básico: características desejadas, faixa de investimento e objetivo da visita.",
   "caption": "Antes de confirmar, | alinhe o *básico:* | *características* desejadas, | *faixa* de investimento | e *objetivo* da visita.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Isso evita deslocamentos sem contexto.",
   "caption": "Isso *evita* | deslocamentos | *sem contexto.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Se estiver tudo alinhado, marque a visita.",
   "caption": "Se estiver | tudo *alinhado,* | *marque a visita.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Se não, ajude a pessoa a definir melhor o que busca.",
   "caption": "Se não, | *ajude* a pessoa | a *definir melhor* | o que busca.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Qualificação não precisa ser pressão.",
   "caption": "*Qualificação* | não precisa | ser *pressão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Para decidir isso, ajuda ter os critérios de cada comprador ao lado da agenda.",
   "caption": "Para decidir isso, | ajuda ter | os *critérios* | de cada comprador | ao lado da *agenda.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
