 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Ninguém te avisa quando um cliente desiste.",
   "caption": "*Ninguém* te avisa | quando um cliente | *desiste.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Ele simplesmente para de responder.",
   "caption": "Ele simplesmente | para de *responder.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Ontem, era: me manda mais opções.",
   "caption": "*Ontem,* era: | me manda | mais opções.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Hoje, silêncio.",
   "caption": "Hoje, | *silêncio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "E você já nem lembra qual foi a última conversa.",
   "caption": "E você já | nem *lembra* | qual foi | a *última conversa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t1",
   "text": "O áudio que você ia responder. A visita que ia remarcar.",
   "caption": "O *áudio* | que você | ia responder. | A *visita* | que ia remarcar.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Não faltou imóvel. Não faltou preço.",
   "caption": "Não faltou | *imóvel.* | Não faltou | *preço.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Faltou continuidade.",
   "caption": "Faltou | *continuidade.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t2",
   "text": "Um retorno esquecido vira uma semana. E uma semana vira: já comprei com outro corretor.",
   "caption": "Um retorno | *esquecido* | vira uma *semana.* | E uma semana | vira: | já comprei | com *outro corretor.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "O mercado não espera por quem esquece.",
   "caption": "O mercado | *não espera* | por quem *esquece.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Mas costuma recompensar quem acompanha: quem sabe o que cada cliente procura e qual é o próximo passo.",
   "caption": "Mas costuma | *recompensar* | quem *acompanha:* | quem sabe | o que | cada cliente | *procura* | e qual é | o *próximo passo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "x",
   "text": "Venda não é sorte. É memória organizada.",
   "caption": "Venda | não é *sorte.* | É *memória organizada.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
