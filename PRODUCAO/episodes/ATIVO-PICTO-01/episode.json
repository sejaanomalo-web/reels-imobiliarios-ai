 "diagnostico": {
  "publico_situacao": "corretor que perde clientes por falta de retorno e não percebe",
  "motivacao": "dor silenciosa: o cliente não avisa que desistiu",
  "crenca_questionada": "'perdi por preço/imóvel'",
  "hipotese": "pictograma noir: cliente some (silêncio) → memórias que se apagam (áudio, visita) → não faltou imóvel nem preço, faltou continuidade → retorno esquecido vira 'comprei com outro' → quem acompanha (o que procura, próximo passo) → memória organizada",
  "funcao": "reflexão + virada",
  "promessa": "entender que continuidade (memória organizada) decide a venda",
  "evidencias": "roteiro opinativo, sem números ou dados de mercado; prazos ('uma semana') ilustrativos",
