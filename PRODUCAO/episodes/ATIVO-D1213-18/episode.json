  {
   "id": "s2",
   "scene": "paredao",
   "text": "Era um paredão de quase quarenta andares, sem recuo, e as ruas em volta perderam o sol.",
   "caption": "Era um *paredão* | de quase | *quarenta andares,* | sem recuo, | e as ruas em volta | perderam o *sol.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "lei",
   "text": "No ano seguinte, veio a primeira lei de zoneamento da cidade, com recuos para a luz chegar à rua.",
   "caption": "No ano seguinte, | veio a primeira | lei de *zoneamento* | da cidade, | com *recuos* | para a luz | chegar à rua.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Os vizinhos tinham comprado luz. E perderam por causa do terreno ao lado.",
   "caption": "Os vizinhos | tinham comprado *luz.* | E *perderam* | por causa | do terreno ao lado.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Antes de vender a vista ou o sol, confira o que a lei permite construir no terreno vizinho.",
   "caption": "Antes de vender | a *vista* ou o sol, | *confira* | o que a lei | permite *construir* | no terreno *vizinho.*",
