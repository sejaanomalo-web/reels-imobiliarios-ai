 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Juro mais baixo sempre significa imóvel mais barato?",
   "caption": "*Juro* mais baixo | sempre significa | imóvel *mais barato?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "A resposta depende de uma coisa que muita apresentação esquece.",
   "caption": "A resposta *depende* | de uma coisa | que muita apresentação | *esquece.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "a",
   "text": "Imagina um momento de crédito mais caro.",
   "caption": "Imagina um momento | de *crédito mais caro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "a",
   "text": "Parte dos compradores financia menos, alguns adiam planos e certos vendedores podem ficar mais abertos à negociação.",
   "caption": "Parte dos compradores | *financia menos,* | alguns *adiam* planos | e certos *vendedores* | podem ficar | mais *abertos* | à negociação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "a",
   "text": "Mas isso muda conforme a região, o tipo de imóvel e a necessidade de cada lado.",
   "caption": "Mas isso *muda* | conforme a *região,* | o *tipo de imóvel* | e a *necessidade* | de cada lado.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "b",
   "text": "Agora imagina crédito mais acessível.",
   "caption": "Agora imagina | crédito *mais acessível.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "b",
   "text": "Mais pessoas podem começar a procurar, e em alguns segmentos essa procura aumenta a concorrência pelos imóveis.",
   "caption": "Mais pessoas | podem começar | a *procurar,* | e em alguns segmentos | essa procura | aumenta a *concorrência* | pelos imóveis.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "b",
   "text": "Não quer dizer que todo preço sobe ou que toda negociação fica pior.",
   "caption": "Não quer dizer | que *todo preço sobe* | ou que toda negociação | *fica pior.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "b",
   "text": "Quer dizer que o contexto mudou.",
   "caption": "Quer dizer | que o *contexto mudou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "ap",
   "text": "É por isso que uma boa orientação não começa com “compra agora” ou “espera cair”.",
   "caption": "É por isso | que uma boa *orientação* | não começa com | *“compra agora”* | ou *“espera cair”.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "ap",
   "text": "Começa perguntando: vai financiar? Qual prazo? Qual margem de negociação? E quais custos já foram verificados?",
   "caption": "Começa perguntando: | vai *financiar?* | Qual *prazo?* | Qual *margem* | de negociação? | E quais *custos* | já foram verificados?",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "ap",
   "text": "Uma conversa responsável vale mais que uma previsão confiante.",
   "caption": "Uma conversa *responsável* | vale mais | que uma *previsão confiante.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "fim",
   "text": "Antes de usar juros como argumento de venda, confira os dados do momento e o perfil do comprador.",
   "caption": "Antes de usar juros | como *argumento* de venda, | confira os *dados do momento* | e o *perfil* do comprador.",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "fim",
   "text": "E para lembrar o que cada comprador respondeu, ajuda ter cada atendimento registrado.",
   "caption": "E para lembrar | o que cada comprador | *respondeu,* | ajuda ter | cada atendimento | *registrado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
