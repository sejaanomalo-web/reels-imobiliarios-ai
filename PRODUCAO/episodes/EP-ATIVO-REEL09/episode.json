 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se eu começasse do zero vendendo imóveis hoje, não tentaria aparecer para a cidade inteira.",
   "caption": "Se eu começasse | do *zero* | vendendo imóveis hoje, | não tentaria aparecer | para a *cidade inteira.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Começaria com um problema bem específico.",
   "caption": "Começaria | com um problema | bem *específico.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "pub",
   "text": "Escolheria um tipo de comprador e um imóvel que realmente combine com ele.",
   "caption": "Escolheria | um tipo de *comprador* | e um *imóvel* | que realmente | combine com ele.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "pub",
   "text": "Em vez de publicar só fotos bonitas, gravaria um vídeo respondendo às dúvidas mais prováveis daquela pessoa: espaço, localização, circulação e condições confirmadas.",
   "caption": "Em vez de publicar | só *fotos bonitas,* | gravaria um vídeo | respondendo às *dúvidas* | mais prováveis | daquela pessoa: | *espaço,* | *localização,* | *circulação* | e condições *confirmadas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "passo",
   "text": "Depois, faria a chamada combinar com o vídeo.",
   "caption": "Depois, | faria a *chamada* | combinar com o vídeo.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "passo",
   "text": "Quem quer comparar opções recebe um caminho para conversar.",
   "caption": "Quem quer *comparar* opções | recebe um caminho | para *conversar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "passo",
   "text": "Quem quer conhecer recebe as condições para agendar.",
   "caption": "Quem quer *conhecer* | recebe as condições | para *agendar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "passo",
   "text": "E todo interessado precisa ter seu pedido registrado com clareza, mesmo quando a resposta não é imediata.",
   "caption": "E todo interessado | precisa ter seu pedido | *registrado* com clareza, | mesmo quando a resposta | *não é imediata.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "cont",
   "text": "A parte mais importante vem depois: marcar quem recebeu informações, quem ficou de responder e quando vale retomar a conversa.",
   "caption": "A parte | mais *importante* | vem depois: | marcar quem *recebeu* | informações, | quem ficou | de *responder* | e quando vale | *retomar* a conversa.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cont",
   "text": "Não é o anúncio sozinho que faz o processo funcionar.",
   "caption": "Não é o *anúncio* sozinho | que faz o processo | funcionar.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cont",
   "text": "É o encaixe entre conteúdo, atendimento e acompanhamento.",
   "caption": "É o *encaixe* | entre *conteúdo,* | *atendimento* | e *acompanhamento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
