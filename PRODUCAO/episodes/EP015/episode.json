  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "Uma conversa boa pode não gerar venda.",
      "caption": "Uma *conversa boa* | pode não | gerar *venda.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s2",
      "scene": "hook",
      "text": "Mas não deveria terminar sem um próximo passo claro.",
      "caption": "Mas não deveria | terminar | sem um | *próximo passo* | *claro.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s3",
      "scene": "situacao",
      "text": "Você mostrou as opções, respondeu dúvidas e o cliente ficou de analisar.",
      "caption": "Você mostrou | as *opções,* | respondeu *dúvidas* | e o cliente | ficou de *analisar.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s4",
      "scene": "situacao",
      "text": "Se ninguém combina o que acontece depois, a oportunidade fica sem acompanhamento.",
      "caption": "Se *ninguém combina* | o que acontece | *depois,* | a oportunidade | fica sem | *acompanhamento.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s5",
      "scene": "tensao",
      "text": "Antes de encerrar, pergunte:",
      "caption": "Antes de *encerrar,* | *pergunte:*",
      "pauseAfter": 0.15
    },
    {
      "id": "s6",
      "scene": "tensao",
      "text": "prefere que eu retorne na sexta ou você quer falar comigo quando analisar?",
      "caption": "prefere que eu | *retorne na sexta* | ou você | quer falar comigo | quando *analisar?*",
      "pauseAfter": 0.15
    },
    {
      "id": "s7",
      "scene": "tensao",
      "text": "Respeite a resposta.",
      "caption": "*Respeite* | a resposta.",
      "pauseAfter": 0.15
    },
    {
      "id": "s8",
      "scene": "insight",
      "text": "Depois registre data, assunto e expectativa.",
      "caption": "Depois *registre* | *data,* | *assunto* | e *expectativa.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s9",
      "scene": "insight",
      "text": "Parece pequeno, mas diferencia conversa encerrada de conversa acompanhada.",
      "caption": "Parece pequeno, | mas diferencia | conversa *encerrada* | de conversa *acompanhada.*",
      "pauseAfter": 0.15
    },
    {
      "id": "s10",
      "scene": "cta",
      "text": "Se você quer manter esses próximos passos organizados,",
      "caption": "Se você quer | manter esses | *próximos passos* | *organizados,*",
      "pauseAfter": 0.15
    },
    {
      "id": "s11",
      "scene": "cta",
      "text": "veja nosso sistema imobiliário personalizado no link da bio.",
      "caption": "veja nosso | sistema imobiliário | *personalizado* | no *link da bio.*",
      "pauseAfter": 0.15
    }
  ],
  "sceneLead": {
