  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "O lead não sumiu.",
      "caption": "O lead | *não sumiu.*",
      "pauseAfter": 0.26
    },
    {
      "id": "s2",
      "scene": "hook",
      "text": "O histórico é que sumiu.",
      "caption": "O *histórico* | é que sumiu.",
      "pauseAfter": 0.62
    },
    {
      "id": "s3",
      "scene": "situacao",
      "text": "Um comprador pediu um apartamento de dois quartos.",
      "caption": "Um comprador pediu | um apartamento | de *dois quartos.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s4",
      "scene": "situacao",
      "text": "Você enviou opções, conversou sobre a localização e deixou a conversa aberta.",
      "caption": "Você enviou opções, | conversou sobre | a *localização* | e deixou | a conversa *aberta.*",
      "pauseAfter": 0.62
    },
    {
      "id": "s5",
      "scene": "tensao",
      "text": "A semana encheu de visitas.",
      "caption": "A semana encheu | de *visitas.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "tensao",
      "text": "Quando apareceu o imóvel perfeito, você lembrava do apartamento, mas não do nome de quem procurava.",
      "caption": "Quando apareceu | o *imóvel perfeito,* | você lembrava | do apartamento, | mas não do *nome* | de quem procurava.",
      "pauseAfter": 0.66
    },
    {
      "id": "s7",
      "scene": "insight",
      "text": "Um contato útil precisa de três registros: o que procura, em que etapa está e qual é o próximo retorno.",
      "caption": "Um contato útil | precisa de | *três registros:* | o que *procura,* | em que *etapa* está | e qual é o | *próximo retorno.*",
      "pauseAfter": 0.38
    },
    {
      "id": "s8",
      "scene": "insight",
      "text": "Sem isso, até uma boa oportunidade pode ficar esquecida.",
      "caption": "Sem isso, | até uma boa | oportunidade | pode ficar *esquecida.*",
      "pauseAfter": 0.66
    },
    {
      "id": "s9",
      "scene": "cta",
      "text": "Quer acompanhar esse histórico em um sistema feito para sua rotina?",
      "caption": "Quer acompanhar | esse *histórico* | em um sistema | feito para | *sua rotina?*",
      "pauseAfter": 0.32
    },
    {
      "id": "s10",
      "scene": "cta",
      "text": "Conheça nosso sistema imobiliário personalizado no link da bio e agende uma demonstração.",
      "caption": "Conheça nosso | sistema imobiliário | *personalizado* | no *link da bio* | e agende uma | *demonstração.*",
      "pauseAfter": 0
    }
