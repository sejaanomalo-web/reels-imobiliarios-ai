 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A foto do anúncio não vende o imóvel. Ela vende a visita.",
   "caption": "A *foto* do anúncio | não vende o *imóvel.* | Ela vende | a *visita.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "promessa",
   "text": "E se a foto prometer mais do que o imóvel entrega, a venda morre na porta.",
   "caption": "E se a foto | *prometer mais* | do que o imóvel entrega, | a venda | *morre na porta.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "promessa",
   "text": "Lente que estica a sala, céu trocado, ângulo que esconde a parede.",
   "caption": "*Lente* | que estica a sala, | *céu* trocado, | *ângulo* | que esconde a parede.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "porta",
   "text": "O cliente chega esperando um imóvel e encontra outro.",
   "caption": "O cliente chega | esperando um imóvel | e encontra *outro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "porta",
   "text": "Daí em diante, ele procura o defeito em tudo.",
   "caption": "Daí em diante, | ele procura | o *defeito* | em *tudo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "virada",
   "text": "O contrário também acontece.",
   "caption": "O *contrário* | também acontece.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "virada",
   "text": "Quando a foto é honesta, o cliente chega com a expectativa certa, e o imóvel tem chance de surpreender.",
   "caption": "Quando a foto | é *honesta,* | o cliente chega | com a *expectativa certa,* | e o imóvel | tem chance | de *surpreender.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "guardar",
   "text": "Por isso, mostre o imóvel como ele é.",
   "caption": "Por isso, | *mostre* o imóvel | *como ele é.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "guardar",
   "text": "E guarde uma coisa boa para ver ao vivo: a luz da tarde, a vista, o silêncio.",
   "caption": "E *guarde* | uma coisa boa | para ver *ao vivo:* | a *luz* da tarde, | a *vista,* | o *silêncio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Visita boa é a que fica maior que a foto.",
   "caption": "Visita boa | é a que fica | *maior que a foto.*",
