 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O corretor do futuro não é aquele que usa mais aplicativos.",
   "caption": "O corretor do futuro | *não é aquele* | que usa | *mais aplicativos.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "É aquele que consegue dar continuidade ao atendimento sem perder o contexto.",
   "caption": "É aquele que consegue | dar *continuidade* | ao atendimento | *sem perder o contexto.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "No encontro do Secovi, o setor discutiu ferramentas digitais, gestão de leads e novas jornadas de compra.",
   "caption": "No encontro do Secovi, | o setor discutiu | *ferramentas digitais,* | *gestão de leads* | e *novas jornadas* | de compra.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Mas digitalizar não é espalhar informação em cinco lugares diferentes.",
   "caption": "Mas *digitalizar* | não é *espalhar informação* | em *cinco lugares* | diferentes.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Pensa no processo: o lead chega, você entende o que procura, registra as opções apresentadas, combina o próximo passo e acompanha a decisão.",
   "caption": "Pensa no *processo:* | o *lead chega,* | você *entende* | o que procura, | *registra as opções* | apresentadas, | *combina o próximo passo* | e *acompanha a decisão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Se uma dessas etapas some, a tecnologia não resolveu o problema.",
   "caption": "Se uma dessas etapas | *some,* | a tecnologia | *não resolveu* | o problema.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O diferencial não é ter um sistema cheio de funções.",
   "caption": "O diferencial | não é ter | um sistema | *cheio de funções.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "É encontrar uma forma de trabalhar que faça sentido para você, com informações acessíveis quando precisar atender o cliente.",
   "caption": "É encontrar | uma *forma de trabalhar* | que faça sentido | *para você,* | com informações | *acessíveis* | quando precisar | atender o cliente.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Processo primeiro, ferramenta depois.",
   "caption": "*Processo primeiro,* | *ferramenta depois.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
