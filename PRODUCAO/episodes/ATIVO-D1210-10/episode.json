  },
  {
   "id": "s2",
   "scene": "mistura",
   "text": "No décimo, ele já não lembra do terceiro. E começa a misturar a cozinha de um com a varanda do outro.",
   "caption": "No *décimo,* | ele já não lembra | do *terceiro.* | E começa a *misturar* | a *cozinha* de um | com a *varanda* do outro.",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "erro",
   "text": "Mais visita não é mais escolha. É mais confusão.",
   "caption": "Mais visita | *não é* mais escolha. | É mais *confusão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "virada",
   "text": "Antes, peça as três coisas de que ele não abre mão. E corte o que não passa.",
   "caption": "*Antes,* | peça as *três coisas* | de que ele | não abre mão. | E *corte* | o que não passa.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "acao",
   "text": "Leve três, quatro no máximo, e anote na saída o que ele achou de cada um.",
   "caption": "Leve *três,* | *quatro* no máximo, | e *anote* na saída | o que ele achou | de cada um.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "desfecho",
   "text": "Menos portas abertas, mais decisão.",
   "caption": "Menos *portas* abertas, | mais *decisão.*",
