 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Por que um apartamento de um quarto pode ter metro quadrado mais caro do que um de três?",
   "caption": "Por que | um apartamento | de *um quarto* | pode ter | metro quadrado | *mais caro* | do que um de *três?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Porque o tamanho não conta a história inteira.",
   "caption": "Porque o *tamanho* | não conta | a *história inteira.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Em alguns recortes do mercado, unidades menores têm preço por metro quadrado maior.",
   "caption": "Em alguns *recortes* | do mercado, | unidades *menores* | têm preço | por metro quadrado | *maior.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Localização, padrão, oferta e o perfil de quem compra podem mudar essa relação.",
   "caption": "*Localização,* | *padrão,* | *oferta* | e o *perfil* | de quem compra | podem mudar | essa relação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Agora imagine um investidor comparando só preço por metro.",
   "caption": "Agora imagine | um *investidor* | comparando só | *preço por metro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Ele pode ignorar condomínio, vacância, mobília e custo de manutenção.",
   "caption": "Ele pode ignorar | *condomínio,* | *vacância,* | *mobília* | e custo | de *manutenção.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "E o comprador que vai morar pode ter prioridades completamente diferentes.",
   "caption": "E o comprador | que vai *morar* | pode ter | *prioridades* | completamente | diferentes.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de recomendar, pergunte para que o imóvel será usado.",
   "caption": "Antes de recomendar, | pergunte | *para que* | o imóvel | será usado.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Depois, compare custo total, funcionalidade e alternativas reais da região.",
   "caption": "Depois, compare | *custo total,* | *funcionalidade* | e *alternativas reais* | da região.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Metro quadrado ajuda, mas não decide sozinho.",
   "caption": "Metro quadrado | *ajuda,* | mas não decide | *sozinho.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Comece pela finalidade; o metro vem depois.",
   "caption": "Comece | pela *finalidade;* | o metro | vem *depois.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
