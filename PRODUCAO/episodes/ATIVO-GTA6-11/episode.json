  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "Se eu tivesse de escolher o endereço mais estranho de Leonida, eu começaria pelos pântanos.",
      "caption": "Se eu tivesse | de escolher | o endereço | mais *estranho* | de Leonida, | eu começaria | pelos *pântanos.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s2",
      "scene": "t1",
      "text": "Quando se fala em GTA VI, todo mundo pensa na praia de Vice City e nos prédios enormes.",
      "caption": "Quando se fala | em GTA VI, | todo mundo pensa | na *praia* | de Vice City | e nos *prédios* enormes.",
      "pauseAfter": 0.3
    },
    {
      "id": "s3",
      "scene": "t2",
      "text": "Só que o mapa também tem os Grassrivers, uma região de natureza e áreas alagadas.",
      "caption": "Só que o mapa | também tem | os *Grassrivers,* | uma região | de *natureza* | e áreas *alagadas.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s4",
      "scene": "t2",
      "text": "É o completo oposto da vida noturna, do trânsito e dos outdoors da cidade.",
      "caption": "É o completo *oposto* | da vida noturna, | do trânsito | e dos *outdoors* | da cidade.",
      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "scene": "t3",
      "text": "Agora imagina vender uma casa por lá. A descrição seria “contato direto com a natureza”, mas eu perguntaria primeiro: direto com qual natureza?",
      "caption": "Agora imagina | *vender* | uma casa por lá. | A descrição seria | “contato *direto* | com a natureza”, | mas eu perguntaria | primeiro: | direto com | *qual* natureza?",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "t3",
      "text": "Porque uma coisa é ter vista para o verde. Outra é descobrir quem está olhando para você de dentro da água.",
      "caption": "Porque uma coisa | é ter vista | para o *verde.* | Outra é descobrir | *quem* está olhando | para você | de dentro | da *água.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s7",
      "scene": "t3",
      "text": "Na vida real, anúncio bom antecipa as perguntas.",
      "caption": "Na vida real, | anúncio bom | *antecipa* | as perguntas.",
      "pauseAfter": 0.3
    },
    {
      "id": "s8",
      "scene": "cta",
      "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
      "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
      "pauseAfter": 0.3
    },
    {
      "id": "s9",
      "scene": "cta",
      "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
      "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
      "pauseAfter": 0.3
    }
  ],
