 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Ofereceram cerca de 1 milhão de dólares por essa casinha.",
   "caption": "Ofereceram | cerca de | *1 milhão* | de dólares | por essa *casinha.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "A dona disse não.",
   "caption": "A dona | disse *não.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "E o prédio foi construído em volta dela.",
   "caption": "E o *prédio* | foi construído | em *volta* dela.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "retrato",
   "text": "Seattle, 2006.",
   "caption": "*Seattle,* | 2006.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "retrato",
   "text": "Edith Macefield tinha 84 anos e morava ali fazia décadas.",
   "caption": "*Edith Macefield* | tinha *84 anos* | e morava ali | fazia *décadas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "ofertas",
   "text": "Uma construtora queria o terreno para um centro comercial.",
   "caption": "Uma *construtora* | queria o terreno | para um centro | *comercial.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "ofertas",
   "text": "As ofertas subiram. Ela recusou todas.",
   "caption": "As ofertas | *subiram.* | Ela recusou | *todas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "cerco",
   "text": "A obra seguiu. E a casinha ficou ali, cercada de concreto.",
   "caption": "A obra | *seguiu.* | E a casinha | ficou ali, | cercada | de *concreto.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Foi aí que aconteceu o que ninguém esperava.",
   "caption": "Foi aí | que aconteceu | o que *ninguém* | esperava.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "virada",
   "text": "O chefe da obra, Barry Martin, começou a passar lá.",
   "caption": "O *chefe da obra,* | Barry Martin, | começou | a *passar* lá.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "virada",
   "text": "Levava compras, levava ela ao médico, cuidava dela.",
   "caption": "Levava *compras,* | levava ela | ao *médico,* | *cuidava* dela.",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "heranca",
   "text": "Quando Edith morreu, em 2008, deixou a casa para ele.",
   "caption": "Quando Edith morreu, | em 2008, | *deixou a casa* | para ele.",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "desfecho",
   "text": "A casa que ninguém conseguiu comprar ficou com quem nunca tentou.",
   "caption": "A casa | que ninguém | conseguiu *comprar* | ficou com quem | *nunca tentou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "desfecho",
   "text": "Quando o proprietário recusa um bom preço, quase nunca é sobre dinheiro.",
   "caption": "Quando o proprietário | *recusa* | um bom preço, | quase nunca | é sobre *dinheiro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "desfecho",
   "text": "É sobre confiança.",
   "caption": "É sobre | *confiança.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "caption": "Se você é *corretor,* | comente *SISTEMA* | e conheça nosso | sistema *personalizado.*",
   "pauseAfter": 0.3
  }
