 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma mulher passou 36 anos reformando a mesma casa.",
   "caption": "Uma mulher | passou *36 anos* | reformando | a *mesma casa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Quando ela morreu, a casa foi avaliada como quase sem valor.",
   "caption": "Quando ela morreu, | a casa foi avaliada | como *quase sem valor.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "inicio",
   "text": "Sarah Winchester comprou uma casa de fazenda de oito cômodos na Califórnia, em 1886.",
   "caption": "*Sarah Winchester* | comprou uma casa de fazenda | de *oito cômodos* | na Califórnia, | em *1886.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "inicio",
   "text": "E nunca parou de reformar.",
   "caption": "E *nunca parou* | de reformar.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "obra",
   "text": "Sem arquiteto. Ela desenhava os cômodos em pedaços de papel, e os carpinteiros construíam.",
   "caption": "*Sem arquiteto.* | Ela desenhava os cômodos | em pedaços de *papel,* | e os carpinteiros | construíam.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "obra",
   "text": "O que não dava certo era fechado ou derrubado.",
   "caption": "O que não dava certo | era *fechado* | ou *derrubado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "estranho",
   "text": "No fim, eram 160 cômodos. Uma escada que termina no teto. Uma porta no segundo andar que abre para o vazio.",
   "caption": "No fim, | eram *160 cômodos.* | Uma *escada* | que termina no *teto.* | Uma *porta* | no segundo andar | que abre para o *vazio.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Em 1922, os avaliadores olharam a obra inacabada e os estragos do terremoto.",
   "caption": "Em *1922,* | os avaliadores olharam | a obra *inacabada* | e os estragos | do *terremoto.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Para morar, ela quase não valia nada. Foi a leilão e virou atração turística.",
   "caption": "Para morar, | ela quase | *não valia nada.* | Foi a *leilão* | e virou | atração turística.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "licao",
   "text": "Dinheiro na obra não vira valor sozinho. Comprador paga por casa que faz sentido.",
   "caption": "*Dinheiro* na obra | não vira valor | *sozinho.* | Comprador paga | por casa | que faz *sentido.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Quando o dono disser quanto gastou na reforma, pergunte o que ela resolveu.",
   "caption": "Quando o dono disser | quanto *gastou* | na reforma, | *pergunte* | o que ela *resolveu.*",
   "pauseAfter": 0.3
  },
