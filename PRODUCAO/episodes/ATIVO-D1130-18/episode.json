 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "E se todo anúncio de imóvel tivesse que mostrar quanto você vai gastar de luz?",
   "caption": "E se todo *anúncio* | de imóvel | tivesse que mostrar | quanto você vai gastar | de *luz?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "regra",
   "text": "Parece exagero, mas na França isso já é regra.",
   "caption": "Parece *exagero,* | mas na *França* | isso já é *regra.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "regra",
   "text": "Desde 2022, o anúncio mostra o gasto anual estimado de energia, com letra do mesmo tamanho do resto.",
   "caption": "Desde *2022,* | o anúncio mostra | o *gasto anual* | estimado de energia, | com letra | do *mesmo tamanho* | do resto.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "nota",
   "text": "E o imóvel ganha uma nota, de A a G.",
   "caption": "E o imóvel | ganha uma *nota,* | de *A a G.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "nota",
   "text": "Os piores precisam avisar no anúncio: consumo de energia excessivo.",
   "caption": "Os *piores* | precisam *avisar* | no anúncio: | consumo de energia | *excessivo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "calendario",
   "text": "E tem mais. Desde 2025, imóvel nota G não pode entrar em contrato novo de aluguel.",
   "caption": "E tem mais. | Desde *2025,* | imóvel nota *G* | não pode entrar | em contrato novo | de *aluguel.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "calendario",
   "text": "Em 2028, entra a nota F. E em 2034, a próxima da escala.",
   "caption": "Em *2028,* | entra a nota *F.* | E em *2034,* | a próxima | da escala.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "virada",
   "text": "Ou seja: lá, o custo de morar entrou na vitrine.",
   "caption": "Ou seja: | lá, | o *custo de morar* | entrou na *vitrine.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "virada",
   "text": "Aqui, o comprador costuma descobrir a conta de luz, o condomínio e o IPTU depois que já se apaixonou.",
   "caption": "Aqui, | o comprador | costuma descobrir | a conta de *luz,* | o *condomínio* | e o *IPTU* | depois que | já se *apaixonou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "desfecho",
   "text": "Ninguém te obriga a mostrar isso.",
   "caption": "Ninguém | te *obriga* | a mostrar isso.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "desfecho",
   "text": "Mas o corretor que mostra o custo de morar antes de o cliente perguntar ganha o que foto nenhuma dá: confiança.",
   "caption": "Mas o corretor | que mostra | o custo de morar | *antes* | de o cliente perguntar | ganha o que | *foto* nenhuma dá: | *confiança.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Se você é corretor, comente SISTEMA e conheça nosso sistema personalizado.",
   "caption": "Se você é *corretor,* | comente *SISTEMA* | e conheça nosso | sistema *personalizado.*",
   "pauseAfter": 0.3
  }
 ],
