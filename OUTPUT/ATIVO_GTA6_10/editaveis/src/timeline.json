 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Eu tenho certeza de que um corretor de Vice City não aguentaria uma semana de atendimento.",
   "start": 0.2,
   "end": 5.71
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "O primeiro lead pede uma casa próxima da praia.",
   "start": 6.04,
   "end": 8.45
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "O segundo quer uma cobertura com estacionamento para helicóptero.",
   "start": 8.68,
   "end": 11.75
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "O terceiro pergunta se a rua é segura.",
   "start": 12.12,
   "end": 14.39
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Aí o corretor abre a janela e vê uma perseguição passando na frente do imóvel que acabou de cadastrar.",
   "start": 14.68,
   "end": 19.99
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Ele responde: “a localização é excelente, mas a movimentação varia bastante conforme o nível de procurado”.",
   "start": 20.36,
   "end": 26.35
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "No fechamento do mês, não faltou visita. Faltou comprador disposto a sair do carro.",
   "start": 26.76,
   "end": 31.88
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Na vida real, plantão cheio pede lead organizado.",
   "start": 32.2,
   "end": 35.25
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 35.56,
   "end": 39.89
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 40.179,
   "end": 43.01
  }
 ],
