 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se alguém te prometeu que a inteligência artificial vai vender seus imóveis sozinha, faça uma pergunta.",
   "start": 0.12,
   "end": 5.51
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Quem vai entender a necessidade do comprador, negociar condições reais e assumir a responsabilidade pelo atendimento?",
   "start": 5.96,
   "end": 12.72
  },
  {
   "id": "s3",
   "scene": "t2",
   "text": "A tecnologia pode ajudar em tarefas e organização, quando a ferramenta e o processo permitem.",
   "start": 13.08,
   "end": 18.16
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Mas ela não substitui o julgamento comercial nem cria confiança automaticamente.",
   "start": 18.52,
   "end": 23.25
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Antes de adotar uma automação, defina a tarefa, o limite da ferramenta e quem responde quando algo exige decisão humana.",
   "start": 23.56,
   "end": 31.21
  },
  {
   "id": "s6",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 31.56,
   "end": 36.44
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 36.76,
   "end": 39.88
  }
 ],
