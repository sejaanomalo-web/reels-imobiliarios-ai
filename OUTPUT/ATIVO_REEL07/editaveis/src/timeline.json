 ],
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dois profissionais chegam para captar o mesmo sobrado.",
   "start": 0.2,
   "end": 2.98
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Um oferece anúncio.",
   "start": 3.24,
   "end": 4.52
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "O outro chega com um plano.",
   "start": 4.68,
   "end": 6.14
  },
  {
   "id": "s4",
   "scene": "prim",
   "text": "Na primeira conversa, o profissional elogia a casa, tira algumas fotos e promete divulgar.",
   "start": 6.52,
   "end": 11.3
  },
  {
   "id": "s5",
   "scene": "prim",
   "text": "Mas não explica para quem o imóvel é indicado, como vai apresentar os ambientes nem quais informações ainda precisa confirmar.",
   "start": 11.64,
   "end": 17.98
  },
  {
   "id": "s6",
   "scene": "prim",
   "text": "O proprietário escuta uma proposta genérica.",
   "start": 18.36,
   "end": 20.75
  },
  {
   "id": "s7",
   "scene": "seg",
   "text": "Na segunda, o profissional começa verificando os dados do imóvel, pesquisando referências de mercado e organizando uma apresentação adequada.",
   "start": 21.16,
   "end": 27.99
  },
  {
   "id": "s8",
   "scene": "seg",
   "text": "Explica quais materiais pretende produzir, como fará os retornos e quais próximos passos precisam ser combinados.",
   "start": 28.28,
   "end": 34.28
  },
  {
   "id": "s9",
   "scene": "porque",
   "text": "O proprietário não consegue garantir o resultado da venda.",
   "start": 34.6,
   "end": 37.67
  },
  {
   "id": "s10",
   "scene": "porque",
   "text": "Mas consegue avaliar a clareza do processo e a preparação de quem vai representá-lo.",
   "start": 37.88,
   "end": 42.36
  },
  {
   "id": "s11",
   "scene": "porque",
   "text": "É isso que diferencia um simples pedido de captação de uma proposta profissional.",
   "start": 42.36,
   "end": 46.66
  },
  {
   "id": "s12",
   "scene": "aplic",
   "text": "Na sua próxima captação, leve menos adjetivos e mais clareza.",
   "start": 47.16,
   "end": 51.14
  },
  {
   "id": "s13",
   "scene": "aplic",
   "text": "E para mostrar seu processo ao proprietário, ajuda ter cada etapa da captação organizada.",
   "start": 51.56,
   "end": 56.21
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 56.52,
   "end": 61.06
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 61.429,
   "end": 64.3
  }
 ],
