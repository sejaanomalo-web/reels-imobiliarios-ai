 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se um cliente parou de responder, não comece com aquele clássico: alguma novidade?",
   "start": 0.12,
   "end": 4.5
  },
  {
   "id": "s2",
   "scene": "situacao",
   "text": "Você pode retomar com algo específico:",
   "start": 4.76,
   "end": 6.64
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "vi uma opção na região que você mencionou.",
   "start": 6.76,
   "end": 8.84
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "Ainda faz sentido procurar por ali?",
   "start": 8.84,
   "end": 10.35
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "A primeira mensagem cobra uma decisão sem contexto.",
   "start": 10.76,
   "end": 13.4
  },
  {
   "id": "s6",
   "scene": "tensao",
   "text": "A segunda lembra a necessidade da pessoa e permite que ela atualize a busca.",
   "start": 13.56,
   "end": 17.62
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Não envie ofertas aleatórias para toda a base.",
   "start": 17.96,
   "end": 20.46
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Retome somente quando existir contexto, e respeite quem não quiser mais receber contato.",
   "start": 20.76,
   "end": 24.81
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Retomar com contexto exige ter o histórico de cada cliente à mão.",
   "start": 25.24,
   "end": 28.71
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 29.0,
   "end": 33.17
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 33.509,
   "end": 36.33
  }
 ],
