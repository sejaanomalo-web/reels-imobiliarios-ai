 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Eu acho que muita gente ainda não percebeu: GTA VI não se resume a Vice City.",
   "start": 0.2,
   "end": 5.16
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "A cidade é a grande estrela, mas o jogo se passa em Leonida, um estado fictício muito maior em variedade de paisagens.",
   "start": 5.48,
   "end": 12.22
  },
  {
   "id": "s3",
   "scene": "t2",
   "text": "A própria Rockstar apresenta regiões com identidades bem diferentes: Leonida Keys, Grassrivers, Port Gellhorn, Ambrosia e Mount Kalaga.",
   "start": 12.52,
   "end": 20.29
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Tem cenário urbano, litoral, pântano e interior.",
   "start": 20.52,
   "end": 23.41
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Pra quem gosta de explorar, isso muda tudo.",
   "start": 23.72,
   "end": 26.0
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Não é como escolher entre dois prédios na mesma rua. É mudar completamente de estilo de vida a cada viagem.",
   "start": 26.2,
   "end": 31.94
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Eu começaria pelo mar, mas tenho certeza de que acabaria perdido no interior procurando uma vista melhor.",
   "start": 32.2,
   "end": 37.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Na vida real, cada região atrai um perfil diferente.",
   "start": 37.56,
   "end": 40.11
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.28,
   "end": 44.52
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 44.848,
   "end": 47.32
  }
 ],
