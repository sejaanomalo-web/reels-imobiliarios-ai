 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Uma incorporadora de alto padrão sinalizou que vai lançar menos em dois mil e vinte e sete.",
   "caption": "Uma incorporadora | de *alto padrão* | sinalizou que vai | *lançar menos* | em *dois mil e vinte e sete.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Isso quer dizer que o mercado de luxo acabou?",
   "caption": "Isso quer dizer | que o *mercado de luxo* | *acabou?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Não.",
   "caption": "*Não.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "A notícia sobre a Eztec fala de uma decisão de uma empresa num segmento e numa cidade específicos.",
   "caption": "A notícia | sobre a *Eztec* | fala de uma decisão | de *uma empresa* | num *segmento* | e numa *cidade* | específicos.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Incorporadoras precisam equilibrar unidades disponíveis, velocidade de vendas e novos projetos.",
   "caption": "Incorporadoras | precisam *equilibrar* | *unidades disponíveis,* | *velocidade de vendas* | e *novos projetos.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Imagine uma construtora que tem unidades ainda à venda.",
   "caption": "Imagine | uma construtora | que tem unidades | *ainda à venda.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se ela lança muito produto parecido de uma vez, pode aumentar a concorrência com o próprio estoque.",
   "caption": "Se ela lança | *muito produto parecido* | de uma vez, | pode aumentar | a *concorrência* | com o *próprio estoque.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "A decisão pode ser de estratégia, não de pânico.",
   "caption": "A decisão | pode ser | de *estratégia,* | *não de pânico.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "O corretor que vende lançamentos precisa entender o momento do empreendimento, as condições e as alternativas ao comprador.",
   "caption": "O corretor | que vende lançamentos | precisa entender | o *momento* | do empreendimento, | as *condições* | e as *alternativas* | ao comprador.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Manchete dramática não substitui leitura de mercado.",
   "caption": "*Manchete dramática* | não substitui | *leitura de mercado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Leia o contexto.",
   "caption": "*Leia o contexto.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
