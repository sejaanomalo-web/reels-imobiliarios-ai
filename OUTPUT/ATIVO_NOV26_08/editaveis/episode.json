  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Outro pode ter metragem maior, mas exigir reforma.",
   "caption": "Outro pode ter | *metragem maior,* | mas exigir | *reforma.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "O corretor que domina essas diferenças ajuda a comparar, inclusive quando uma opção não compensa.",
   "caption": "O corretor | que domina | essas *diferenças* | ajuda a *comparar,* | inclusive quando | uma opção | *não compensa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Na próxima objeção de preço, peça para entender a referência do comprador.",
   "caption": "Na próxima objeção | de preço, | peça para entender | a *referência* | do comprador.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Depois, apresente fatos que você verificou.",
   "caption": "Depois, | apresente *fatos* | que você *verificou.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "O objetivo não é vencer a discussão.",
   "caption": "O objetivo | não é *vencer* | a discussão.",
