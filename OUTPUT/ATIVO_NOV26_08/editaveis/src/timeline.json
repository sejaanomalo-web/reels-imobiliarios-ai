 ],
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Setenta e três por cento dos entrevistados numa pesquisa consideraram imóveis caros ou muito caros.",
   "start": 0.12,
   "end": 6.17
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "A resposta não pode ser só: “mas é uma oportunidade”.",
   "start": 6.36,
   "end": 9.09
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Se o cliente acha caro, repetir adjetivos não resolve.",
   "start": 9.32,
   "end": 12.55
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Ele quer saber com o que está comparando.",
   "start": 12.76,
   "end": 14.63
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Área, localização, estado de conservação e custos recorrentes mudam a leitura do mesmo preço.",
   "start": 15.08,
   "end": 20.85
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Um apartamento pode custar mais porque entrega mobilidade.",
   "start": 21.24,
   "end": 24.22
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Outro pode ter metragem maior, mas exigir reforma.",
   "start": 24.44,
   "end": 27.41
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "O corretor que domina essas diferenças ajuda a comparar, inclusive quando uma opção não compensa.",
   "start": 27.72,
   "end": 33.06
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Na próxima objeção de preço, peça para entender a referência do comprador.",
   "start": 33.4,
   "end": 37.31
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Depois, apresente fatos que você verificou.",
   "start": 37.56,
   "end": 39.78
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "O objetivo não é vencer a discussão.",
   "start": 40.04,
   "end": 42.0
  },
  {
   "id": "s12",
   "scene": "t3",
   "text": "É tornar a escolha mais clara.",
   "start": 42.2,
   "end": 43.86
  },
  {
   "id": "s13",
   "scene": "t3",
   "text": "Ouviu “está caro”? Pergunte antes de contra-argumentar.",
   "start": 44.04,
   "end": 47.44
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 47.72,
   "end": 52.11
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 52.368,
   "end": 55.04
  }
 ],
