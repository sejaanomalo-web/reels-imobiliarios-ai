 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se o crédito imobiliário está caro, como a Caixa contratou dezenas de bilhões de reais em financiamentos num único trimestre?",
   "start": 0.2,
   "end": 7.94
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "No terceiro trimestre de dois mil e vinte e seis, foram setenta e dois vírgula cinco bilhões de reais em contratações, considerando recursos da Caixa e do FGTS.",
   "start": 8.44,
   "end": 17.42
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "É um volume grande, mesmo com taxas elevadas.",
   "start": 17.72,
   "end": 20.36
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "O erro é imaginar o mercado como um interruptor: juro alto, ninguém compra; juro baixo, todo mundo compra.",
   "start": 20.76,
   "end": 26.88
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Na prática, existem faixas de renda, modalidades, necessidades e condições muito diferentes.",
   "start": 27.48,
   "end": 33.22
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Para o corretor, olhar o número agregado é só o começo.",
   "start": 33.48,
   "end": 36.28
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O que importa é saber qual modalidade atende o cliente, quais condições estão disponíveis e qual produto faz sentido para ele.",
   "start": 36.52,
   "end": 43.33
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de repetir que o mercado travou, olhe o recorte da notícia.",
   "start": 43.8,
   "end": 47.85
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 48.2,
   "end": 52.74
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 53.029,
   "end": 55.65
  }
 ],
