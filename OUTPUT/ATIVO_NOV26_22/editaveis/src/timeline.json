 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um leilão do Santander reuniu quase duzentos imóveis em novembro.",
   "start": 0.12,
   "end": 4.14
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas um lance aparentemente barato pode esconder uma conta bem maior.",
   "start": 4.52,
   "end": 8.36
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Quando aparece um preço inicial muito abaixo do mercado, é tentador enxergar margem de lucro automática.",
   "start": 8.68,
   "end": 14.35
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Só que imóvel em leilão não é uma compra comum, e as condições variam de lote para lote.",
   "start": 14.68,
   "end": 19.67
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Edital, matrícula, ocupação, débitos, comissão, impostos e forma de pagamento precisam ser avaliados com cuidado.",
   "start": 20.04,
   "end": 28.17
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Há casos em que o comprador precisa de orientação jurídica e documental específica.",
   "start": 28.52,
   "end": 32.58
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O corretor responsável não vende só o desconto.",
   "start": 32.92,
   "end": 35.6
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Ele explica as condições que consegue verificar e indica a análise profissional necessária.",
   "start": 35.96,
   "end": 40.84
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "A oportunidade começa depois de entender os riscos.",
   "start": 41.24,
   "end": 44.51
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Não venda apenas o percentual.",
   "start": 44.76,
   "end": 46.19
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 46.52,
   "end": 51.29
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 51.48,
   "end": 54.25
  }
 ],
