 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Os aluguéis anunciados subiram cerca de nove por cento em doze meses, segundo o FipeZAP.",
   "caption": "Os *aluguéis anunciados* | subiram cerca de | *nove por cento* | em doze meses, | segundo o FipeZAP.",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas isso não quer dizer que todo contrato deve subir nove por cento.",
   "caption": "Mas isso | *não quer dizer* | que todo contrato | deve subir | *nove por cento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "O índice acompanha preços pedidos em novos anúncios.",
   "caption": "O índice acompanha | *preços pedidos* | em *novos anúncios.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Já o reajuste de um contrato vigente depende do que foi pactuado e das regras aplicáveis.",
   "caption": "Já o reajuste | de um *contrato vigente* | depende do que | foi *pactuado* | e das *regras aplicáveis.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Misturar essas coisas gera atendimento ruim.",
   "caption": "*Misturar* essas coisas | gera *atendimento ruim.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Para o corretor, a notícia pode ajudar a estudar o mercado de locação.",
   "caption": "Para o corretor, | a notícia pode ajudar | a estudar | o *mercado de locação.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Mas preço de anúncio não é automaticamente preço fechado, e a realidade de cada bairro pode ser diferente da média nacional.",
   "caption": "Mas *preço de anúncio* | não é automaticamente | *preço fechado,* | e a realidade | de cada *bairro* | pode ser diferente | da *média nacional.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Ao orientar proprietário ou locatário, confira imóveis comparáveis, condições do contrato e legislação aplicável.",
   "caption": "Ao orientar | *proprietário* | ou *locatário,* | confira | imóveis *comparáveis,* | condições | do *contrato* | e *legislação* aplicável.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "A boa negociação começa separando os indicadores.",
   "caption": "A boa negociação | começa *separando* | os *indicadores.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Comece pelo dado certo.",
   "caption": "*Comece pelo* | *dado certo.*",
   "pauseAfter": 0.3
  },
  {
