 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Vinte links enviados não são vinte argumentos de venda.",
   "start": 0.12,
   "end": 3.62
  },
  {
   "id": "s2",
   "scene": "situacao",
   "text": "Imagine pedir um restaurante tranquilo e receber uma lista com vinte endereços sem explicação.",
   "start": 4.36,
   "end": 9.7
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "É assim que um comprador pode se sentir.",
   "start": 10.28,
   "end": 12.39
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "Uma recomendação útil explica a relação entre o imóvel e a prioridade do cliente.",
   "start": 13.24,
   "end": 18.18
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Não precisa de dez adjetivos. Precisa de critério.",
   "start": 18.6,
   "end": 21.69
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Apresente poucas opções e diga por que escolheu cada uma.",
   "start": 22.36,
   "end": 25.63
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Depois pergunte qual delas faz mais sentido para avançar.",
   "start": 26.12,
   "end": 29.04
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Escolher com critério fica mais fácil quando as prioridades de cada cliente estão registradas.",
   "start": 29.72,
   "end": 34.53
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 35.0,
   "end": 39.79
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 40.149,
   "end": 42.82
  }
 ],
