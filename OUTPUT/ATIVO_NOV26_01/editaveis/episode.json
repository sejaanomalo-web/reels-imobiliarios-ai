 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A Selic ficou em treze vírgula setenta e cinco por cento.",
   "caption": "A *Selic* ficou em | *treze vírgula* | *setenta e cinco* | *por cento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Então por que financiar um imóvel ainda pesa tanto no bolso?",
   "caption": "Então por que | *financiar* um imóvel | ainda pesa tanto | no *bolso?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Porque a Selic é uma referência importante, mas não é a taxa do contrato imobiliário.",
   "caption": "Porque a Selic | é uma *referência* | importante, | mas *não é* a taxa | do contrato | imobiliário.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "O banco também considera custo do dinheiro, riscos, prazo e condições daquela operação.",
   "caption": "O banco também | considera | *custo do dinheiro,* | *riscos,* *prazo* | e *condições* | daquela operação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Imagina dois compradores olhando o mesmo apartamento.",
   "caption": "Imagina | *dois compradores* | olhando o *mesmo* | apartamento.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Um tem entrada maior e renda estável.",
   "caption": "Um tem | *entrada maior* | e *renda estável.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Outro precisa financiar uma parcela maior.",
   "caption": "Outro precisa | financiar | uma *parcela maior.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "A simulação pode mudar bastante, mesmo no mesmo dia.",
   "caption": "A *simulação* | pode mudar | bastante, | mesmo no | *mesmo dia.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Por isso, quando o cliente perguntar se agora é uma boa hora para comprar, não responda só olhando a notícia do Copom.",
   "caption": "Por isso, | quando o cliente | perguntar | se agora é | uma *boa hora* | para comprar, | não responda | só olhando | a notícia | do *Copom.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Entenda o orçamento, faça simulação atualizada e compare alternativas.",
   "caption": "Entenda | o *orçamento,* | faça simulação | *atualizada* | e *compare* | alternativas.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Lembre: juros básicos e financiamento não são a mesma coisa.",
   "caption": "Lembre: | *juros básicos* | e *financiamento* | não são | a mesma coisa.",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "cta",
