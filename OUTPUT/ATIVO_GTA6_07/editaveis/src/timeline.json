 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quem acha que GTA VI é só sobre roubar carro não prestou atenção nos dois protagonistas.",
   "start": 0.12,
   "end": 5.77
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Jason quer uma vida mais tranquila, mas continua preso ao ambiente criminoso em que cresceu.",
   "start": 6.191,
   "end": 11.22
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Lucia acabou de sair da prisão e quer mudar a própria sorte.",
   "start": 11.48,
   "end": 14.93
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Os dois se aproximam e a história deles se complica quando um serviço aparentemente simples dá errado.",
   "start": 15.4,
   "end": 21.5
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "O ponto interessante não é quem dirige melhor.",
   "start": 21.88,
   "end": 24.45
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "É ver duas pessoas buscando uma vida diferente enquanto a cidade oferece exatamente o tipo de tentação que pode destruir esses planos.",
   "start": 24.76,
   "end": 32.12
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "GTA VI começa com personagens que querem sair do caos e uma cidade inteira tentando puxá-los de volta.",
   "start": 32.52,
   "end": 38.95
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Fora do jogo, quem quer sair do caos começa pela organização.",
   "start": 39.48,
   "end": 43.11
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 43.4,
   "end": 48.52
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 48.68,
   "end": 51.68
  }
 ],
