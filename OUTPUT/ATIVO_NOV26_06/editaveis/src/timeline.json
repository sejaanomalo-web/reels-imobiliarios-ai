 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A intenção de comprar imóvel caiu para trinta e cinco por cento numa pesquisa recente.",
   "start": 0.12,
   "end": 4.52
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Isso quer dizer que acabou o comprador?",
   "start": 4.52,
   "end": 6.52
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Não.",
   "start": 6.52,
   "end": 6.73
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "A pesquisa ouviu usuários de portais imobiliários, e mede uma intenção declarada, não o desaparecimento da demanda.",
   "start": 6.84,
   "end": 12.68
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "É uma fotografia de um grupo específico, num período específico.",
   "start": 12.68,
   "end": 15.61
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Agora imagina seu atendimento.",
   "start": 15.88,
   "end": 17.28
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Um interessado está só pesquisando, outro precisa mudar em três meses, e um terceiro já tem entrada separada.",
   "start": 17.48,
   "end": 22.92
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Tratar os três como se fossem comprar amanhã só aumenta ruído.",
   "start": 22.92,
   "end": 26.28
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Em vez de insistir com todo mundo da mesma maneira, descubra motivo, prazo e próximos passos.",
   "start": 26.28,
   "end": 31.56
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "O trabalho do corretor é fazer a conversa evoluir com clareza, não adivinhar o futuro do mercado.",
   "start": 31.56,
   "end": 35.98
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Qualifique a conversa antes de insistir.",
   "start": 36.2,
   "end": 38.2
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 38.2,
   "end": 42.36
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 42.36,
   "end": 45.161
  }
 ],
