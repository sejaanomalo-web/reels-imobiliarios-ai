 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quer ter mais clareza sobre sua carteira?",
   "caption": "Quer ter | mais *clareza* | sobre sua *carteira?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Experimente esta revisão semanal de quinze minutos.",
   "caption": "Experimente | esta *revisão semanal* | de *quinze minutos.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Abra seus imóveis ativos e separe três grupos: os que receberam interesse, os que precisam de atualização e os que estão sem próximo passo definido.",
   "caption": "Abra seus | *imóveis ativos* | e separe | *três grupos:* | os que receberam *interesse,* | os que precisam | de *atualização* | e os que estão | *sem próximo passo* | definido.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "No segundo grupo, confira preço, status, fotos e informações.",
   "caption": "No *segundo* grupo, | confira *preço,* | *status,* *fotos* | e *informações.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "No terceiro, decida qual ação faz sentido e quem será responsável.",
   "caption": "No *terceiro,* | decida qual *ação* | faz sentido | e quem será | *responsável.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "O objetivo não é cobrar uma venda toda semana.",
   "caption": "O objetivo | *não é cobrar* | uma venda | toda semana.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "É impedir que a carteira vire um arquivo esquecido.",
   "caption": "É *impedir* | que a carteira | vire um *arquivo esquecido.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "insight",
   "text": "Registre as decisões e revise na próxima reunião.",
   "caption": "*Registre* | as decisões | e *revise* | na próxima reunião.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Essa revisão fica mais fácil quando a carteira inteira está organizada.",
   "caption": "Essa revisão | fica mais fácil | quando a carteira | inteira está | *organizada.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
