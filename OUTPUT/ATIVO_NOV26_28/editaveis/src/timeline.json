 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dois corretores atendem compradores diferentes.",
   "start": 0.2,
   "end": 3.05
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Um tem o imóvel certo, o outro tem o cliente certo.",
   "start": 3.24,
   "end": 6.51
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Eles vão competir ou conversar?",
   "start": 6.76,
   "end": 8.39
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Numa história hipotética, o corretor A consegue uma boa captação.",
   "start": 8.84,
   "end": 12.72
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "O corretor B conhece alguém procurando exatamente aquela região.",
   "start": 12.92,
   "end": 16.74
  },
  {
   "id": "s6",
   "scene": "t1",
   "text": "Se cada um guardar suas informações isoladas, a aproximação pode nem acontecer.",
   "start": 16.92,
   "end": 21.62
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "No Conexão Imobiliária, lideranças do setor discutiram cooperação entre imobiliárias.",
   "start": 22.04,
   "end": 26.82
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Mas parceria séria exige autorização, combinado claro sobre responsabilidades, remuneração e proteção das informações do cliente.",
   "start": 27.08,
   "end": 34.95
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "A lição não é compartilhar sua carteira com qualquer pessoa.",
   "start": 35.32,
   "end": 38.45
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "É perceber que organização e confiança também fazem parte de uma boa rede de negócios.",
   "start": 38.68,
   "end": 43.4
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Cooperação com critério.",
   "start": 43.596,
   "end": 45.07
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 45.4,
   "end": 49.81
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 50.149,
   "end": 52.98
  }
 ],
