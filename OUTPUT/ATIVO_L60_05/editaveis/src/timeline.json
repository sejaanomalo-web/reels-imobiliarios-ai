 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O cliente respondeu com fogo no imóvel. Isso não significa que ele vai comprar amanhã.",
   "start": 0.12,
   "end": 5.12
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Curtida, emoji e elogio são sinais de interesse no conteúdo.",
   "start": 5.572,
   "end": 9.77
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Mas ainda não dizem se existe prazo, condição de compra ou vontade de visitar.",
   "start": 10.04,
   "end": 14.92
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Para entender o estágio do contato, pergunte quando pretende se mudar, o que está buscando e qual seria o próximo passo confortável para ele.",
   "start": 15.32,
   "end": 22.73
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Um cliente pode estar no começo da jornada e ainda ser valioso.",
   "start": 23.08,
   "end": 26.39
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Qualificação serve para acompanhar melhor, não para descartar pessoas cedo demais.",
   "start": 26.68,
   "end": 30.93
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 31.16,
   "end": 35.83
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 35.96,
   "end": 38.55
  }
 ],
