 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A Caixa está estudando aumentar os juros do financiamento imobiliário.",
   "start": 0.12,
   "end": 3.5
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "A palavra mais importante aqui é: estudando.",
   "start": 3.72,
   "end": 6.04
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "A notícia de treze de novembro não significa que todas as taxas já mudaram.",
   "start": 6.52,
   "end": 10.76
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "E não autoriza sair dizendo para todo comprador que ele tem poucas horas para fechar negócio.",
   "start": 10.76,
   "end": 14.68
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Pensa no corretor que envia uma simulação de semanas atrás como se ainda fosse válida.",
   "start": 15.08,
   "end": 19.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "O cliente se planeja, cria expectativa e só descobre a diferença quando chega à etapa do banco.",
   "start": 19.56,
   "end": 24.3
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "O profissional preparado confirma a taxa e as condições atuais, explica o que depende de análise e registra a etapa da negociação.",
   "start": 24.6,
   "end": 31.78
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Informação precisa vale mais do que urgência fabricada.",
   "start": 32.12,
   "end": 34.79
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Se você atende compradores financiados, confirme antes de prometer.",
   "start": 35.08,
   "end": 38.62
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 39.08,
   "end": 43.46
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 43.728,
   "end": 46.3
  }
 ],
