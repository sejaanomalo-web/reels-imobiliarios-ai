 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Em São Paulo, sete de cada dez imóveis novos vendidos num período recente foram do Minha Casa Minha Vida.",
   "start": 0.2,
   "end": 6.81
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Você percebe o tamanho desse mercado?",
   "start": 7.16,
   "end": 9.21
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "O dado é da capital paulista e considera imóveis novos no período analisado pelo Secovi.",
   "start": 9.72,
   "end": 14.62
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Não significa sete em dez vendas de todo o Brasil, nem inclui automaticamente os usados.",
   "start": 15.0,
   "end": 19.84
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "O que isso ensina para o corretor?",
   "start": 20.28,
   "end": 22.2
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Que o comprador de primeira moradia pode precisar de alguém que explique entrada, análise de crédito, custos adicionais e etapas da aquisição, sem prometer enquadramento.",
   "start": 22.52,
   "end": 31.69
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Se você atua nesse segmento, transforme as dúvidas que recebe no atendimento em conteúdo.",
   "start": 32.2,
   "end": 37.02
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Em vez de mostrar só planta e fachada, ajude a pessoa a entender como começar.",
   "start": 37.32,
   "end": 41.8
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Cada dúvida respondida prepara o comprador.",
   "start": 42.04,
   "end": 44.46
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.68,
   "end": 48.91
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.219,
   "end": 51.71
  }
 ],
