 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "GTA VI tem um personagem que fez fortuna com imóveis.",
   "start": 0.2,
   "end": 3.86
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E ele nem é o protagonista.",
   "start": 4.04,
   "end": 5.4
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "O nome é Boobie Ike.",
   "start": 5.64,
   "end": 7.19
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "A Rockstar o descreve como uma lenda de Vice City que transformou a própria trajetória em negócios.",
   "start": 7.32,
   "end": 12.35
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "O império dele envolve imóveis, um clube noturno e um estúdio musical.",
   "start": 12.52,
   "end": 16.61
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "E tem mais: ele se associa a Dre’Quan Priest numa gravadora que quer estourar na cidade.",
   "start": 16.84,
   "end": 22.27
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Isso muda totalmente a forma de olhar o universo do jogo.",
   "start": 22.6,
   "end": 25.29
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Não é só perseguição de carro: existem personagens com negócios, interesses e poder espalhados por Vice City.",
   "start": 25.48,
   "end": 31.91
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "E eu adorei o detalhe: até num jogo famoso pelo caos, quem entende de patrimônio constrói um império.",
   "start": 32.12,
   "end": 38.05
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Agora, e os seus imóveis de verdade?",
   "start": 38.36,
   "end": 40.4
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.52,
   "end": 45.23
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 45.4,
   "end": 48.15
  }
 ],
