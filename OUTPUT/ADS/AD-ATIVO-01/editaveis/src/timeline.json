 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Talvez a venda do seu próximo imóvel esteja numa conversa que você esqueceu de responder.",
   "start": 0.05,
   "end": 4.21
  },
  {
   "id": "s2",
   "scene": "situacao",
   "text": "A pessoa perguntou sobre o apartamento, pediu mais informações, ficou de conversar com a família... e aí chegaram outras dez mensagens.",
   "start": 4.77,
   "end": 12.47
  },
  {
   "id": "s3",
   "scene": "consequencia",
   "text": "A conversa foi descendo, você seguiu sua rotina e aquele interessado ficou para trás.",
   "start": 12.69,
   "end": 17.46
  },
  {
   "id": "s4",
   "scene": "consequencia",
   "text": "O problema é que, quando você atende várias pessoas, fica difícil lembrar quem pediu visita e quem precisa de retorno.",
   "start": 17.89,
   "end": 24.06
  },
  {
   "id": "s5",
   "scene": "ativo",
   "text": "É justamente essa parte que o sistema ATIVO organiza pra você.",
   "start": 24.53,
   "end": 28.39
  },
  {
   "id": "s6",
   "scene": "ativo",
   "text": "Seus imóveis, interessados e atendimentos podem ficar centralizados em um sistema pensado para a sua rotina.",
   "start": 28.85,
   "end": 34.57
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Quer conhecer como isso funciona?",
   "start": 34.93,
   "end": 36.29
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Clique no botão e descubra a solução da ATIVO.",
   "start": 36.564,
   "end": 39.14
  }
 ],
