 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um profissional sabia cada detalhe do apartamento.",
   "start": 0.12,
   "end": 3.28
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O outro fez uma pergunta.",
   "start": 3.72,
   "end": 5.15
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "A segunda abordagem mudou toda a conversa.",
   "start": 5.32,
   "end": 7.86
  },
  {
   "id": "s4",
   "scene": "fic",
   "text": "Imagina um casal procurando dois quartos.",
   "start": 8.28,
   "end": 10.42
  },
  {
   "id": "s5",
   "scene": "fic",
   "text": "No primeiro atendimento, o profissional começa a listar metragem, porcelanato, salão de festas e academia.",
   "start": 10.76,
   "end": 16.47
  },
  {
   "id": "s6",
   "scene": "fic",
   "text": "Está tudo correto.",
   "start": 16.893,
   "end": 17.9
  },
  {
   "id": "s7",
   "scene": "fic",
   "text": "Mas ainda não sabe por que aquela família está procurando outro lugar.",
   "start": 18.44,
   "end": 22.13
  },
  {
   "id": "s8",
   "scene": "perg",
   "text": "No segundo, a pergunta vem antes: o que mudou na rotina de vocês?",
   "start": 22.68,
   "end": 26.6
  },
  {
   "id": "s9",
   "scene": "perg",
   "text": "A resposta pode ser trabalho remoto, chegada de um filho ou necessidade de ficar mais perto da família.",
   "start": 27.0,
   "end": 32.45
  },
  {
   "id": "s10",
   "scene": "perg",
   "text": "Só agora faz sentido destacar o que realmente atende a esse momento.",
   "start": 33.08,
   "end": 37.15
  },
  {
   "id": "s11",
   "scene": "pri",
   "text": "Conhecer o imóvel é obrigatório.",
   "start": 37.64,
   "end": 39.34
  },
  {
   "id": "s12",
   "scene": "pri",
   "text": "Mas saber selecionar quais informações importam para aquele comprador é o que transforma uma apresentação em orientação.",
   "start": 39.72,
   "end": 46.17
  },
  {
   "id": "s13",
   "scene": "pri",
   "text": "Não substitua a ficha técnica; use a ficha depois de entender a pergunta.",
   "start": 46.6,
   "end": 50.81
  },
  {
   "id": "s14",
   "scene": "fim",
   "text": "Na próxima visita, testa começar por essa pergunta e observa como a conversa muda.",
   "start": 51.32,
   "end": 55.81
  },
  {
   "id": "s15",
   "scene": "fim",
   "text": "E registra o que cada família contou.",
   "start": 56.12,
   "end": 57.97
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 58.44,
   "end": 62.54
  },
  {
   "id": "s17",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 62.928,
   "end": 65.19
  }
 ],
