 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "GTA VI acabou de lançar e eu tenho certeza:",
   "start": 0.2,
   "end": 3.17
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "o corretor não vai conseguir jogar isso em paz.",
   "start": 3.72,
   "end": 6.26
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Uma pessoa normal entra em Vice City, pega um carro e vai explorar.",
   "start": 6.76,
   "end": 10.38
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "O corretor entra e a primeira coisa que vê é uma cobertura de frente pro mar.",
   "start": 10.68,
   "end": 14.89
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "A cabeça dele já começa: quantas vagas? Qual a metragem? Tem churrasqueira?",
   "start": 15.24,
   "end": 20.31
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Daqui a pouco ele passa por uma mansão e já está imaginando o vídeo de captação.",
   "start": 20.52,
   "end": 25.08
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Quando vê uma fachada bonita, diminui a velocidade do carro.",
   "start": 25.32,
   "end": 28.45
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Quando vê um bairro novo, pensa no potencial de valorização.",
   "start": 28.68,
   "end": 32.16
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Esquece completamente a missão.",
   "start": 32.44,
   "end": 34.23
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Ele entrou para descansar e saiu com uma carteira de imóveis fictícia.",
   "start": 34.52,
   "end": 38.99
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Isso é praticamente um diagnóstico profissional.",
   "start": 39.4,
   "end": 41.59
  },
  {
   "id": "s12",
   "scene": "t3",
   "text": "E se esse corretor é você…",
   "start": 41.8,
   "end": 43.22
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 43.48,
   "end": 47.89
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 48.208,
   "end": 51.01
  }
 ],
