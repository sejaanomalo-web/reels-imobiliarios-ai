 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você sabia que o dinheiro da poupança tem relação com a oferta de financiamento imobiliário?",
   "caption": "Você sabia | que o dinheiro | da *poupança* | tem relação | com a oferta | de *financiamento* | imobiliário?",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Pensa no sistema de crédito como um reservatório.",
   "caption": "Pensa no sistema | de *crédito* | como um | *reservatório.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Uma parte dos recursos usados nos financiamentos vem da poupança, seguindo regras específicas.",
   "caption": "Uma *parte* | dos recursos | usados nos | financiamentos | vem da *poupança,* | seguindo regras | específicas.",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Quando há mais saques do que depósitos, esse reservatório fica sob pressão.",
   "caption": "Quando há | mais *saques* | do que *depósitos,* | esse reservatório | fica sob *pressão.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Em outubro, a poupança voltou a registrar saída líquida de recursos.",
   "caption": "Em *outubro,* | a poupança | voltou a registrar | *saída líquida* | de recursos.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Mas isso não significa que o banco parou de financiar.",
   "caption": "Mas isso | *não significa* | que o banco | *parou* | de financiar.",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Existem outras fontes e decisões envolvidas.",
   "caption": "Existem | *outras fontes* | e *decisões* | envolvidas.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Para o corretor, a aplicação é simples: acompanhe as condições reais de crédito e saiba explicar por que aprovação, taxa e prazo não são iguais para todo mundo.",
   "caption": "Para o corretor, | a aplicação | é simples: | *acompanhe* | as condições reais | de crédito | e saiba *explicar* | por que | *aprovação,* *taxa* | e *prazo* | não são iguais | para todo mundo.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Traduza a notícia para o cliente, sem complicação.",
   "caption": "*Traduza* a notícia | para o cliente, | sem complicação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "cta",
