 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Às vezes, a visita que não virou proposta trouxe a informação mais valiosa da semana.",
   "start": 0.2,
   "end": 5.42
  },
  {
   "id": "s2",
   "scene": "situacao",
   "text": "O cliente gostou da planta, mas achou a rua movimentada.",
   "start": 5.8,
   "end": 8.98
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Ou adorou a localização e percebeu que precisa de mais espaço.",
   "start": 9.32,
   "end": 12.94
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "O erro é registrar apenas que ele não gostou.",
   "start": 13.48,
   "end": 15.77
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Você perde o critério que pode orientar a próxima indicação.",
   "start": 16.28,
   "end": 19.41
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Depois da visita, pergunte o que funcionou e o que não funcionou.",
   "start": 19.88,
   "end": 23.52
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "Registre esses critérios para selecionar a próxima opção com mais precisão.",
   "start": 24.049,
   "end": 27.96
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Essas pistas só ajudam se ficarem registradas na jornada de cada cliente.",
   "start": 28.6,
   "end": 32.45
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 32.84,
   "end": 37.71
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 38.019,
   "end": 40.69
  }
 ],
