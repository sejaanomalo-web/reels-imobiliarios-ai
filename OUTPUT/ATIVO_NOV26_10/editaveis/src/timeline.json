 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O anúncio de um apartamento ficou mais caro no índice.",
   "start": 0.12,
   "end": 3.13
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas na negociação o comprador conseguiu desconto.",
   "start": 3.4,
   "end": 6.13
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Os dois fatos podem ser verdadeiros.",
   "start": 6.44,
   "end": 8.39
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "O FipeZAP de venda acompanha preços anunciados em portais.",
   "start": 8.6,
   "end": 12.25
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Já uma pesquisa sobre transações identifica o que os entrevistados relatam ter pago.",
   "start": 12.44,
   "end": 16.84
  },
  {
   "id": "s6",
   "scene": "t1",
   "text": "São bases, métodos e perguntas diferentes.",
   "start": 17.24,
   "end": 19.85
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se o corretor usa só a valorização anunciada para dizer ao proprietário quanto o imóvel vale, pode ignorar estado de conservação, liquidez e negociações semelhantes naquela região.",
   "start": 20.12,
   "end": 30.48
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "A notícia ajuda a entender o cenário.",
   "start": 30.84,
   "end": 32.79
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "A avaliação precisa conectar dados locais e características verificadas.",
   "start": 33.08,
   "end": 37.45
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Para o cliente, transparência no método vale mais do que uma estatística bonita.",
   "start": 37.72,
   "end": 41.68
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Preço anunciado não é preço de venda: dado é ponto de partida.",
   "start": 41.96,
   "end": 45.65
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 45.96,
   "end": 50.5
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 50.68,
   "end": 53.68
  }
 ],
