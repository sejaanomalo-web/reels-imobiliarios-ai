 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Um proprietário pede para anunciar acima do mercado, porque quer “ter margem para negociar”.",
   "start": 0.2,
   "end": 5.28
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O problema é o que acontece antes da proposta.",
   "start": 5.64,
   "end": 8.16
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Imagine um apartamento que aparece na busca ao lado de outros semelhantes.",
   "start": 8.6,
   "end": 12.35
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "O preço maior pode afastar quem está filtrando por orçamento, antes mesmo da primeira conversa.",
   "start": 12.6,
   "end": 17.72
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "A pesquisa Raio-X FipeZAP mostrou descontos médios maiores nas transações em que houve negociação.",
   "start": 17.96,
   "end": 24.1
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Mas isso não prova que inflar anúncios seja uma boa estratégia.",
   "start": 24.28,
   "end": 27.64
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "É uma conclusão diferente.",
   "start": 27.8,
   "end": 29.08
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Ao captar, mostre comparáveis e combine um plano de preço com o proprietário.",
   "start": 29.32,
   "end": 33.31
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Se ele optar por testar um valor, defina quando revisar.",
   "start": 33.48,
   "end": 36.32
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Medir interesse é melhor do que esperar no escuro.",
   "start": 36.6,
   "end": 38.99
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Na captação, leve preço e plano de revisão.",
   "start": 39.24,
   "end": 41.75
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 42.2,
   "end": 46.84
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 47.088,
   "end": 49.82
  }
 ],
