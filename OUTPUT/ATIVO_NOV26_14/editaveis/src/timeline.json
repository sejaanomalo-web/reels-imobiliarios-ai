 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Saiu a notícia de mais de cinco mil moradias aptas para contratação no Minha Casa Minha Vida.",
   "start": 0.2,
   "end": 5.35
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Isso quer dizer que já estão prontas para vender?",
   "start": 5.64,
   "end": 7.6
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Não.",
   "start": 8.12,
   "end": 8.47
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "“Aptas para contratação” é uma etapa administrativa.",
   "start": 8.76,
   "end": 11.7
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "O anúncio do Ministério das Cidades, de quatro de novembro, trata de propostas de empreendimentos que avançaram nesse processo.",
   "start": 11.88,
   "end": 17.97
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Imagine um interessado que vê a notícia e pergunta se já pode escolher unidade e receber as chaves.",
   "start": 18.36,
   "end": 23.27
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Se o corretor confunde aprovação administrativa com imóvel disponível, transmite uma informação errada.",
   "start": 23.64,
   "end": 28.95
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Antes de publicar sobre empreendimento ou programa, confirme onde fica, em que fase está, quem pode se candidatar e qual canal oficial recebe os interessados.",
   "start": 29.32,
   "end": 38.56
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Informação habitacional exige contexto.",
   "start": 39.08,
   "end": 41.24
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Antes de anunciar novidade, confira a fase do projeto.",
   "start": 41.64,
   "end": 44.52
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.92,
   "end": 49.28
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.669,
   "end": 52.25
  }
 ],
