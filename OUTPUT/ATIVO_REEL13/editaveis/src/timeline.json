 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Receber um lead é uma etapa.",
   "start": 0.12,
   "end": 1.87
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Fazer esse contato avançar sem se perder pelo caminho é outra completamente diferente.",
   "start": 2.04,
   "end": 6.68
  },
  {
   "id": "s3",
   "scene": "ini",
   "text": "Pensa na jornada de um interessado em apartamento.",
   "start": 6.92,
   "end": 9.14
  },
  {
   "id": "s4",
   "scene": "ini",
   "text": "Primeiro, ele vê um conteúdo que responde algo importante.",
   "start": 9.64,
   "end": 12.31
  },
  {
   "id": "s5",
   "scene": "ini",
   "text": "Depois, pede informações por um canal claro.",
   "start": 12.6,
   "end": 14.9
  },
  {
   "id": "s6",
   "scene": "ini",
   "text": "Até aqui, o trabalho foi chamar atenção e começar uma conversa.",
   "start": 15.4,
   "end": 18.76
  },
  {
   "id": "s7",
   "scene": "meio",
   "text": "Agora vem a parte que costuma ficar invisível.",
   "start": 19.32,
   "end": 21.86
  },
  {
   "id": "s8",
   "scene": "meio",
   "text": "É preciso registrar o que ele procura, lembrar o que já foi explicado e acompanhar o momento da decisão.",
   "start": 22.2,
   "end": 27.49
  },
  {
   "id": "s9",
   "scene": "meio",
   "text": "Quem está comparando não precisa da mesma mensagem de quem pediu uma visita para amanhã.",
   "start": 27.88,
   "end": 31.96
  },
  {
   "id": "s10",
   "scene": "prox",
   "text": "A quarta etapa é propor a ação certa: esclarecer uma dúvida, enviar uma opção compatível ou combinar a visita.",
   "start": 32.68,
   "end": 39.64
  },
  {
   "id": "s11",
   "scene": "prox",
   "text": "Não existe botão que substitui entender a pessoa.",
   "start": 39.96,
   "end": 42.73
  },
  {
   "id": "s12",
   "scene": "prox",
   "text": "O sistema serve para deixar essas etapas visíveis e mais fáceis de acompanhar.",
   "start": 43.08,
   "end": 46.93
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 47.4,
   "end": 51.9
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 52.2,
   "end": 54.98
  }
 ],
