 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Quando você escuta Minha Casa Minha Vida, pensa em um único perfil de comprador?",
   "start": 0.12,
   "end": 4.7
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Talvez esteja deixando de entender parte do mercado.",
   "start": 5.08,
   "end": 7.99
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "O programa reúne faixas e modalidades diferentes.",
   "start": 8.36,
   "end": 11.14
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Ao longo do tempo, suas regras passaram por mudanças.",
   "start": 11.4,
   "end": 14.21
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Por isso, renda e valor de imóvel não devem ser repetidos de memória como se fossem eternos.",
   "start": 14.6,
   "end": 20.19
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Um comprador pode achar que não se encaixa.",
   "start": 20.52,
   "end": 22.68
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Outro pode imaginar que o programa aprova qualquer apartamento.",
   "start": 23.0,
   "end": 26.19
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Os dois podem estar errados.",
   "start": 26.6,
   "end": 28.28
  },
  {
   "id": "s9",
   "scene": "t2",
   "text": "A resposta depende dos critérios vigentes e do tipo de operação.",
   "start": 28.6,
   "end": 32.03
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Para o corretor, o passo certo é verificar as regras oficiais, trabalhar com simulações atualizadas e esclarecer o caminho.",
   "start": 32.36,
   "end": 39.84
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Especialização não é decorar um número.",
   "start": 40.28,
   "end": 42.62
  },
  {
   "id": "s12",
   "scene": "t3",
   "text": "É saber conferir o que mudou.",
   "start": 42.84,
   "end": 44.31
  },
  {
   "id": "s13",
   "scene": "t3",
   "text": "Antes do próximo atendimento, consulte a regra atual.",
   "start": 44.76,
   "end": 47.71
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 47.96,
   "end": 52.54
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 52.819,
   "end": 55.62
  }
 ],
