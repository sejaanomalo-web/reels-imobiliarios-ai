 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Contratar mais corretores não resolve um processo que ninguém entende.",
   "caption": "*Contratar* | mais *corretores* | não resolve | um *processo* | que *ninguém entende.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "situacao",
   "text": "Com duas pessoas, as informações talvez caibam na conversa do escritório.",
   "caption": "Com *duas pessoas,* | as informações | talvez caibam | na *conversa* | do escritório.",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Com oito, começam as dúvidas sobre imóveis, leads, visitas e responsáveis.",
   "caption": "Com *oito,* | começam as *dúvidas* | sobre *imóveis,* | *leads,* *visitas* | e *responsáveis.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "tensao",
   "text": "Quando o trabalho depende de alguém explicar tudo de memória, o crescimento amplia a desorganização que já existia.",
   "caption": "Quando o trabalho | depende de alguém | *explicar tudo* | *de memória,* | o crescimento | *amplia* | a *desorganização* | que já existia.",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "insight",
   "text": "Antes de aumentar a operação, documente as etapas de atendimento, atualização de imóveis e passagem de oportunidades.",
   "caption": "Antes de aumentar | a operação, | *documente* as etapas | de *atendimento,* | *atualização* de imóveis | e *passagem* | de oportunidades.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Depois adapte a ferramenta ao processo.",
   "caption": "*Depois* | adapte a *ferramenta* | ao *processo.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Com o processo documentado, fica mais fácil escolher a ferramenta que se adapta a ele.",
   "caption": "Com o processo | *documentado,* | fica mais fácil | escolher a ferramenta | que se *adapta* a ele.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
