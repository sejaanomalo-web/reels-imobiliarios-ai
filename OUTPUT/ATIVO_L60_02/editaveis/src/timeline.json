 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se o mesmo apartamento aparece em quatro planilhas, qual delas está certa?",
   "start": 0.12,
   "end": 4.31
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Na primeira está o valor antigo. Na segunda, uma foto nova.",
   "start": 4.68,
   "end": 7.89
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Na terceira, a disponibilidade. Na quarta, uma anotação importante do proprietário.",
   "start": 8.28,
   "end": 12.86
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Não é falta de esforço. É o resultado de atualizar a mesma informação em lugares diferentes e esquecer um deles.",
   "start": 13.24,
   "end": 19.05
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Defina um cadastro principal para cada imóvel.",
   "start": 19.4,
   "end": 21.97
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Nele devem viver preço, status, características, material e data da última conferência.",
   "start": 22.2,
   "end": 28.07
  },
  {
   "id": "s7",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 28.36,
   "end": 33.05
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 33.379,
   "end": 36.18
  }
 ],
