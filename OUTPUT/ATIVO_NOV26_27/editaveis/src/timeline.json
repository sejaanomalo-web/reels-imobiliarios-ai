 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A inteligência artificial pode buscar centenas de imóveis em segundos.",
   "start": 0.12,
   "end": 4.66
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Então por que alguém ainda precisaria de um corretor?",
   "start": 5.16,
   "end": 8.01
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Porque encontrar opções e orientar uma decisão não são exatamente a mesma tarefa.",
   "start": 8.84,
   "end": 14.01
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Sistemas podem filtrar preço, localização, metragem e preferências.",
   "start": 14.276,
   "end": 19.41
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "Mas o cliente também tem dúvidas sobre rotina, documentação e riscos.",
   "start": 19.64,
   "end": 24.11
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Nos debates recentes do setor, a tecnologia apareceu como apoio à seleção e ao atendimento.",
   "start": 24.44,
   "end": 30.06
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Só que respostas automáticas também podem errar.",
   "start": 30.36,
   "end": 32.98
  },
  {
   "id": "s8",
   "scene": "t2",
   "text": "Informações sobre o imóvel precisam ser verificadas antes de chegar ao comprador.",
   "start": 33.48,
   "end": 37.96
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "O corretor que se destaca não compete com a velocidade da máquina.",
   "start": 38.28,
   "end": 41.68
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Ele usa ferramentas para ganhar tempo e concentra a atenção no que exige julgamento, responsabilidade e relacionamento.",
   "start": 41.96,
   "end": 49.1
  },
  {
   "id": "s11",
   "scene": "t3",
   "text": "Tecnologia apoia, profissional orienta.",
   "start": 49.48,
   "end": 52.08
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 52.44,
   "end": 57.05
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 57.379,
   "end": 60.13
  }
 ],
