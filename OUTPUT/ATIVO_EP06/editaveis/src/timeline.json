 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Você atende contatos, agenda visitas, cadastra imóveis e passa o dia ocupado.",
   "start": 0.2,
   "end": 5.17
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mesmo assim, algumas oportunidades param no caminho.",
   "start": 5.56,
   "end": 7.75
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "A pergunta não é se você está trabalhando.",
   "start": 8.12,
   "end": 9.98
  },
  {
   "id": "s4",
   "scene": "hook",
   "text": "É onde o seu atendimento está perdendo continuidade.",
   "start": 10.28,
   "end": 12.96
  },
  {
   "id": "s5",
   "scene": "contato",
   "text": "Acompanhe uma oportunidade fictícia.",
   "start": 13.32,
   "end": 15.35
  },
  {
   "id": "s6",
   "scene": "contato",
   "text": "Ela chega por um anúncio.",
   "start": 15.72,
   "end": 16.96
  },
  {
   "id": "s7",
   "scene": "contato",
   "text": "Você responde, mas ninguém define quem será responsável pelo próximo retorno.",
   "start": 17.16,
   "end": 21.29
  },
  {
   "id": "s8",
   "scene": "contato",
   "text": "No dia seguinte, um colega abre a conversa sem saber o que você já explicou.",
   "start": 21.56,
   "end": 25.01
  },
  {
   "id": "s9",
   "scene": "imovel",
   "text": "Agora siga o imóvel.",
   "start": 25.56,
   "end": 26.93
  },
  {
   "id": "s10",
   "scene": "imovel",
   "text": "Você informa ao cliente que está disponível.",
   "start": 27.24,
   "end": 29.08
  },
  {
   "id": "s11",
   "scene": "imovel",
   "text": "Um colega descobre que a condição mudou.",
   "start": 29.4,
   "end": 31.09
  },
  {
   "id": "s12",
   "scene": "imovel",
   "text": "A carteira foi atualizada em um lugar, mas não no outro.",
   "start": 31.4,
   "end": 34.34
  },
  {
   "id": "s13",
   "scene": "imovel",
   "text": "O problema não é apenas informação antiga. É a ausência de um ponto claro de atualização.",
   "start": 34.68,
   "end": 39.46
  },
  {
   "id": "s14",
   "scene": "investigacao",
   "text": "Para encontrar o seu gargalo, escolha uma negociação recente e refaça seu percurso.",
   "start": 39.96,
   "end": 44.71
  },
  {
   "id": "s15",
   "scene": "investigacao",
   "text": "Quem recebeu?",
   "start": 45.08,
   "end": 45.81
  },
  {
   "id": "s16",
   "scene": "investigacao",
   "text": "Quem assumiu?",
   "start": 46.12,
   "end": 46.78
  },
  {
   "id": "s17",
   "scene": "investigacao",
   "text": "Onde ficaram as informações?",
   "start": 47.16,
   "end": 48.6
  },
  {
   "id": "s18",
   "scene": "investigacao",
   "text": "Quando aconteceu o último movimento?",
   "start": 48.92,
   "end": 50.83
  },
  {
   "id": "s19",
   "scene": "investigacao",
   "text": "O que dependia de outra pessoa?",
   "start": 51.08,
   "end": 52.63
  },
  {
   "id": "s20",
   "scene": "investigacao",
   "text": "Uma resposta vaga já indica onde vale investigar.",
   "start": 53.08,
   "end": 56.0
  },
  {
   "id": "s21",
   "scene": "insight",
   "text": "Um bom corretor não precisa lembrar cada mensagem.",
   "start": 56.52,
   "end": 59.16
  },
  {
   "id": "s22",
   "scene": "insight",
   "text": "Precisa enxergar seus clientes, as etapas e as pendências para agir quando algo sai do fluxo.",
   "start": 59.56,
   "end": 64.98
  },
  {
   "id": "s23",
   "scene": "cta",
   "text": "Se você quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos,",
   "start": 65.48,
   "end": 70.23
  },
  {
   "id": "s24",
   "scene": "cta",
   "text": "comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 70.6,
   "end": 73.54
  }
 ],
