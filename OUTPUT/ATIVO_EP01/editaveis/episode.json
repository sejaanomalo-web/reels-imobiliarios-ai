 },
 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Dois corretores podem trabalhar na mesma cidade, anunciar imóveis parecidos e, ainda assim, precisar de estratégias completamente diferentes.",
   "caption": "*Dois corretores* | podem trabalhar | na *mesma cidade,* | anunciar imóveis | *parecidos* | e, ainda assim, | precisar de estratégias | *completamente diferentes.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "O problema começa quando eles tentam fazer exatamente a mesma coisa.",
   "caption": "O *problema* começa | quando eles tentam fazer | exatamente | a *mesma coisa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "comprador",
   "text": "Imagine o primeiro.",
   "caption": "Imagine | o *primeiro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "comprador",
   "text": "Ele trabalha a partir do comprador.",
   "caption": "Ele trabalha | a partir do *comprador.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "comprador",
   "text": "Conversa, descobre o que aquela família precisa e procura a opção adequada, mesmo quando ela não está entre os imóveis que já divulga.",
   "caption": "Conversa, | descobre o que | aquela família *precisa* | e *procura* | a opção *adequada,* | mesmo quando ela | *não está* | entre os imóveis | que já divulga.",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "comprador",
   "text": "O valor dele está na curadoria e no relacionamento.",
   "caption": "O valor dele | está na *curadoria* | e no *relacionamento.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "carteira",
   "text": "O segundo conhece profundamente uma carteira específica.",
   "caption": "O *segundo* | conhece profundamente | uma *carteira* específica.",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "carteira",
   "text": "Sabe explicar a planta, a localização, as restrições e para quem cada imóvel faz sentido.",
   "caption": "Sabe explicar | a *planta,* | a *localização,* | as *restrições* | e para quem | cada imóvel | faz *sentido.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "carteira",
   "text": "Nesse caso, a comunicação começa no produto e encontra o público compatível.",
   "caption": "Nesse caso, | a comunicação | começa no *produto* | e encontra | o *público compatível.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "proprietario",
   "text": "Existe ainda quem concentre seu trabalho na captação: conquistar a confiança do proprietário, avaliar a apresentação do imóvel e construir uma carteira que outros compradores queiram conhecer.",
   "caption": "Existe ainda | quem concentre | seu trabalho | na *captação:* | conquistar a *confiança* | do proprietário, | avaliar a *apresentação* | do imóvel | e *construir* uma carteira | que outros compradores | queiram conhecer.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "proprietario",
   "text": "Não é superior nem inferior.",
   "caption": "Não é *superior* | nem *inferior.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "proprietario",
   "text": "É outra porta de entrada para o negócio.",
   "caption": "É outra | *porta de entrada* | para o negócio.",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "insight",
   "text": "O erro não está em usar mais de um caminho.",
   "caption": "O *erro* | não está em usar | mais de *um caminho.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "insight",
   "text": "Está em não saber qual deles sustenta a sua operação hoje.",
   "caption": "Está em *não saber* | qual deles | *sustenta* | a sua operação hoje.",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "Quando isso fica claro, seus conteúdos, sua rotina e suas prioridades começam a conversar entre si.",
   "caption": "Quando isso | fica *claro,* | seus *conteúdos,* | sua *rotina* | e suas *prioridades* | começam a *conversar* | entre si.",
   "pauseAfter": 0.3
  },
  {
   "id": "s16",
   "scene": "cta",
   "text": "E você: hoje trabalha mais para encontrar compradores, vender sua carteira ou captar bons imóveis?",
   "caption": "E *você:* | hoje trabalha mais | para encontrar *compradores,* | vender sua *carteira* | ou *captar* | bons imóveis?",
   "pauseAfter": 0.3
  },
  {
   "id": "s17",
   "scene": "cta",
   "text": "Conta nos comentários.",
   "caption": "Conta nos *comentários.*",
   "pauseAfter": 0.3
  }
 ],
