 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Eu sei exatamente como seria o comprador mais difícil de Vice City.",
   "start": 0.2,
   "end": 4.93
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Ele começa: “quero uma cobertura de frente para o mar, garagem para seis carros e uma piscina enorme”.",
   "start": 5.24,
   "end": 10.29
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Beleza. Aí vem a segunda mensagem: “mas só se for numa rua tranquila”.",
   "start": 10.6,
   "end": 15.02
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Cinco minutos depois ele fala que precisa ficar no centro, perto de tudo, porém sem movimento.",
   "start": 15.32,
   "end": 20.54
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "E ainda manda: “aceita permuta por carro que eu peguei hoje?”.",
   "start": 20.68,
   "end": 24.01
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "O corretor respira fundo, abre o mapa e percebe que o problema não é encontrar imóvel.",
   "start": 24.2,
   "end": 29.24
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "É entender o pedido de alguém que vive num videogame de mundo aberto.",
   "start": 29.48,
   "end": 33.1
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "No fim, a única opção aprovada é uma casa que nem apareceu no mapa ainda.",
   "start": 33.4,
   "end": 37.8
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Fora do jogo, todo pedido merece ficar anotado.",
   "start": 38.04,
   "end": 40.7
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 41.0,
   "end": 46.02
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 46.2,
   "end": 49.19
  }
 ],
