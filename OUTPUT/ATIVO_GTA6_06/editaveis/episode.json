  "segments": [
    {
      "id": "s1",
      "scene": "hook",
      "text": "O GTA VI tem o pior acordo de aluguel que eu já vi num videogame.",
      "caption": "O *GTA VI* | tem o *pior acordo* | de aluguel | que eu já vi | num videogame.",
      "pauseAfter": 0.3
    },
    {
      "id": "s2",
      "scene": "t1",
      "text": "Um dos protagonistas, Jason, mora sem pagar aluguel num imóvel de Brian Heder.",
      "caption": "Um dos protagonistas, | *Jason,* | mora *sem pagar* | aluguel | num imóvel | de *Brian Heder.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s3",
      "scene": "t1",
      "text": "Até aqui parece maravilhoso.",
      "caption": "Até aqui | parece *maravilhoso.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s4",
      "scene": "t2",
      "text": "Só que Brian não está fazendo caridade: a descrição oficial diz que Jason pode ficar ali desde que o ajude em cobranças locais.",
      "caption": "Só que Brian | não está fazendo | *caridade:* | a descrição oficial | diz que Jason | pode ficar ali | *desde que* | o ajude | em *cobranças* locais.",
      "pauseAfter": 0.3
    },
    {
      "id": "s5",
      "scene": "t2",
      "text": "Brian também opera negócios no litoral de Leonida.",
      "caption": "Brian também opera | *negócios* | no litoral | de *Leonida.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s6",
      "scene": "t3",
      "text": "Ou seja, a casa até pode ser “sem aluguel”, mas vem com uma condição que nenhum corretor sério colocaria num contrato.",
      "caption": "Ou seja, | a casa | até pode ser | “sem aluguel”, | mas vem | com uma *condição* | que nenhum | corretor sério | colocaria | num *contrato.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s7",
      "scene": "t3",
      "text": "Conclusão: quando a oferta de moradia parece boa demais, vale descobrir o que existe nas letras miúdas.",
      "caption": "*Conclusão:* | quando a oferta | de moradia | parece *boa demais,* | vale descobrir | o que existe | nas *letras miúdas.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s8",
      "scene": "t3",
      "text": "Especialmente em Vice City.",
      "caption": "Especialmente | em *Vice City.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s9",
      "scene": "t3",
      "text": "Fora do jogo, contrato bom é contrato claro.",
      "caption": "Fora do jogo, | contrato bom | é contrato *claro.*",
      "pauseAfter": 0.3
    },
    {
      "id": "s10",
      "scene": "cta",
      "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
      "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
      "pauseAfter": 0.3
    },
    {
      "id": "s11",
