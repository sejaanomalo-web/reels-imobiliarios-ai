 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O GTA VI tem o pior acordo de aluguel que eu já vi num videogame.",
   "start": 0.12,
   "end": 4.42
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Um dos protagonistas, Jason, mora sem pagar aluguel num imóvel de Brian Heder.",
   "start": 4.68,
   "end": 9.74
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Até aqui parece maravilhoso.",
   "start": 10.04,
   "end": 11.4
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "Só que Brian não está fazendo caridade: a descrição oficial diz que Jason pode ficar ali desde que o ajude em cobranças locais.",
   "start": 11.64,
   "end": 19.71
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Brian também opera negócios no litoral de Leonida.",
   "start": 19.967,
   "end": 22.64
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Ou seja, a casa até pode ser “sem aluguel”, mas vem com uma condição que nenhum corretor sério colocaria num contrato.",
   "start": 23.16,
   "end": 29.49
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Conclusão: quando a oferta de moradia parece boa demais, vale descobrir o que existe nas letras miúdas.",
   "start": 29.88,
   "end": 35.63
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Especialmente em Vice City.",
   "start": 35.96,
   "end": 37.29
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Fora do jogo, contrato bom é contrato claro.",
   "start": 37.64,
   "end": 40.11
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.36,
   "end": 44.97
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 45.16,
   "end": 47.87
  }
 ],
