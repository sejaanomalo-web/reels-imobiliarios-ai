 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se eu trabalhasse em Vice City, essa seria a primeira casa que eu tentaria captar.",
   "start": 0.2,
   "end": 4.8
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Sem pensar duas vezes.",
   "start": 5.0,
   "end": 6.23
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Não seria a mais cara, nem a maior.",
   "start": 6.52,
   "end": 8.46
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Eu procuraria uma que tivesse três coisas que param qualquer pessoa no anúncio: fachada marcante, localização reconhecível e uma história fácil de contar.",
   "start": 8.6,
   "end": 16.97
  },
  {
   "id": "s5",
   "scene": "t2",
   "text": "Imagina o tour: “você abre a janela e enxerga a cidade inteira, com a praia a poucos minutos”.",
   "start": 17.32,
   "end": 23.36
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Pronto. Eu já consigo enxergar a primeira cena do Reel.",
   "start": 23.64,
   "end": 26.2
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "E tem uma pegadinha: em GTA VI, eu precisaria descobrir se o proprietário é uma pessoa comum ou alguém que vai me receber com uma missão criminosa.",
   "start": 26.6,
   "end": 33.99
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "Por isso a captação terminaria antes do primeiro encontro.",
   "start": 34.2,
   "end": 36.88
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Prioridade: continuar vivo.",
   "start": 37.16,
   "end": 38.77
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Já na vida real, captação pede organização.",
   "start": 39.08,
   "end": 41.52
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 41.8,
   "end": 46.65
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 46.84,
   "end": 49.86
  }
 ],
