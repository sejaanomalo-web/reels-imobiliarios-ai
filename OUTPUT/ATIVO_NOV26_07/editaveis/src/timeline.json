 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Sessenta e sete por cento das compras observadas numa pesquisa tiveram algum desconto.",
   "start": 0.12,
   "end": 4.39
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "E tem corretor que ainda trata negociação como ofensa.",
   "start": 4.52,
   "end": 7.16
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Imagina dois proprietários vendendo apartamentos parecidos.",
   "start": 7.16,
   "end": 9.88
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Um recebe proposta abaixo do anúncio e recusa antes de conversar.",
   "start": 9.88,
   "end": 13.08
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "O outro pede que o corretor apresente dados e explique as condições.",
   "start": 13.08,
   "end": 16.26
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "No levantamento Raio-X FipeZAP, boa parte das transações relatadas terminou abaixo do valor pedido.",
   "start": 16.44,
   "end": 21.71
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Isso não significa que todo imóvel precisa ter desconto igual, nem que o proprietário deva aceitar qualquer oferta.",
   "start": 22.04,
   "end": 27.4
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "O papel do corretor é contextualizar: preço de imóveis comparáveis, tempo de exposição, condição do bem e capacidade real da proposta.",
   "start": 27.4,
   "end": 34.34
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Negociar bem é organizar argumentos, não forçar uma resposta.",
   "start": 34.52,
   "end": 37.72
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Na próxima conversa difícil sobre preço, leve contexto.",
   "start": 37.72,
   "end": 40.33
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 40.52,
   "end": 44.68
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 44.68,
   "end": 46.99
  }
 ],
