 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Sua equipe tem muitos leads.",
   "start": 0.2,
   "end": 1.86
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas você sabe quais receberam retorno?",
   "start": 2.04,
   "end": 4.25
  },
  {
   "id": "s3",
   "scene": "situacao",
   "text": "Na reunião, todo mundo diz que está atendendo.",
   "start": 4.6,
   "end": 6.86
  },
  {
   "id": "s4",
   "scene": "situacao",
   "text": "Só que atividade e avanço comercial não são a mesma coisa.",
   "start": 7.08,
   "end": 9.86
  },
  {
   "id": "s5",
   "scene": "tensao",
   "text": "Para acompanhar o processo, observe três coisas: primeiro contato, último movimento e próximo passo definido.",
   "start": 10.36,
   "end": 17.03
  },
  {
   "id": "s6",
   "scene": "insight",
   "text": "Não é vigiar o corretor a cada minuto.",
   "start": 17.48,
   "end": 19.54
  },
  {
   "id": "s7",
   "scene": "insight",
   "text": "É ter clareza para apoiar oportunidades que ficaram sem sequência e corrigir gargalos reais.",
   "start": 19.88,
   "end": 24.68
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Essa clareza depende de cada lead ter seu histórico registrado.",
   "start": 25.24,
   "end": 28.46
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 28.76,
   "end": 33.1
  },
  {
   "id": "s10",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 33.509,
   "end": 36.22
  }
 ],
