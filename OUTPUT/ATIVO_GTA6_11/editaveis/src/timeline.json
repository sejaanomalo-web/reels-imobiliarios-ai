 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se eu tivesse de escolher o endereço mais estranho de Leonida, eu começaria pelos pântanos.",
   "start": 0.2,
   "end": 6.63
  },
  {
   "id": "s2",
   "scene": "t1",
   "text": "Quando se fala em GTA VI, todo mundo pensa na praia de Vice City e nos prédios enormes.",
   "start": 7.0,
   "end": 12.18
  },
  {
   "id": "s3",
   "scene": "t2",
   "text": "Só que o mapa também tem os Grassrivers, uma região de natureza e áreas alagadas.",
   "start": 12.36,
   "end": 16.83
  },
  {
   "id": "s4",
   "scene": "t2",
   "text": "É o completo oposto da vida noturna, do trânsito e dos outdoors da cidade.",
   "start": 17.08,
   "end": 21.49
  },
  {
   "id": "s5",
   "scene": "t3",
   "text": "Agora imagina vender uma casa por lá. A descrição seria “contato direto com a natureza”, mas eu perguntaria primeiro: direto com qual natureza?",
   "start": 21.96,
   "end": 31.3
  },
  {
   "id": "s6",
   "scene": "t3",
   "text": "Porque uma coisa é ter vista para o verde. Outra é descobrir quem está olhando para você de dentro da água.",
   "start": 31.64,
   "end": 37.49
  },
  {
   "id": "s7",
   "scene": "t3",
   "text": "Na vida real, anúncio bom antecipa as perguntas.",
   "start": 37.88,
   "end": 40.89
  },
  {
   "id": "s8",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 41.16,
   "end": 45.64
  },
  {
   "id": "s9",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 45.989,
   "end": 48.65
  }
 ],
