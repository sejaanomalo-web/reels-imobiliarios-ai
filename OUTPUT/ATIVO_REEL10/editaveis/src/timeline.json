{
 "id": "EP-ATIVO-REEL10",
 "title": "Juro alto ou baixo: onde está a negociação?",
 "fps": 30,
 "duration": 67.03333333333333,
 "durationInFrames": 2011,
 "narrationEnd": 64.801,
 "voice": "Puck",
 "scenes": [
  {
