 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Se eu começasse do zero vendendo imóveis hoje, não tentaria aparecer para a cidade inteira.",
   "start": 0.2,
   "end": 5.07
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Começaria com um problema bem específico.",
   "start": 5.32,
   "end": 7.52
  },
  {
   "id": "s3",
   "scene": "pub",
   "text": "Escolheria um tipo de comprador e um imóvel que realmente combine com ele.",
   "start": 7.96,
   "end": 12.2
  },
  {
   "id": "s4",
   "scene": "pub",
   "text": "Em vez de publicar só fotos bonitas, gravaria um vídeo respondendo às dúvidas mais prováveis daquela pessoa: espaço, localização, circulação e condições confirmadas.",
   "start": 12.6,
   "end": 23.61
  },
  {
   "id": "s5",
   "scene": "passo",
   "text": "Depois, faria a chamada combinar com o vídeo.",
   "start": 24.12,
   "end": 26.7
  },
  {
   "id": "s6",
   "scene": "passo",
   "text": "Quem quer comparar opções recebe um caminho para conversar.",
   "start": 27.0,
   "end": 30.26
  },
  {
   "id": "s7",
   "scene": "passo",
   "text": "Quem quer conhecer recebe as condições para agendar.",
   "start": 30.52,
   "end": 33.31
  },
  {
   "id": "s8",
   "scene": "passo",
   "text": "E todo interessado precisa ter seu pedido registrado com clareza, mesmo quando a resposta não é imediata.",
   "start": 33.72,
   "end": 39.78
  },
  {
   "id": "s9",
   "scene": "cont",
   "text": "A parte mais importante vem depois: marcar quem recebeu informações, quem ficou de responder e quando vale retomar a conversa.",
   "start": 40.28,
   "end": 48.08
  },
  {
   "id": "s10",
   "scene": "cont",
   "text": "Não é o anúncio sozinho que faz o processo funcionar.",
   "start": 48.44,
   "end": 51.29
  },
  {
   "id": "s11",
   "scene": "cont",
   "text": "É o encaixe entre conteúdo, atendimento e acompanhamento.",
   "start": 51.56,
   "end": 55.36
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 55.88,
   "end": 60.38
  },
  {
   "id": "s13",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 60.76,
   "end": 63.84
  }
 ],
