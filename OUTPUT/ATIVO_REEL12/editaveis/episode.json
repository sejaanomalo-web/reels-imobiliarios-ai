 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Duas equipes mostram apartamentos parecidos para quem quer sair do aluguel.",
   "caption": "*Duas equipes* | mostram apartamentos | parecidos | para quem quer | *sair do aluguel.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas só uma deixa o próximo passo claro.",
   "caption": "Mas só uma | deixa o *próximo passo* | *claro.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s3",
   "scene": "exc",
   "text": "Na primeira conversa, o comprador recebe uma avalanche de assuntos: dezenas de imóveis, siglas, documentos, taxas e prazos.",
   "caption": "Na primeira conversa, | o comprador recebe | uma *avalanche* | de assuntos: | *dezenas de imóveis,* | *siglas,* | *documentos,* | *taxas* | e *prazos.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s4",
   "scene": "exc",
   "text": "Tudo é importante em algum momento, mas não tudo de uma vez.",
   "caption": "Tudo é importante | em algum momento, | mas *não tudo* | *de uma vez.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s5",
   "scene": "exc",
   "text": "Ele sai sem saber por onde começar.",
   "caption": "Ele sai | sem saber | por onde *começar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s6",
   "scene": "cla",
   "text": "No outro atendimento, o profissional começa perguntando qual é a maior dúvida.",
   "caption": "No outro atendimento, | o profissional | começa *perguntando* | qual é | a *maior dúvida.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s7",
   "scene": "cla",
   "text": "A pessoa quer saber se pode financiar.",
   "caption": "A pessoa quer saber | se pode *financiar.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s8",
   "scene": "cla",
   "text": "Então eles combinam o primeiro passo: verificar condições com a instituição responsável.",
   "caption": "Então eles combinam | o *primeiro passo:* | *verificar condições* | com a instituição | responsável.",
   "pauseAfter": 0.3
  },
  {
   "id": "s9",
   "scene": "cla",
   "text": "Depois, avaliar opções compatíveis e só então organizar visitas.",
   "caption": "Depois, | avaliar *opções compatíveis* | e só então | organizar *visitas.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s10",
   "scene": "lic",
   "text": "A diferença não está em esconder informação.",
   "caption": "A diferença | não está | em *esconder* informação.",
   "pauseAfter": 0.3
  },
  {
   "id": "s11",
   "scene": "lic",
   "text": "Está em oferecer a informação certa na hora certa.",
   "caption": "Está em oferecer | a informação *certa* | na *hora certa.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s12",
   "scene": "lic",
   "text": "Para quem compra o primeiro imóvel, entender a sequência pode ser tão importante quanto gostar da planta.",
   "caption": "Para quem compra | o *primeiro imóvel,* | entender a *sequência* | pode ser | tão importante | quanto gostar | da *planta.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s13",
   "scene": "fim",
   "text": "E para saber em que etapa cada comprador está, ajuda ter cada atendimento organizado.",
   "caption": "E para saber | em que *etapa* | cada comprador está, | ajuda ter | cada atendimento | *organizado.*",
   "pauseAfter": 0.3
  },
  {
   "id": "s14",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "caption": "Quer conhecer | um sistema *personalizado* | para organizar | seus *imóveis, leads* | e *atendimentos?*",
   "pauseAfter": 0.3
  },
  {
   "id": "s15",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "caption": "Comente *SISTEMA* | que eu te envio | os detalhes | pelo *Direct.*",
   "pauseAfter": 0.3
  }
 ],
