 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "A Black Friday chegou ao mercado imobiliário.",
   "start": 0.2,
   "end": 2.89
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas uma etiqueta de cinquenta por cento de desconto não responde a pergunta mais importante.",
   "start": 3.24,
   "end": 8.04
  },
  {
   "id": "s3",
   "scene": "t1",
   "text": "Desconto em relação a qual preço?",
   "start": 8.44,
   "end": 10.45
  },
  {
   "id": "s4",
   "scene": "t1",
   "text": "Em novembro, incorporadoras fizeram campanhas com condições especiais.",
   "start": 10.76,
   "end": 14.42
  },
  {
   "id": "s5",
   "scene": "t1",
   "text": "O corretor precisa separar preço original, preço promocional e condições para ter acesso à oferta.",
   "start": 14.68,
   "end": 20.57
  },
  {
   "id": "s6",
   "scene": "t2",
   "text": "Também não adianta comparar só a parcela da chamada.",
   "start": 20.92,
   "end": 23.69
  },
  {
   "id": "s7",
   "scene": "t2",
   "text": "Entrada, evolução da obra, correção monetária, taxas e cronograma podem mudar o custo total de acordo com o contrato.",
   "start": 24.2,
   "end": 31.38
  },
  {
   "id": "s8",
   "scene": "t3",
   "text": "O vídeo que ajuda o comprador é aquele que ensina a conferir proposta e documentos, não o que repete a maior porcentagem do banner.",
   "start": 31.8,
   "end": 38.94
  },
  {
   "id": "s9",
   "scene": "t3",
   "text": "Promoção boa precisa resistir à comparação.",
   "start": 39.32,
   "end": 41.91
  },
  {
   "id": "s10",
   "scene": "t3",
   "text": "Compare propostas completas.",
   "start": 42.28,
   "end": 44.07
  },
  {
   "id": "s11",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 44.36,
   "end": 49.06
  },
  {
   "id": "s12",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 49.32,
   "end": 52.38
  }
 ],
