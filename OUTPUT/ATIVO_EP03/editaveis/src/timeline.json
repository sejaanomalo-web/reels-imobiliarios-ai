 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "O corretor não precisa acordar todos os dias se sentindo invencível.",
   "start": 0.12,
   "end": 4.1
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Mas o cliente que marcou uma visita com ele precisa encontrar alguém preparado.",
   "start": 4.28,
   "end": 7.67
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "São duas coisas muito diferentes.",
   "start": 7.96,
   "end": 9.74
  },
  {
   "id": "s4",
   "scene": "pressao",
   "text": "Tem dia em que a negociação não avança.",
   "start": 10.2,
   "end": 12.6
  },
  {
   "id": "s5",
   "scene": "pressao",
   "text": "Tem semana com visitas que não viram proposta.",
   "start": 12.6,
   "end": 14.95
  },
  {
   "id": "s6",
   "scene": "pressao",
   "text": "E tem mensagem chegando enquanto você tenta resolver documentação e agenda.",
   "start": 15.16,
   "end": 18.82
  },
  {
   "id": "s7",
   "scene": "pressao",
   "text": "Fingir que tudo isso não pesa só cria mais uma cobrança.",
   "start": 19.24,
   "end": 22.44
  },
  {
   "id": "s8",
   "scene": "percepcao",
   "text": "Só que atender bem não significa falar alto, sorrir o tempo todo ou repetir que a venda vai acontecer.",
   "start": 22.92,
   "end": 28.71
  },
  {
   "id": "s9",
   "scene": "percepcao",
   "text": "Significa chegar sabendo o que a pessoa procura, quais são os limites daquela negociação e o que você precisa explicar com honestidade.",
   "start": 29.24,
   "end": 36.62
  },
  {
   "id": "s10",
   "scene": "metodo",
   "text": "Antes do atendimento, faça três verificações.",
   "start": 37.08,
   "end": 39.81
  },
  {
   "id": "s11",
   "scene": "metodo",
   "text": "Releia o histórico do comprador.",
   "start": 40.04,
   "end": 41.74
  },
  {
   "id": "s12",
   "scene": "metodo",
   "text": "Confira os pontos importantes do imóvel.",
   "start": 42.12,
   "end": 44.07
  },
  {
   "id": "s13",
   "scene": "metodo",
   "text": "E defina uma boa pergunta para aquela conversa avançar.",
   "start": 44.28,
   "end": 47.18
  },
  {
   "id": "s14",
   "scene": "metodo",
   "text": "Se a negociação não seguir, registre o aprendizado e encerre o dia sem inventar uma vitória.",
   "start": 47.64,
   "end": 53.14
  },
  {
   "id": "s15",
   "scene": "insight",
   "text": "A confiança que o corretor transmite vem menos da energia que ele demonstra e mais da segurança com que conduz cada etapa.",
   "start": 53.56,
   "end": 60.51
  },
  {
   "id": "s16",
   "scene": "insight",
   "text": "A rotina pode ser difícil.",
   "start": 60.84,
   "end": 62.35
  },
  {
   "id": "s17",
   "scene": "insight",
   "text": "O atendimento não precisa ser improvisado.",
   "start": 62.68,
   "end": 64.86
  },
  {
   "id": "s18",
   "scene": "cta",
   "text": "Compartilhe este vídeo com um corretor que trabalha sério mesmo nos dias difíceis.",
   "start": 65.24,
   "end": 69.72
  }
 ],
