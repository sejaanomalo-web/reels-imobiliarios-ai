 "segments": [
  {
   "id": "s1",
   "scene": "hook",
   "text": "Mesma família, mesmo desejo de comprar apartamento.",
   "start": 0.2,
   "end": 3.3
  },
  {
   "id": "s2",
   "scene": "hook",
   "text": "Dois atendimentos diferentes.",
   "start": 3.48,
   "end": 5.0
  },
  {
   "id": "s3",
   "scene": "hook",
   "text": "Um começa pelas fotos.",
   "start": 5.16,
   "end": 6.29
  },
  {
   "id": "s4",
   "scene": "hook",
   "text": "O outro começa pelas perguntas.",
   "start": 6.52,
   "end": 8.16
  },
  {
   "id": "s5",
   "scene": "curto",
   "text": "Imagina a primeira situação.",
   "start": 8.44,
   "end": 9.73
  },
  {
   "id": "s6",
   "scene": "curto",
   "text": "A pessoa pede um apartamento e recebe logo dez opções parecidas, com valores, plantas e links.",
   "start": 10.04,
   "end": 15.33
  },
  {
   "id": "s7",
   "scene": "curto",
   "text": "Ela até agradece, mas continua sem saber o que realmente cabe na rotina e no orçamento.",
   "start": 15.64,
   "end": 19.77
  },
  {
   "id": "s8",
   "scene": "curto",
   "text": "A conversa esfria.",
   "start": 20.12,
   "end": 21.15
  },
  {
   "id": "s9",
   "scene": "outro",
   "text": "No segundo atendimento, vêm três perguntas antes da lista: qual é o objetivo da mudança?",
   "start": 21.64,
   "end": 26.32
  },
  {
   "id": "s10",
   "scene": "outro",
   "text": "O que é indispensável?",
   "start": 26.6,
   "end": 27.8
  },
  {
   "id": "s11",
   "scene": "outro",
   "text": "E o orçamento já foi validado com quem pode orientar sobre crédito, quando necessário?",
   "start": 27.96,
   "end": 32.29
  },
  {
   "id": "s12",
   "scene": "outro",
   "text": "A partir daí, as opções começam a fazer sentido.",
   "start": 32.76,
   "end": 35.56
  },
  {
   "id": "s13",
   "scene": "aprend",
   "text": "Percebe a diferença?",
   "start": 36.04,
   "end": 37.03
  },
  {
   "id": "s14",
   "scene": "aprend",
   "text": "Não é mostrar menos por preguiça.",
   "start": 37.4,
   "end": 39.21
  },
  {
   "id": "s15",
   "scene": "aprend",
   "text": "É mostrar o que conversa com a realidade da pessoa.",
   "start": 39.56,
   "end": 42.23
  },
  {
   "id": "s16",
   "scene": "aprend",
   "text": "Qualificação não é interrogatório.",
   "start": 42.68,
   "end": 44.62
  },
  {
   "id": "s17",
   "scene": "aprend",
   "text": "É evitar que comprador e profissional percam tempo com possibilidades incompatíveis.",
   "start": 44.92,
   "end": 49.21
  },
  {
   "id": "s18",
   "scene": "aplic",
   "text": "Antes de mandar a próxima lista, testa essas três perguntas.",
   "start": 49.8,
   "end": 53.28
  },
  {
   "id": "s19",
   "scene": "aplic",
   "text": "E deixa as respostas de cada comprador registradas para a próxima conversa.",
   "start": 53.56,
   "end": 57.34
  },
  {
   "id": "s20",
   "scene": "cta",
   "text": "Quer conhecer um sistema personalizado para organizar seus imóveis, leads e atendimentos?",
   "start": 58.12,
   "end": 63.1
  },
  {
   "id": "s21",
   "scene": "cta",
   "text": "Comente SISTEMA que eu te envio os detalhes pelo Direct.",
   "start": 63.459,
   "end": 66.2
  }
 ],
